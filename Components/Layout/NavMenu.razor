@inject NavigationManager NavigationManager

@*
    This component is part of the layout, which renders STATICALLY on the server (Routes/App have no render mode), so
    it cannot use @onclick. Groups are native <details>/<summary>; remembering open groups and the icon-only sidebar are
    handled by the small vanilla-JS block in MainLayout.razor. A new page needs an entry here AND in
    MainLayout.GetPageTitle.
*@

<nav class="sidebar-nav" aria-label="Main navigation">
    <AuthorizeView Roles="SuperAdmin" Context="superAdminContext">
        <Authorized>
            @foreach (var node in SuperAdminMenu) { @RenderNode(node) }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin" Context="adminContext">
        <Authorized>
            @foreach (var node in AdminMenu) { @RenderNode(node) }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Teacher" Context="teacherContext">
        <Authorized>
            @foreach (var node in TeacherMenu) { @RenderNode(node) }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Learner" Context="learnerContext">
        <Authorized>
            @foreach (var node in LearnerMenu) { @RenderNode(node) }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Parent" Context="parentContext">
        <Authorized>
            @foreach (var node in ParentMenu) { @RenderNode(node) }
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    // A leaf has an Href; a group has an Id and Children. `Also` lists extra paths that should highlight the item:
    // an entry ending in "/" is a prefix match, anything else is an exact path.
    private sealed record NavNode(string Label, string Icon, string? Href = null, string[]? Also = null,
        string? Id = null, NavNode[]? Children = null);

    private static NavNode Link(string label, string icon, string href, params string[] also) =>
        new(label, icon, Href: href, Also: also);

    private static NavNode Group(string id, string label, string icon, params NavNode[] children) =>
        new(label, icon, Id: id, Children: children);

    private static readonly NavNode[] SuperAdminMenu =
    {
        Link("Dashboard", "fa-chart-line", "/superadmin/dashboard"),
        Link("Schools", "fa-building", "/superadmin/schools"),
        Link("Staff Registry", "fa-users", "/superadmin/admins"),
    };

    private static readonly NavNode[] AdminMenu =
    {
        Link("Dashboard", "fa-chart-line", "/admin/dashboard"),
        // Admins reach the risk report and (to drill into a subject) the shared at-risk page from here.
        Link("Risk Overview", "fa-chart-pie", "/admin/risk-overview", "/admin/risk-report", "/teacher/atrisk"),
        Link("Attendance", "fa-calendar-check", "/admin/attendance"),
        Group("people", "People", "fa-users",
            Link("User Management", "fa-users", "/admin/users"),
            Link("Create User", "fa-user-plus", "/admin/users/create"),
            Link("Learner Profiles", "fa-id-card", "/teacher/learnerprofiles")),
        Group("classes", "Classes & Learners", "fa-user-graduate",
            Link("Class Management", "fa-chalkboard", "/admin/classes"),
            Link("Learner Enrollment", "fa-user-graduate", "/admin/enrollment"),
            Link("Bulk Allocation", "fa-layer-group", "/admin/bulk-enrollment")),
        Group("curriculum", "Curriculum", "fa-book",
            Link("Subject Structure", "fa-sitemap", "/admin/subjects"),
            Link("Resource Desk", "fa-folder-open", "/admin/resources")),
        Group("communication", "Communication", "fa-envelope",
            Link("Parent Communication", "fa-envelope", "/admin/messages"),
            Link("Email Log", "fa-list-check", "/admin/email-log")),
        Group("yearend", "Year-End", "fa-forward",
            Link("Year Rollover", "fa-forward", "/admin/year-rollover"),
            Link("Previous Years", "fa-box-archive", "/admin/previous-years")),
    };

    private static readonly NavNode[] TeacherMenu =
    {
        Link("Dashboard", "fa-chart-line", "/teacher/dashboard"),
        Group("teaching", "Teaching", "fa-chalkboard-user",
            Link("Mark Entry", "fa-pen-ruler", "/teacher/marks"),
            Link("Attendance", "fa-calendar-check", "/teacher/attendance"),
            Link("Resources", "fa-folder-open", "/teacher/resources")),
        Group("learners", "Learners", "fa-user-graduate",
            Link("Risk & Interventions", "fa-exclamation-triangle", "/teacher/atrisk"),
            Link("Learner Profiles", "fa-id-card", "/teacher/learnerprofiles")),
        Link("Message Parents", "fa-envelope", "/teacher/messages"),
    };

    private static readonly NavNode[] LearnerMenu =
    {
        Link("Dashboard", "fa-chart-line", "/learner/dashboard"),
        Link("Marks", "fa-chart-pie", "/learner/marks"),
        Link("Attendance", "fa-calendar-check", "/learner/attendance"),
        Link("Resources", "fa-folder-open", "/learner/resources"),
    };

    private static readonly NavNode[] ParentMenu =
    {
        // Every per-child page (/parent/marks/{id}, attendance, overview, resources) belongs to the dashboard.
        Link("Dashboard", "fa-chart-line", "/parent/dashboard", "/parent/"),
    };

    // Computed per render; the layout is re-rendered by the server on every navigation, so this is always current.
    private string CurrentPath =>
        "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsActive(NavNode node)
    {
        if (node.Href is null) return false;
        var path = CurrentPath;
        if (path.Equals(node.Href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)) return true;
        return node.Also?.Any(a => a.EndsWith('/')
            ? path.StartsWith(a, StringComparison.OrdinalIgnoreCase)
            : path.Equals(a.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)) == true;
    }

    private RenderFragment RenderNode(NavNode node) => node.Children is null ? RenderLink(node, false) : RenderGroup(node);

    private RenderFragment RenderLink(NavNode node, bool nested) =>
        @<a class="@("nav-item" + (nested ? " nav-sub" : "") + (IsActive(node) ? " active" : ""))"
            href="@node.Href" title="@node.Label" aria-current="@(IsActive(node) ? "page" : null)">
            <i class="fas @node.Icon"></i> <span>@node.Label</span>
        </a>;

    // The group holding the current page is rendered open (and marked) so you always see where you are.
    private RenderFragment RenderGroup(NavNode group)
    {
        var hasActive = group.Children!.Any(IsActive);
        return @<details class="nav-group" data-nav-group="@group.Id" open="@hasActive">
            <summary class="@("nav-item nav-group-header" + (hasActive ? " has-active" : ""))" title="@group.Label">
                <i class="fas @group.Icon"></i> <span>@group.Label</span>
                <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
            </summary>
            <div class="nav-group-items">
                @foreach (var child in group.Children!)
                {
                    @RenderLink(child, true)
                }
            </div>
        </details>;
    }
}
