@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset | ARIS</PageTitle>

<div class="aris-login login-wrap">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo"><i class="fas fa-graduation-cap"></i></div>
            <div class="login-brand-text">
                <h2>ARIS</h2>
                <p>Academic Risk Intelligence System</p>
            </div>
        </div>

        <div class="login-heading">Your password has been set</div>
        <div class="login-info" role="alert">You can now sign in with your new password.</div>

        <a class="login-btn" href="Account/Login" style="display:block;text-align:center;text-decoration:none">
            <i class="fas fa-sign-in-alt"></i>&nbsp; Go to sign in
        </a>
    </div>
</div>
