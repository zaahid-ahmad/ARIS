@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email | ARIS</PageTitle>

<div class="aris-login login-wrap">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo"><i class="fas fa-graduation-cap"></i></div>
            <div class="login-brand-text">
                <h2>ARIS</h2>
                <p>Academic Risk Intelligence System</p>
            </div>
        </div>

        <div class="login-heading">Check your email</div>
        <div class="login-info" role="alert">
            If an active ARIS account exists for that address, we've sent a link to reset your password.
            It can take a few minutes to arrive, so check your spam folder too.
        </div>

        <div class="login-link"><a href="Account/Login">Back to sign in</a></div>
    </div>
</div>
