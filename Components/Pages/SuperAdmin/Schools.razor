@page "/superadmin/schools"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using ARIS1.Models
@using ARIS1.Data
@using Microsoft.AspNetCore.Identity
@using ARIS1.Services
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ARIS1.Services.Email.AccountEmailService AccountEmailService


<button class="btn btn-primary mb-3" @onclick="ShowAddSchoolModal">+ Add School</button>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (schools == null)
{
    <p>Loading...</p>
}
else if (schools.Count == 0)
{
    <p class="text-muted">No schools yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var school in PagedSchools)
            {
                <tr>
                    <td>@school.Name</td>
                    <td>@school.Code</td>
                    <td>@school.Email</td>
                    <td>@school.Phone</td>
                    <td>
                        <span class="badge @(school.IsActive ? "bg-success" : "bg-secondary")">
                            @(school.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-info btn-sm" @onclick="() => EditSchool(school)">Edit</button>
                        @if (school.IsActive)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => ShowDeactivateSchoolConfirm(school)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => ReactivateSchool(school)">Reactivate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
}

<!-- ADD/EDIT SCHOOL MODAL -->
@if (showSchoolModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditMode ? "Edit School" : wizardStep == 1 ? "Add School" : $"Assign Admin to {newSchool.Name}")
                        @if (!isEditMode)
                        {
                            <small class="text-muted ms-2">Step @wizardStep of 2</small>
                        }
                    </h5>
                    <button type="button" class="btn-close" disabled="@isSaving" @onclick="() => showSchoolModal = false"></button>
                </div>
                @if (!isEditMode && wizardStep == 2)
                {
                <div class="modal-body">
                    <p class="text-muted">Every school needs an admin. The school and its admin are created together. If either one fails, neither is saved.</p>
                    <div class="mb-3">
                        <label class="form-label">Admin Full Name <span class="text-danger">*</span></label>
                        <input class="form-control @(fullnameError != null ? "is-invalid" : "")"
                               @bind="newAdminFullname" @oninput="@(() => fullnameError = null)"
                               maxlength="100" placeholder="e.g. John Doe" />
                        @if (fullnameError != null)
                        {
                            <div class="invalid-feedback">@fullnameError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin Email <span class="text-danger">*</span></label>
                        <input class="form-control @(adminEmailError != null ? "is-invalid" : "")"
                               type="email" @bind="newAdminEmail" @oninput="@(() => adminEmailError = null)"
                               maxlength="256" placeholder="e.g. john@school.com" />
                        @if (adminEmailError != null)
                        {
                            <div class="invalid-feedback">@adminEmailError</div>
                        }
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="sendSchoolAdminWelcome" @bind="sendWelcomeEmail" />
                        <label class="form-check-label" for="sendSchoolAdminWelcome">Send a welcome email with a link to set their own password</label>
                    </div>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@modalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" disabled="@isSaving" @onclick="() => wizardStep = 1">Back</button>
                    <button class="btn btn-primary" disabled="@isSaving" @onclick="CreateSchoolWithAdmin">
                        @(isSaving ? "Creating..." : "Create School & Admin")
                    </button>
                </div>
                }
                else
                {
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">School Name <span class="text-danger">*</span></label>
                        <input class="form-control @(nameError != null ? "is-invalid" : "")"
                               @bind="newSchool.Name" @oninput="@(() => nameError = null)"
                               maxlength="200" placeholder="e.g. Central High School" />
                        @if (nameError != null)
                        {
                            <div class="invalid-feedback">@nameError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">School Code <span class="text-danger">*</span></label>
                        <input class="form-control @(codeError != null ? "is-invalid" : "")"
                               @bind="newSchool.Code" @bind:after="ValidateCodeUniqueness"
                               maxlength="20" placeholder="e.g. CHS001" />
                        @if (codeError != null)
                        {
                            <div class="invalid-feedback">@codeError</div>
                        }
                        <small class="text-muted">3–20 characters, letters, digits, and hyphens only.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control @(emailError != null ? "is-invalid" : "")"
                               type="email" @bind="newSchool.Email" @oninput="@(() => emailError = null)"
                               maxlength="256" placeholder="e.g. info@school.com" />
                        @if (emailError != null)
                        {
                            <div class="invalid-feedback">@emailError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input class="form-control @(phoneError != null ? "is-invalid" : "")"
                               @bind="newSchool.Phone" @oninput="@(() => phoneError = null)"
                               maxlength="20" placeholder="e.g. 011 000 0000" />
                        @if (phoneError != null)
                        {
                            <div class="invalid-feedback">@phoneError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea class="form-control" @bind="newSchool.Address" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showSchoolModal = false">Cancel</button>
                    @if (isEditMode)
                    {
                        <button class="btn btn-primary" @onclick="SaveSchool">Save</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="GoToAdminStep">Next: Assign Admin</button>
                    }
                </div>
                }
            </div>
        </div>
    </div>
}

<!-- DEACTIVATE CONFIRMATION MODAL -->
@if (schoolToDeactivate != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Deactivate</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to deactivate <strong>@schoolToDeactivate.Name</strong>?</p>
                    <p class="text-warning">
                        <strong>Note:</strong> Deactivating will:
                        <ul>
                            <li>Lock out all users in this school</li>
                            <li>Prevent access to subjects and data</li>
                            <li>Keep all data intact for reactivation</li>
                        </ul>
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => schoolToDeactivate = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeactivateSchool">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<School>? schools;
    private School? schoolToDeactivate;
    private School newSchool = new();
    private bool showSchoolModal = false;
    private bool isEditMode = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string? nameError;
    private string? codeError;
    private string? emailError;
    private string? phoneError;

    // Add School is a two-step wizard (school details → first admin); nothing is written until step 2's
    // "Create School & Admin", which saves both in one transaction so a school can never exist without an admin.
    private int wizardStep = 1;
    private bool isSaving;
    private string newAdminFullname = string.Empty;
    private string newAdminEmail = string.Empty;
    private bool sendWelcomeEmail = true;
    private string? fullnameError;
    private string? adminEmailError;
    private string? modalError;

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling((schools?.Count ?? 0) / (double)PageSize);
    private List<School> PagedSchools => (schools ?? new()).Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private void GoToPage(int page) => currentPage = page;

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        schools = await DbContext.Schools
            .AsNoTracking()
            .OrderBy(s => s.Name)
            .ToListAsync();
        currentPage = 1;
    }

    private void ShowAddSchoolModal()
    {
        newSchool = new School();
        isEditMode = false;
        wizardStep = 1;
        newAdminFullname = string.Empty;
        newAdminEmail = string.Empty;
        sendWelcomeEmail = true;
        showSchoolModal = true;
        nameError = codeError = emailError = phoneError = null;
        fullnameError = adminEmailError = modalError = null;
    }

    private void EditSchool(School school)
    {
        newSchool = new School
        {
            SchoolId = school.SchoolId,
            Name = school.Name,
            Code = school.Code,
            Email = school.Email,
            Phone = school.Phone,
            Address = school.Address,
            IsActive = school.IsActive
        };
        isEditMode = true;
        showSchoolModal = true;
        nameError = codeError = emailError = phoneError = null;
    }

    private async Task ValidateCodeUniqueness()
    {
        codeError = null;
        if (string.IsNullOrWhiteSpace(newSchool.Code)) return;

        if (newSchool.Code.Trim().Length < 3)
        { codeError = "Code must be at least 3 characters."; return; }

        if (!System.Text.RegularExpressions.Regex.IsMatch(newSchool.Code, @"^[A-Za-z0-9\-]+$"))
        { codeError = "Code may only contain letters, digits, and hyphens."; return; }

        var exists = await DbContext.Schools
            .AsNoTracking()
            .AnyAsync(s => s.Code.ToUpper() == newSchool.Code.ToUpper() &&
                          s.SchoolId != newSchool.SchoolId);

        if (exists)
            codeError = "This school code is already in use.";
    }

    private bool ValidateSchoolForm()
    {
        nameError = emailError = phoneError = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(newSchool.Name))
        { nameError = "School name is required."; valid = false; }
        else if (newSchool.Name.Trim().Length < 2)
        { nameError = "Name must be at least 2 characters."; valid = false; }

        if (!string.IsNullOrWhiteSpace(newSchool.Email) &&
            !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(newSchool.Email))
        { emailError = "Enter a valid email address."; valid = false; }

        if (!string.IsNullOrWhiteSpace(newSchool.Phone) && newSchool.Phone.Trim().Length > 20)
        { phoneError = "Phone number must be 20 characters or fewer."; valid = false; }

        return valid;
    }

    private async Task<bool> ValidateSchoolStep()
    {
        if (!ValidateSchoolForm()) return false;

        if (string.IsNullOrWhiteSpace(newSchool.Code))
        { codeError = "School code is required."; return false; }

        await ValidateCodeUniqueness();
        return codeError == null;
    }

    private bool ValidateAdminForm()
    {
        fullnameError = adminEmailError = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(newAdminFullname))
        { fullnameError = "Full name is required."; valid = false; }
        else if (newAdminFullname.Trim().Length < 2)
        { fullnameError = "Full name must be at least 2 characters."; valid = false; }

        if (string.IsNullOrWhiteSpace(newAdminEmail))
        { adminEmailError = "Email is required."; valid = false; }
        else if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(newAdminEmail))
        { adminEmailError = "Enter a valid email address."; valid = false; }

        return valid;
    }

    private async Task GoToAdminStep()
    {
        modalError = null;
        if (!await ValidateSchoolStep()) return;
        wizardStep = 2;
    }

    private async Task CreateSchoolWithAdmin()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = successMessage = string.Empty;
        modalError = null;

        try
        {
            // Re-validate the school step too: the code could have been taken since step 1.
            if (!await ValidateSchoolStep()) { wizardStep = 1; return; }
            if (!ValidateAdminForm()) return;

            var adminEmail = newAdminEmail.Trim();
            if (await UserManager.FindByEmailAsync(adminEmail) != null)
            { adminEmailError = "This email is already in use."; return; }

            var tempPass = PasswordGenerator.Generate();
            User? newAdmin = null;

            // UserManager's store shares this circuit's scoped AppDbContext, so both writes are in this transaction.
            await using (var transaction = await DbContext.Database.BeginTransactionAsync())
            {
                var school = new School
                {
                    Name = newSchool.Name.Trim(),
                    Code = newSchool.Code.Trim(),
                    Email = newSchool.Email,
                    Phone = newSchool.Phone,
                    Address = newSchool.Address,
                    IsActive = true,
                    CreatedDate = DateTime.UtcNow,
                    LastModifiedDate = DateTime.UtcNow
                };
                DbContext.Schools.Add(school);
                await DbContext.SaveChangesAsync();

                newAdmin = new User
                {
                    UserName = adminEmail,
                    Email = adminEmail,
                    Fullname = newAdminFullname.Trim(),
                    SchoolId = school.SchoolId,
                    IsActive = true,
                    EmailConfirmed = false // verified later via emailed link or "Mark verified"; sign-in not blocked
                };

                var result = await UserManager.CreateAsync(newAdmin, tempPass);
                if (result.Succeeded)
                    result = await UserManager.AddToRoleAsync(newAdmin, "Admin");

                if (!result.Succeeded)
                {
                    await transaction.RollbackAsync();
                    DbContext.ChangeTracker.Clear();
                    modalError = "Nothing was saved: " + string.Join(", ", result.Errors.Select(e => e.Description));
                    return;
                }

                await transaction.CommitAsync();
            }

            successMessage = $"School \"{newSchool.Name.Trim()}\" created with admin {adminEmail}. Temporary password: {tempPass}";

            // Queued only after commit, so the email background service never sees a row for a rolled-back user.
            if (sendWelcomeEmail)
            {
                try
                {
                    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                    var sender = await UserManager.GetUserAsync(authState.User);
                    await AccountEmailService.SendWelcomeAsync(newAdmin, "Admin", Navigation.BaseUri, sender?.Id);
                    successMessage += " A welcome email has been queued.";
                }
                catch (Exception emailEx)
                {
                    successMessage += $" (Welcome email could not be queued: {emailEx.Message})";
                }
            }

            showSchoolModal = false;
            await LoadSchools();
        }
        catch (Exception ex)
        {
            DbContext.ChangeTracker.Clear();
            modalError = $"Nothing was saved: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveSchool()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (!isEditMode) return; // new schools go through CreateSchoolWithAdmin

        if (!await ValidateSchoolStep()) return;

        try
        {
            var existing = await DbContext.Schools.FindAsync(newSchool.SchoolId);
            if (existing != null)
            {
                existing.Name = newSchool.Name;
                existing.Code = newSchool.Code;
                existing.Email = newSchool.Email;
                existing.Phone = newSchool.Phone;
                existing.Address = newSchool.Address;
                existing.LastModifiedDate = DateTime.UtcNow;

                DbContext.Schools.Update(existing);
                successMessage = "School updated!";
            }

            await DbContext.SaveChangesAsync();
            showSchoolModal = false;
            await LoadSchools();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void ShowDeactivateSchoolConfirm(School school)
    {
        schoolToDeactivate = school;
    }

    private async Task ConfirmDeactivateSchool()
    {
        if (schoolToDeactivate == null) return;

        try
        {
            var school = await DbContext.Schools.FindAsync(schoolToDeactivate.SchoolId);
            if (school != null)
            {
                school.IsActive = false;
                school.LastModifiedDate = DateTime.UtcNow;
                DbContext.Schools.Update(school);
                await DbContext.SaveChangesAsync();
                successMessage = $"{school.Name} has been deactivated.";
                schoolToDeactivate = null;
                await LoadSchools();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task ReactivateSchool(School school)
    {
        try
        {
            var schoolToReactivate = await DbContext.Schools.FindAsync(school.SchoolId);
            if (schoolToReactivate != null)
            {
                schoolToReactivate.IsActive = true;
                schoolToReactivate.LastModifiedDate = DateTime.UtcNow;
                DbContext.Schools.Update(schoolToReactivate);
                await DbContext.SaveChangesAsync();
                successMessage = $"{schoolToReactivate.Name} has been reactivated.";
                await LoadSchools();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
