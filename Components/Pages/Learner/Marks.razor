@page "/learner/marks"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Learner")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject WeightCalculationService WeightCalculationService


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (subjects == null)
{
    <p>Loading...</p>
}
else if (subjects.Count == 0)
{
    <p class="text-muted">You are not enrolled in any subjects yet.</p>
}
else
{
    @foreach (var subject in PagedSubjects)
    {
        var subjectMarks = subjectMarksCache.ContainsKey(subject.SubjectId)
            ? subjectMarksCache[subject.SubjectId]
            : new List<LearnerMark>();

        <div class="card mb-3">
            <div class="card-header">
                <h5>@subject.Name (Grade @subject.Grade)</h5>
            </div>
            <div class="card-body">
                @if (subjectMarks.Count == 0)
                {
                    <p class="text-muted">No marks yet.</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Assessment</th>
                                <th>Mark</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mark in subjectMarks)
                            {
                                var percentage = (mark.MarksAwarded / mark.Assessment.MaxMark) * 100;
                                <tr>
                                    <td>@mark.Assessment.Title</td>
                                    <td>@mark.MarksAwarded.ToString("0.##") / @mark.Assessment.MaxMark.ToString("0.##")</td>
                                    <td>@percentage.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    var summary = subjectMarkSummaryCache.GetValueOrDefault(subject.SubjectId);
                    @if (summary != null && (summary.TermMarks.Count > 0 || summary.YearMark != null))
                    {
                        <p>
                            @foreach (var (term, pct) in summary.TermMarks)
                            {
                                <span class="badge bg-secondary me-1">Term @term: @pct.ToString("F1")%</span>
                            }
                            @if (summary.YearMark != null)
                            {
                                <span class="badge bg-primary">Year Mark: @summary.YearMark.YearPercentage.ToString("F1")%</span>
                            }
                        </p>
                    }
                }
            </div>
        </div>
    }
    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
}

@code {
    private Learner? currentLearner;
    private List<Subject>? subjects;
    private Dictionary<int, List<LearnerMark>> subjectMarksCache = new();
    private Dictionary<int, SubjectMarkSummary> subjectMarkSummaryCache = new();
    private string errorMessage = string.Empty;

    // Weighted Term Marks + Year Mark for one subject, via WeightCalculationService — replaces
    // the old flat/unweighted average, which ignored assessment-type weighting and term boundaries.
    private class SubjectMarkSummary
    {
        public List<(int Term, decimal Percentage)> TermMarks { get; set; } = new();
        public YearMarkResult? YearMark { get; set; }
    }

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling((subjects?.Count ?? 0) / (double)PageSize);
    private List<Subject> PagedSubjects => (subjects ?? new()).Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private void GoToPage(int page) => currentPage = page;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentLearner = await DbContext.Learners
                .AsNoTracking()
                .Include(l => l.User)
                .FirstOrDefaultAsync(l => l.UserId == user!.Id);

            if (currentLearner == null)
            {
                errorMessage = "You are not registered as a learner.";
                return;
            }

            subjects = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.LearnerId == currentLearner.LearnerId)
                .Include(ls => ls.Subject)
                .Select(ls => ls.Subject)
                .ToListAsync();

            // Pre-load all marks into cache
            var allMarks = await DbContext.LearnerMarks
                .AsNoTracking()
                .Where(m => m.LearnerId == currentLearner.LearnerId && !m.IsAbsent)  // ← Filter by learner
                .Include(m => m.Assessment)
                .ToListAsync();

            var summaryCache = new Dictionary<int, SubjectMarkSummary>();
            foreach (var subject in subjects)
            {
                subjectMarksCache[subject.SubjectId] = allMarks
                    .Where(m => m.Assessment.SubjectId == subject.SubjectId)
                    .ToList();

                var summary = new SubjectMarkSummary();
                foreach (var term in new[] { 1, 2, 3, 4 })
                {
                    var termResult = await WeightCalculationService.CalculateWeightedTermMark(currentLearner.LearnerId, subject.SubjectId, term);
                    if (termResult.IsSuccessful)
                        summary.TermMarks.Add((term, termResult.WeightedPercentage));
                }

                var yearResult = await WeightCalculationService.CalculateYearMark(currentLearner.LearnerId, subject.SubjectId);
                if (yearResult.IsSuccessful)
                    summary.YearMark = yearResult;

                summaryCache[subject.SubjectId] = summary;
            }
            subjectMarkSummaryCache = summaryCache;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading marks: {ex.Message}";
        }
    }
}