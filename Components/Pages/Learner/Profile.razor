@page "/learner/profile"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Learner")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<h2>My Profile</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <h4>Personal Information</h4>
        <p><strong>Name:</strong> @currentLearner?.User?.Fullname</p>
        <p><strong>Grade:</strong> @currentLearner?.Grade</p>
        <p><strong>Class:</strong> @currentLearner?.ClassName</p>
    </div>
</div>
<hr />

<h4>My Subjects</h4>
@if (subjects.Count == 0)
{
    <p class="text-muted">No subjects enrolled yet.</p>
}
else
{
    @foreach (var subject in subjects)
    {
        var subjectMarks = subjectMarksCache.ContainsKey(subject.SubjectId)
            ? subjectMarksCache[subject.SubjectId]
            : new List<LearnerMark>();

        var subjectAttendance = attendanceCache.ContainsKey(subject.SubjectId)
            ? attendanceCache[subject.SubjectId]
            : new List<AttendanceRecord>();

        <div class="card mb-3">
            <div class="card-header">
                <h5>@subject.Name (Grade @subject.Grade)</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Marks</h6>
                        @if (subjectMarks.Count == 0)
                        {
                            <p class="text-muted">No marks yet.</p>
                        }
                        else
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Assessment</th>
                                        <th>Mark</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mark in subjectMarks)
                                    {
                                        var percentage = (mark.MarksAwarded / mark.Assessment.MaxMark) * 100;
                                        <tr>
                                            <td>@mark.Assessment.Title</td>
                                            <td>@mark.MarksAwarded / @mark.Assessment.MaxMark (@percentage.ToString("F1")%)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p><strong>Average: @subjectMarks.Average(m => (m.MarksAwarded / m.Assessment.MaxMark) * 100).ToString("F1")%</strong></p>
                        }
                    </div>
                    <div class="col-md-6">
                        <h6>Attendance</h6>
                        @if (subjectAttendance.Count == 0)
                        {
                            <p class="text-muted">No attendance records yet.</p>
                        }
                        else
                        {
                            int presentCount = subjectAttendance.Count(ar => ar.Status == "Present");
                            float attendancePercentage = (presentCount * 100f) / subjectAttendance.Count;
                            <p>Present: @presentCount / @subjectAttendance.Count (@attendancePercentage.ToString("F1")%)</p>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in subjectAttendance.OrderByDescending(ar => ar.Session.Date))
                                    {
                                        <tr>
                                            <td>@record.Session.Date.ToString("dd MMM yyyy")</td>
                                            <td>@record.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private Learner? currentLearner;
    private List<Subject> subjects = new();
    private Dictionary<int, List<LearnerMark>> subjectMarksCache = new();
    private Dictionary<int, List<AttendanceRecord>> attendanceCache = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentLearner = await DbContext.Learners
                .AsNoTracking()
                .Include(l => l.User)
                .FirstOrDefaultAsync(l => l.UserId == user!.Id);

            if (currentLearner == null)
            {
                errorMessage = "You are not registered as a learner.";
                return;
            }

            subjects = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.LearnerId == currentLearner.LearnerId)
                .Include(ls => ls.Subject)
                .Select(ls => ls.Subject)
                .ToListAsync();

            // Load all marks for this learner at once
            var allMarks = await DbContext.LearnerMarks
                .AsNoTracking()
                .Where(m => m.LearnerId == currentLearner.LearnerId && !m.IsAbsent)  // ← Filter by learner
                .Include(m => m.Assessment)
                .ToListAsync();

            foreach (var subject in subjects)
            {
                subjectMarksCache[subject.SubjectId] = allMarks
                    .Where(m => m.Assessment.SubjectId == subject.SubjectId)
                    .ToList();
            }

            // Load all attendance for this learner at once
            var allAttendance = await DbContext.AttendanceRecords
                .AsNoTracking()
                .Where(ar => ar.LearnerId == currentLearner.LearnerId)  // ← Filter by learner
                .Include(ar => ar.Session)
                .ToListAsync();

            foreach (var subject in subjects)
            {
                attendanceCache[subject.SubjectId] = allAttendance
                    .Where(ar => ar.Session.SubjectId == subject.SubjectId)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading profile: {ex.Message}";
        }
    }
}
