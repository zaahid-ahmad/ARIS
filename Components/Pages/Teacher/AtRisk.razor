@page "/teacher/atrisk"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (subjects == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <label>Select Subject</label>
            <select class="form-control" @bind="selectedSubjectId">
                <option value="0">-- Select Subject --</option>
                @foreach (var subject in subjects)
                {
                    <option value="@subject.SubjectId">
                        @subject.Name (Grade @subject.Grade)
                    </option>
                }
            </select>
            <button class="btn btn-primary mt-2" @onclick="LoadAtRiskLearners">Load Learners</button>
        </div>
    </div>

    @if (atRiskLearners.Count > 0)
    {
        <h4>At-Risk Analysis</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Learner</th>
                    <th>Risk Level</th>
                    <th>Risk Score</th>
                    <th>Attendance %</th>
                    <th>Current Average</th>
                    <th>Intervention</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var learner in PagedAtRisk)
                {
                    var riskData = learnerRiskCache[learner.LearnerId];
                    var badgeClass = riskData.Level == "Critical" ? "danger" :
                                    riskData.Level == "High" ? "warning" : "info";
                    <tr>
                        <td>@learner.User?.Fullname</td>
                        <td>
                            <span class="badge bg-@badgeClass">@riskData.Level</span>
                        </td>
                        <td>@riskData.Score.ToString("F1")</td>
                        <td>@riskData.AttendancePercentage.ToString("F1")%</td>
                        <td>@riskData.AcademicAverage.ToString("F1")%</td>
                        <td>@riskData.Intervention</td>
                        <td>
                            <button class="btn btn-primary btn-sm"
                                    @onclick="() => ViewLearnerProfile(learner)">
                                View Profile
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
    }
    else if (selectedSubjectId > 0 && hasLoaded)
    {
        <div class="alert alert-success">
            No at-risk learners in this subject. Great job!
        </div>
    }
}

@code {
    private List<Subject> subjects = new();
    private List<Learner> atRiskLearners = new();
    private Dictionary<int, RiskData> learnerRiskCache = new();
    private int selectedSubjectId = 0;
    private bool hasLoaded = false;
    private Teacher? currentTeacher;
    private int? currentSchoolId;
    private string errorMessage = string.Empty;

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling(atRiskLearners.Count / (double)PageSize);
    private List<Learner> PagedAtRisk => atRiskLearners.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private void GoToPage(int page) => currentPage = page;

    private class RiskData
    {
        public string Level { get; set; } = string.Empty;
        public decimal Score { get; set; }
        public decimal AttendancePercentage { get; set; }
        public decimal AcademicAverage { get; set; }
        public string Intervention { get; set; } = string.Empty;
    }

    private void ViewLearnerProfile(Learner learner)
    {
        Navigation.NavigateTo($"/teacher/learnerprofiles?learner={learner.LearnerId}");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentTeacher = await DbContext.Teachers
                .AsNoTracking()
                .Include(t => t.User)
                .FirstOrDefaultAsync(t => t.UserId == user!.Id);

            if (currentTeacher == null)
            {
                errorMessage = "You are not registered as a teacher.";
                return;
            }

            currentSchoolId = currentTeacher.User?.SchoolId;

            if (currentSchoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                return;
            }

            // Only load subjects from this teacher's school
            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.TeacherId == currentTeacher.TeacherId && s.SchoolId == currentSchoolId)  // ← Filter by school
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task LoadAtRiskLearners()
    {
        try
        {
            if (selectedSubjectId == 0) return;

            if (!subjects.Any(s => s.SubjectId == selectedSubjectId))
            {
                errorMessage = "Subject not found.";
                return;
            }

            hasLoaded = false;
            learnerRiskCache.Clear();
            atRiskLearners.Clear();

            atRiskLearners = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.SubjectId == selectedSubjectId)
                .Include(ls => ls.Learner)
                .ThenInclude(l => l.User)
                .Select(ls => ls.Learner)
                .ToListAsync();

            // Pre-calculate all risk data
            foreach (var learner in atRiskLearners)
            {
                var riskData = await CalculateRiskScore(learner);
                learnerRiskCache[learner.LearnerId] = riskData;
            }

            // Filter to only at-risk learners
            atRiskLearners = atRiskLearners
                .Where(l => learnerRiskCache[l.LearnerId].Score >= 45)
                .ToList();

            hasLoaded = true;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading at-risk learners: {ex.Message}";
        }
    }

    private async Task<RiskData> CalculateRiskScore(Learner learner)
    {
        var riskData = new RiskData();

        // Calculate attendance percentage
        var attendanceRecords = await DbContext.AttendanceRecords
            .AsNoTracking()
            .Where(ar => ar.LearnerId == learner.LearnerId)
            .ToListAsync();

        int presentCount = attendanceRecords.Count(ar => ar.Status == "Present");
        riskData.AttendancePercentage = attendanceRecords.Count > 0
            ? (presentCount * 100m) / attendanceRecords.Count
            : 100m;

        // Calculate academic average
        var marks = await DbContext.LearnerMarks
            .AsNoTracking()
            .Where(m => m.Assessment.SubjectId == selectedSubjectId && m.LearnerId == learner.LearnerId && !m.IsAbsent)
            .Include(m => m.Assessment)
            .ToListAsync();

        if (marks.Count == 0)
        {
            riskData.AcademicAverage = 0;
        }
        else
        {
            decimal totalPercentage = 0m;
            foreach (var mark in marks)
            {
                decimal percentage = (mark.MarksAwarded / mark.Assessment.MaxMark) * 100m;
                totalPercentage += percentage;
            }
            riskData.AcademicAverage = totalPercentage / marks.Count;
        }

        // Calculate composite risk score
        // 60% academics + 30% attendance + 10% trend (simplified to 0 for now)
        decimal academicFactor = 60m * (riskData.AcademicAverage / 100m);
        decimal attendanceFactor = 30m * (riskData.AttendancePercentage / 100m);
        decimal trendFactor = 10m * 0.5m;

        riskData.Score = 100 - (academicFactor + attendanceFactor + trendFactor);

        // Determine risk level and intervention
        if (riskData.Score >= 55)
        {
            riskData.Level = "Critical";
            riskData.Intervention = "Urgent: Parent meeting required, intensive intervention needed";
        }
        else if (riskData.Score >= 45)
        {
            riskData.Level = "High";
            riskData.Intervention = "Schedule tutoring sessions, monitor progress closely";
        }
        else if (riskData.Score >= 30)
        {
            riskData.Level = "Moderate";
            riskData.Intervention = "Provide extra support, encourage participation";
        }
        else
        {
            riskData.Level = "Low";
            riskData.Intervention = "Continue regular monitoring";
        }

        return riskData;
    }
}