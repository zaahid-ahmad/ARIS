@page "/teacher/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject RiskOverviewService RiskOverviewSvc

<p>Welcome, @currentUser?.Fullname</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Attendance</h5>
                <p class="card-text">Capture today's attendance.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/attendance")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Marks</h5>
                <p class="card-text">Capture and view learner marks.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/marks")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">At-Risk Learners</h5>
                <p class="card-text">View flagged learners.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/atrisk")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Learner Profiles</h5>
                <p class="card-text">View learner interventions.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/teacher/learnerprofiles")'>
                    Go
                </button>
            </div>
        </div>
    </div>
</div>

<hr />

@if (isLoadingAlerts)
{
    <p>Checking learners...</p>
}
else if (atRiskLearnerCount == 0)
{
    <div class="alert alert-success">No at-risk learners across your subjects. Great job!</div>
}
else
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center"
         style="cursor: pointer;"
         @onclick='() => Navigation.NavigateTo("/teacher/atrisk")'>
        <span>
            <strong>⚠ You have @atRiskLearnerCount at-risk learner@(atRiskLearnerCount == 1 ? "" : "s")</strong>
            across your subjects.
        </span>
        <span class="badge bg-light text-danger">View At-Risk Learners →</span>
    </div>
}

@if (!isLoadingAlerts && subjectRiskCards.Count > 0)
{
    <div class="row mt-3">
        @foreach (var card in subjectRiskCards)
        {
            <div class="col-md-4">
                <div class="card mb-3" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/teacher/atrisk?subject={card.SubjectId}")'>
                    <div class="card-header">
                        <span class="card-title">@card.SubjectName (Grade @card.Grade)</span>
                    </div>
                    <div class="card-body text-center">
                        @if (card.TotalLearners == 0)
                        {
                            @((MarkupString)RiskChartSvg.Donut(card.Bands, 0, 96, $"{card.SubjectName} (Grade {card.Grade}) risk distribution"))
                            <p class="text-muted mt-2 mb-0">No learners enrolled</p>
                        }
                        else
                        {
                            @((MarkupString)RiskChartSvg.Donut(card.Bands, card.TotalLearners, 96, $"{card.SubjectName} (Grade {card.Grade}) risk distribution"))
                            <div class="legend justify-content-center mt-2">
                                @foreach (var band in card.Bands.Where(b => b.Count > 0))
                                {
                                    <div class="legend-item">
                                        <span class="legend-icon" style="background:@band.Color;border-radius:50%;"></span>
                                        <small class="text-muted">@band.Level: @band.Count</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private User? currentUser;
    private int? currentSchoolId;
    private string errorMessage = string.Empty;
    private bool isLoadingAlerts = true;
    private int atRiskLearnerCount = 0;

    private List<SubjectRiskSummary> subjectRiskCards = new();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.FindByNameAsync(user.Identity.Name!);
                currentSchoolId = currentUser?.SchoolId;

                if (currentSchoolId == null)
                {
                    errorMessage = "You are not assigned to a school.";
                    return;
                }

                await LoadAtRiskAlerts();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingAlerts = false;
        }
    }

    private async Task LoadAtRiskAlerts()
    {
        var teacher = await DbContext.Teachers
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.UserId == currentUser!.Id);

        if (teacher == null) return;

        // RiskOverviewService is the single batched risk walk (current year, this teacher's subjects only) shared with
        // the Admin Risk Overview; the banner count is its distinct at-risk learners, as before.
        var overview = await RiskOverviewSvc.BuildAsync(currentSchoolId!.Value, teacherId: teacher.TeacherId, useCache: false);

        atRiskLearnerCount = overview.Total.AtRisk;
        subjectRiskCards = overview.Subjects;
    }

    private void Logout()
    {
        Navigation.NavigateTo("/Account/Logout", forceLoad: true);
    }
}