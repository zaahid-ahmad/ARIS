@page "/teacher/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject RiskAssessmentService RiskAssessment

<p>Welcome, @currentUser?.Fullname</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Attendance</h5>
                <p class="card-text">Capture today's attendance.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/attendance")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Marks</h5>
                <p class="card-text">Capture and view learner marks.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/marks")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">At-Risk Learners</h5>
                <p class="card-text">View flagged learners.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/teacher/atrisk")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Learner Profiles</h5>
                <p class="card-text">View learner interventions.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/teacher/learnerprofiles")'>
                    Go
                </button>
            </div>
        </div>
    </div>
</div>

<hr />

@if (isLoadingAlerts)
{
    <p>Checking learners...</p>
}
else if (atRiskLearnerCount == 0)
{
    <div class="alert alert-success">No at-risk learners across your subjects. Great job!</div>
}
else
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center"
         style="cursor: pointer;"
         @onclick='() => Navigation.NavigateTo("/teacher/atrisk")'>
        <span>
            <strong>⚠ You have @atRiskLearnerCount at-risk learner@(atRiskLearnerCount == 1 ? "" : "s")</strong>
            across your subjects.
        </span>
        <span class="badge bg-light text-danger">View At-Risk Learners →</span>
    </div>
}

@if (!isLoadingAlerts && subjectRiskCards.Count > 0)
{
    <div class="row mt-3">
        @foreach (var card in subjectRiskCards)
        {
            <div class="col-md-4">
                <div class="card mb-3" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/teacher/atrisk")'>
                    <div class="card-header">
                        <span class="card-title">@card.SubjectName</span>
                    </div>
                    <div class="card-body text-center">
                        @if (card.TotalLearners == 0)
                        {
                            <svg width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="@($"{card.SubjectName} risk distribution")">
                                <circle cx="48" cy="48" r="40" fill="none" stroke="#e9ecef" stroke-width="12" />
                            </svg>
                            <p class="text-muted mt-2 mb-0">No learners enrolled</p>
                        }
                        else
                        {
                            <div style="position: relative; width: 96px; height: 96px; margin: 0 auto;">
                                <svg width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="@($"{card.SubjectName} risk distribution")">
                                    <circle cx="48" cy="48" r="40" fill="none" stroke="#e9ecef" stroke-width="12" />
                                    @{
                                        var circumference = 2 * Math.PI * 40;
                                        double drawnSoFar = 0;
                                    }
                                    @foreach (var band in card.Bands.Where(b => b.Count > 0))
                                    {
                                        var fraction = (double)band.Count / card.TotalLearners;
                                        var dash = fraction * circumference;
                                        var gap = circumference - dash;
                                        <circle cx="48" cy="48" r="40" fill="none"
                                                stroke="@band.Color" stroke-width="12"
                                                stroke-dasharray="@($"{dash.ToString(System.Globalization.CultureInfo.InvariantCulture)} {gap.ToString(System.Globalization.CultureInfo.InvariantCulture)}")"
                                                stroke-dashoffset="@((-drawnSoFar).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                transform="rotate(-90 48 48)" />
                                        drawnSoFar += dash;
                                    }
                                </svg>
                                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; color: var(--ink);">
                                    @card.TotalLearners
                                </div>
                            </div>
                            <div class="legend justify-content-center mt-2">
                                @foreach (var band in card.Bands.Where(b => b.Count > 0))
                                {
                                    <div class="legend-item">
                                        <span class="legend-icon" style="background:@band.Color;border-radius:50%;"></span>
                                        <small class="text-muted">@band.Level: @band.Count</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private User? currentUser;
    private int? currentSchoolId;
    private string errorMessage = string.Empty;
    private bool isLoadingAlerts = true;
    private int atRiskLearnerCount = 0;

    private class SubjectRiskCard
    {
        public int SubjectId { get; set; }
        public string SubjectName { get; set; } = "";
        public int TotalLearners { get; set; }
        // Fixed order: Critical, High, Moderate, Low — matches the palette order everywhere else.
        public List<(string Level, int Count, string Color)> Bands { get; set; } = new();
    }

    private List<SubjectRiskCard> subjectRiskCards = new();

    // Same palette/order as the AtRisk.razor scatter chart legend — ordered risk state, not categorical series.
    private static readonly (string Level, string Color)[] RiskLevelPalette =
    {
        ("Critical", "#d03b3b"),
        ("High", "#ec835a"),
        ("Moderate", "#fab219"),
        ("Low", "#0ca30c")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.FindByNameAsync(user.Identity.Name!);
                currentSchoolId = currentUser?.SchoolId;

                if (currentSchoolId == null)
                {
                    errorMessage = "You are not assigned to a school.";
                    return;
                }

                await LoadAtRiskAlerts();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingAlerts = false;
        }
    }

    private async Task LoadAtRiskAlerts()
    {
        var teacher = await DbContext.Teachers
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.UserId == currentUser!.Id);

        if (teacher == null) return;

        var subjects = await DbContext.Subjects
            .AsNoTracking()
            .Where(s => s.TeacherId == teacher.TeacherId && s.SchoolId == currentSchoolId)
            .ToListAsync();

        var atRiskLearnerIds = new HashSet<int>();
        var cards = new List<SubjectRiskCard>();

        foreach (var subject in subjects)
        {
            var learnerIds = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.SubjectId == subject.SubjectId)
                .Select(ls => ls.LearnerId)
                .ToListAsync();

            var levelCounts = RiskLevelPalette.ToDictionary(p => p.Level, p => 0);

            foreach (var learnerId in learnerIds)
            {
                var risk = await RiskAssessment.CalculateRiskScore(learnerId, subject.SubjectId);
                if (risk.Score >= RiskAssessmentService.AtRiskThreshold)
                {
                    atRiskLearnerIds.Add(learnerId);
                }
                levelCounts[risk.Level]++;
            }

            cards.Add(new SubjectRiskCard
            {
                SubjectId = subject.SubjectId,
                SubjectName = subject.Name,
                TotalLearners = learnerIds.Count,
                Bands = RiskLevelPalette.Select(p => (p.Level, levelCounts[p.Level], p.Color)).ToList()
            });
        }

        atRiskLearnerCount = atRiskLearnerIds.Count;
        subjectRiskCards = cards;
    }

    private void Logout()
    {
        Navigation.NavigateTo("/Account/Logout", forceLoad: true);
    }
}