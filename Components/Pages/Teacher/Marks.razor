@page "/teacher/marks"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ARIS1.Services
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@implements IDisposable
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject InterventionService InterventionService

<h2>Capture Marks</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label>Select Subject</label>
            <select class="form-control" @bind="selectedSubjectId" @bind:after="OnSubjectChanged">
                <option value="0">-- Select Subject --</option>
                @foreach (var subject in subjects)
                {
                    <option value="@subject.SubjectId">@subject.Name (Grade @subject.Grade)</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" @onclick="LoadSubjectData">Load Subject</button>
    </div>
</div>

@if (selectedSubjectId > 0 && learners.Count > 0)
{
    <h4>Assessments</h4>
    @if (assessments.Count == 0)
    {
        <p class="text-muted">No assessments created yet.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Term</th>
                    <th>Max Mark</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assessment in assessments)
                {
                    <tr>
                        <td>@assessment.Title</td>
                        <td>@(assessmentTypes.FirstOrDefault(t => t.AssessmentTypeId == assessment.AssessmentTypeId)?.Name ?? "-")</td>
                        <td>Term @assessment.Term</td>
                        <td>@assessment.MaxMark</td>
                        <td>@assessment.Date.ToString("dd MMM yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => OpenMarksModal(assessment)"
                                    disabled="@isModalOpen">
                                Capture Marks
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (isModalOpen && selectedAssessment != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Capture Marks — @selectedAssessment.Title
                        <small class="text-muted ms-2">(Max: @selectedAssessment.MaxMark)</small>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseMarksModal"></button>
                </div>
                <div class="modal-body">
                    @if (assessmentQuestions.Count == 0)
                    {
                        <p class="text-muted">No questions have been added to this assessment.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Learner</th>
                                        <th style="width: 90px;"></th>
                                        @foreach (var question in assessmentQuestions)
                                        {
                                            <th class="text-center">
                                                Q@(question.QuestionNumber)<br />
                                                <small class="text-muted">@question.Topic</small><br />
                                                <small class="text-muted">/ @question.MaxMark</small>
                                            </th>
                                        }
                                        <th class="text-center">Total</th>
                                        <th class="text-center">Absent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var learner in learners)
                                    {
                                        <tr>
                                            <td>@learner.User?.Fullname</td>
                                            <td>
                                                @{
                                                    var status = learnerSaveStatus.GetValueOrDefault(learner.LearnerId, LearnerSaveStatus.Idle);
                                                }
                                                @if (status == LearnerSaveStatus.Saving)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                                                }
                                                else if (status == LearnerSaveStatus.Saved)
                                                {
                                                    <span class="badge bg-success">&#10003; Saved</span>
                                                }
                                                else if (status == LearnerSaveStatus.Error)
                                                {
                                                    <span class="badge bg-danger">Error</span>
                                                }
                                            </td>
                                            @foreach (var question in assessmentQuestions)
                                            {
                                                var key = $"{learner.LearnerId}_{question.QuestionId}";
                                                <td>
                                                    <input type="number"
                                                           class="form-control form-control-sm"
                                                           style="width: 75px;"
                                                           @bind="marks[key]"
                                                           @bind:after="() => OnMarkChanged(learner.LearnerId, question)"
                                                           disabled="@isAbsent[learner.LearnerId]"
                                                           min="0"
                                                           max="@question.MaxMark" />
                                                </td>
                                            }
                                            <td class="text-center">
                                                @{
                                                    float total = 0;
                                                    foreach (var q in assessmentQuestions)
                                                        total += marks[$"{learner.LearnerId}_{q.QuestionId}"];
                                                }
                                                <strong>@total.ToString("F1")</strong>
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       @bind="isAbsent[learner.LearnerId]"
                                                       @bind:after="() => OnAbsentChanged(learner.LearnerId)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMarksModal">Done</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private enum LearnerSaveStatus { Idle, Saving, Saved, Error }

    private List<Subject> subjects = new();
    private List<Learner> learners = new();
    private List<AssessmentType> assessmentTypes = new();
    private List<Assessment> assessments = new();
    private List<AssessmentQuestion> assessmentQuestions = new();
    private Dictionary<string, float> marks = new();
    private Dictionary<int, bool> isAbsent = new();
    private Dictionary<int, LearnerSaveStatus> learnerSaveStatus = new();
    private Dictionary<int, CancellationTokenSource> debounceCts = new();

    private int selectedSubjectId = 0;
    private Assessment? selectedAssessment;
    private bool isModalOpen = false;
    private string errorMessage = string.Empty;
    private Teacher? currentTeacher;
    private int? currentSchoolId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentTeacher = await DbContext.Teachers
                .AsNoTracking()
                .Include(t => t.User)
                .FirstOrDefaultAsync(t => t.UserId == user!.Id);

            if (currentTeacher == null)
            {
                errorMessage = "You are not registered as a teacher.";
                return;
            }

            currentSchoolId = currentTeacher.User?.SchoolId;

            if (currentSchoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                return;
            }

            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.TeacherId == currentTeacher.TeacherId && s.SchoolId == currentSchoolId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void OnSubjectChanged()
    {
        if (isModalOpen) CloseMarksModal();
        learners.Clear();
        assessments.Clear();
        assessmentTypes.Clear();
    }

    private async Task LoadSubjectData()
    {
        if (selectedSubjectId == 0)
        {
            errorMessage = "Please select a subject.";
            return;
        }

        try
        {
            errorMessage = string.Empty;

            learners = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.SubjectId == selectedSubjectId)
                .Include(ls => ls.Learner)
                .ThenInclude(l => l.User)
                .Select(ls => ls.Learner)
                .ToListAsync();

            assessmentTypes = await DbContext.AssessmentTypes
                .AsNoTracking()
                .Where(at => at.SubjectId == selectedSubjectId)
                .ToListAsync();

            assessments = await DbContext.Assessments
                .AsNoTracking()
                .Where(a => a.SubjectId == selectedSubjectId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading subject data: {ex.Message}";
        }
    }

    private async Task OpenMarksModal(Assessment assessment)
    {
        selectedAssessment = assessment;
        assessmentQuestions.Clear();
        marks.Clear();
        isAbsent.Clear();
        learnerSaveStatus.Clear();
        CancelAllDebounces();
        errorMessage = string.Empty;

        try
        {
            assessmentQuestions = await DbContext.AssessmentQuestions
                .AsNoTracking()
                .Where(q => q.AssessmentId == assessment.AssessmentId)
                .OrderBy(q => q.QuestionNumber)
                .ToListAsync();

            var questionIds = assessmentQuestions.Select(q => q.QuestionId).ToList();
            var learnerIds  = learners.Select(l => l.LearnerId).ToList();

            var existingQuestionMarks = await DbContext.LearnerQuestionMarks
                .AsNoTracking()
                .Where(m => questionIds.Contains(m.QuestionId) && learnerIds.Contains(m.LearnerId))
                .ToListAsync();

            var existingAssessmentMarks = await DbContext.LearnerMarks
                .AsNoTracking()
                .Where(m => m.AssessmentId == assessment.AssessmentId && learnerIds.Contains(m.LearnerId))
                .ToListAsync();

            foreach (var learner in learners)
            {
                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                    var existing = existingQuestionMarks.FirstOrDefault(m =>
                        m.QuestionId == question.QuestionId && m.LearnerId == learner.LearnerId);
                    marks[key] = existing?.MarksAwarded ?? 0;
                }

                var absent = existingAssessmentMarks.FirstOrDefault(m => m.LearnerId == learner.LearnerId);
                isAbsent[learner.LearnerId] = absent?.IsAbsent ?? false;
                learnerSaveStatus[learner.LearnerId] = LearnerSaveStatus.Idle;
            }

            isModalOpen = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading assessment: {ex.Message}";
        }
    }

    private void CloseMarksModal()
    {
        CancelAllDebounces();
        isModalOpen = false;
        selectedAssessment = null;
        assessmentQuestions.Clear();
        marks.Clear();
        isAbsent.Clear();
        learnerSaveStatus.Clear();
    }

    private void OnMarkChanged(int learnerId, AssessmentQuestion question)
    {
        ValidateMark(learnerId, question);
        _ = DebounceAndSave(learnerId);
    }

    private void OnAbsentChanged(int learnerId)
    {
        _ = DebounceAndSave(learnerId);
    }

    private async Task DebounceAndSave(int learnerId)
    {
        if (debounceCts.TryGetValue(learnerId, out var existing))
        {
            existing.Cancel();
            existing.Dispose();
        }

        var cts = new CancellationTokenSource();
        debounceCts[learnerId] = cts;

        try
        {
            await Task.Delay(800, cts.Token);
            await SaveLearnerMarks(learnerId);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — no action needed
        }
    }

    private async Task SaveLearnerMarks(int learnerId)
    {
        if (selectedAssessment == null) return;

        // Validate total before saving
        if (!isAbsent[learnerId])
        {
            float total = assessmentQuestions.Sum(q => marks[$"{learnerId}_{q.QuestionId}"]);
            if (total > selectedAssessment.MaxMark)
            {
                learnerSaveStatus[learnerId] = LearnerSaveStatus.Error;
                errorMessage = $"Total marks ({total}) exceed the maximum of {selectedAssessment.MaxMark}.";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        learnerSaveStatus[learnerId] = LearnerSaveStatus.Saving;
        await InvokeAsync(StateHasChanged);

        try
        {
            var questionIds = assessmentQuestions.Select(q => q.QuestionId).ToList();

            var existingQuestionMarks = await DbContext.LearnerQuestionMarks
                .Where(m => questionIds.Contains(m.QuestionId) && m.LearnerId == learnerId)
                .ToListAsync();

            var existingAssessmentMark = await DbContext.LearnerMarks
                .FirstOrDefaultAsync(m =>
                    m.AssessmentId == selectedAssessment.AssessmentId &&
                    m.LearnerId == learnerId);

            await using var transaction = await DbContext.Database.BeginTransactionAsync();
            try
            {
                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learnerId}_{question.QuestionId}";
                    var existing = existingQuestionMarks.FirstOrDefault(m => m.QuestionId == question.QuestionId);

                    if (existing != null)
                    {
                        existing.MarksAwarded = marks[key];
                        DbContext.LearnerQuestionMarks.Update(existing);
                    }
                    else
                    {
                        DbContext.LearnerQuestionMarks.Add(new LearnerQuestionMark
                        {
                            QuestionId   = question.QuestionId,
                            LearnerId    = learnerId,
                            MarksAwarded = marks[key]
                        });
                    }
                }

                float totalMarksAwarded = isAbsent[learnerId]
                    ? 0
                    : assessmentQuestions.Sum(q => marks[$"{learnerId}_{q.QuestionId}"]);

                if (existingAssessmentMark != null)
                {
                    existingAssessmentMark.MarksAwarded = totalMarksAwarded;
                    existingAssessmentMark.IsAbsent     = isAbsent[learnerId];
                    DbContext.LearnerMarks.Update(existingAssessmentMark);
                }
                else
                {
                    DbContext.LearnerMarks.Add(new LearnerMark
                    {
                        AssessmentId = selectedAssessment.AssessmentId,
                        LearnerId    = learnerId,
                        MarksAwarded = totalMarksAwarded,
                        IsAbsent     = isAbsent[learnerId]
                    });
                }

                await DbContext.SaveChangesAsync();

                // InterventionService shares this DbContext (Scoped), so its
                // SaveChangesAsync calls participate in the same transaction
                if (!isAbsent[learnerId])
                {
                    foreach (var question in assessmentQuestions)
                    {
                        await InterventionService.GenerateInterventions(
                            learnerId,
                            question.QuestionId,
                            marks[$"{learnerId}_{question.QuestionId}"],
                            question.MaxMark
                        );
                    }
                }

                await transaction.CommitAsync();
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }

            learnerSaveStatus[learnerId] = LearnerSaveStatus.Saved;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            learnerSaveStatus[learnerId] = LearnerSaveStatus.Error;
            errorMessage = $"Error saving marks: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ValidateMark(int learnerId, AssessmentQuestion question)
    {
        var key = $"{learnerId}_{question.QuestionId}";
        if (marks[key] > question.MaxMark) marks[key] = question.MaxMark;
        if (marks[key] < 0)               marks[key] = 0;
    }

    private void CancelAllDebounces()
    {
        foreach (var cts in debounceCts.Values)
        {
            cts.Cancel();
            cts.Dispose();
        }
        debounceCts.Clear();
    }

    public void Dispose() => CancelAllDebounces();
}
