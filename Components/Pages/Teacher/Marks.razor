@page "/teacher/marks"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ARIS1.Services
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject InterventionService InterventionService

<h2>Capture Marks</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label>Select Subject</label>
            <select class="form-control" @bind="selectedSubjectId">
                <option value="0">-- Select Subject --</option>
                @foreach (var subject in subjects)
                {
                    <option value="@subject.SubjectId">
                        @subject.Name (Grade @subject.Grade)
                    </option>
                }
            </select>
        </div>
        <button class="btn btn-primary" @onclick="LoadSubjectData">Load Subject</button>
    </div>
</div>

@if (selectedSubjectId > 0 && learners.Count > 0)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <h4>Assessments</h4>
            @if (assessments.Count == 0)
            {
                <p class="text-muted">No assessments created yet.</p>
            }
            else
            {
                <div class="mb-3">
                    <label>Select Assessment to Capture Marks</label>
                    <select class="form-control" @bind="selectedAssessmentId">
                        <option value="0">-- Select Assessment --</option>
                        @foreach (var assessment in assessments)
                        {
                            <option value="@assessment.AssessmentId">
                                @assessment.Title (Max: @assessment.MaxMark)
                            </option>
                        }
                    </select>
                    <button class="btn btn-primary mt-2" @onclick="LoadQuestions">
                        Load Questions
                    </button>
                </div>
            }
        </div>
    </div>

    @if (selectedAssessmentId > 0 && assessmentQuestions.Count > 0)
    {
        <h4>Enter Marks by Question</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Learner</th>
                    @foreach (var question in assessmentQuestions)
                    {
                        <th>Q@(question.QuestionNumber) (@question.Topic) - @question.MaxMark</th>
                    }
                    <th>Total</th>
                    <th>Absent</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var learner in learners)
                {
                    <tr>
                        <td>@learner.User?.Fullname</td>
                        @foreach (var question in assessmentQuestions)
                        {
                            var key = $"{learner.LearnerId}_{question.QuestionId}";
                            <td>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="marks[key]"
                                       @bind:after="() => ValidateMark(learner.LearnerId, question)"
                                       disabled="@isAbsent[learner.LearnerId]"
                                       max="@question.MaxMark" />
                            </td>
                        }
                        <td>
                            @{
                                float total = 0;
                                foreach (var question in assessmentQuestions)
                                {
                                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                                    total += marks[key];
                                }
                            }
                            <strong>@total.ToString("F1")</strong>
                        </td>
                        <td>
                            <input type="checkbox" @bind="isAbsent[learner.LearnerId]" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-success mt-2" @onclick="SaveMarks">
            Save Marks
        </button>
    }
}

@code {
    private List<Subject> subjects = new();
    private List<Learner> learners = new();
    private List<AssessmentType> assessmentTypes = new();
    private List<Assessment> assessments = new();
    private List<AssessmentQuestion> assessmentQuestions = new();
    private Dictionary<string, float> marks = new();
    private Dictionary<int, bool> isAbsent = new();
    private int selectedSubjectId = 0;
    private int selectedAssessmentId = 0;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private Teacher? currentTeacher;
    private int? currentSchoolId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentTeacher = await DbContext.Teachers
                .AsNoTracking()
                .Include(t => t.User)
                .FirstOrDefaultAsync(t => t.UserId == user!.Id);

            if (currentTeacher == null)
            {
                errorMessage = "You are not registered as a teacher.";
                return;
            }

            currentSchoolId = currentTeacher.User?.SchoolId;

            if (currentSchoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                return;
            }

            // Only load subjects from this teacher's school
            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.TeacherId == currentTeacher.TeacherId && s.SchoolId == currentSchoolId)  // ← Filter by school
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    // Validate marks
    private void ValidateMark(int learnerId, AssessmentQuestion question)
    {
        var key = $"{learnerId}_{question.QuestionId}";
        if (marks[key] > question.MaxMark)
        {
            marks[key] = question.MaxMark;
            errorMessage = $"Mark capped at {question.MaxMark} for {question.Topic}";
        }
        if (marks[key] < 0)
        {
            marks[key] = 0;
            errorMessage = "Mark cannot be negative.";
        }
    }

    private async Task LoadSubjectData()
    {
        if (selectedSubjectId == 0)
        {
            errorMessage = "Please select a subject.";
            return;
        }

        try
        {
            errorMessage = string.Empty;

            // Load learners enrolled in this subject
            learners = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.SubjectId == selectedSubjectId)
                .Include(ls => ls.Learner)
                .ThenInclude(l => l.User)
                .Select(ls => ls.Learner)
                .ToListAsync();

            // Load assessment types for this subject
            assessmentTypes = await DbContext.AssessmentTypes
                .AsNoTracking()
                .Where(at => at.SubjectId == selectedSubjectId)
                .ToListAsync();

            // Load assessments for this subject
            assessments = await DbContext.Assessments
                .AsNoTracking()
                .Where(a => a.SubjectId == selectedSubjectId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading subject data: {ex.Message}";
        }
    }

    private async Task LoadQuestions()
    {
        try
        {
            if (selectedAssessmentId == 0) return;

            assessmentQuestions = await DbContext.AssessmentQuestions
                .AsNoTracking()
                .Where(q => q.AssessmentId == selectedAssessmentId)
                .OrderBy(q => q.QuestionNumber)
                .ToListAsync();

            marks.Clear();

            var questionIds = assessmentQuestions.Select(q => q.QuestionId).ToList();
            var learnerIds  = learners.Select(l => l.LearnerId).ToList();

            var existingQuestionMarks = await DbContext.LearnerQuestionMarks
                .AsNoTracking()
                .Where(m => questionIds.Contains(m.QuestionId) && learnerIds.Contains(m.LearnerId))
                .ToListAsync();

            var existingAssessmentMarks = await DbContext.LearnerMarks
                .AsNoTracking()
                .Where(m => m.AssessmentId == selectedAssessmentId && learnerIds.Contains(m.LearnerId))
                .ToListAsync();

            foreach (var learner in learners)
            {
                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                    var existing = existingQuestionMarks.FirstOrDefault(m =>
                        m.QuestionId == question.QuestionId && m.LearnerId == learner.LearnerId);
                    marks[key] = existing?.MarksAwarded ?? 0;
                }

                var absent = existingAssessmentMarks.FirstOrDefault(m => m.LearnerId == learner.LearnerId);
                isAbsent[learner.LearnerId] = absent?.IsAbsent ?? false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading questions: {ex.Message}";
        }
    }

    private async Task SaveMarks()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            if (selectedAssessmentId == 0 || assessmentQuestions.Count == 0)
            {
                errorMessage = "Please load questions first.";
                return;
            }

            var selectedAssessment = assessments.FirstOrDefault(a => a.AssessmentId == selectedAssessmentId);
            if (selectedAssessment == null)
            {
                errorMessage = "Assessment not found.";
                return;
            }

            // Validate total marks per learner
            foreach (var learner in learners)
            {
                if (isAbsent[learner.LearnerId]) continue;

                float totalMarksEntered = 0;
                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                    totalMarksEntered += marks[key];
                }

                if (totalMarksEntered > selectedAssessment.MaxMark)
                {
                    errorMessage = $"Total marks for {learner.User?.Fullname} ({totalMarksEntered}) exceed the maximum ({selectedAssessment.MaxMark}).";
                    return;
                }
            }

            // Save question-level marks
            var saveQuestionIds = assessmentQuestions.Select(q => q.QuestionId).ToList();
            var saveLearnerIds  = learners.Select(l => l.LearnerId).ToList();

            var existingQuestionMarksForSave = await DbContext.LearnerQuestionMarks
                .Where(m => saveQuestionIds.Contains(m.QuestionId) && saveLearnerIds.Contains(m.LearnerId))
                .ToListAsync();

            foreach (var learner in learners)
            {
                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                    var existing = existingQuestionMarksForSave.FirstOrDefault(m =>
                        m.QuestionId == question.QuestionId && m.LearnerId == learner.LearnerId);

                    if (existing != null)
                    {
                        existing.MarksAwarded = marks[key];
                        DbContext.LearnerQuestionMarks.Update(existing);
                    }
                    else
                    {
                        DbContext.LearnerQuestionMarks.Add(new LearnerQuestionMark
                        {
                            QuestionId   = question.QuestionId,
                            LearnerId    = learner.LearnerId,
                            MarksAwarded = marks[key]
                        });
                    }
                }
            }

            await DbContext.SaveChangesAsync();

            // Calculate and save overall assessment marks from question marks
            var existingAssessmentMarksForSave = await DbContext.LearnerMarks
                .Where(m => m.AssessmentId == selectedAssessmentId && saveLearnerIds.Contains(m.LearnerId))
                .ToListAsync();

            foreach (var learner in learners)
            {
                float totalMarksAwarded = 0;
                foreach (var question in assessmentQuestions)
                    totalMarksAwarded += marks[$"{learner.LearnerId}_{question.QuestionId}"];

                var existingAssessmentMark = existingAssessmentMarksForSave
                    .FirstOrDefault(m => m.LearnerId == learner.LearnerId);

                if (existingAssessmentMark != null)
                {
                    existingAssessmentMark.MarksAwarded = totalMarksAwarded;
                    existingAssessmentMark.IsAbsent     = isAbsent[learner.LearnerId];
                    DbContext.LearnerMarks.Update(existingAssessmentMark);
                }
                else
                {
                    DbContext.LearnerMarks.Add(new LearnerMark
                    {
                        AssessmentId = selectedAssessmentId,
                        LearnerId    = learner.LearnerId,
                        MarksAwarded = totalMarksAwarded,
                        IsAbsent     = isAbsent[learner.LearnerId]
                    });
                }
            }

            await DbContext.SaveChangesAsync();

            // Generate interventions for each learner and question
            foreach (var learner in learners)
            {
                if (isAbsent[learner.LearnerId]) continue;

                foreach (var question in assessmentQuestions)
                {
                    var key = $"{learner.LearnerId}_{question.QuestionId}";
                    await InterventionService.GenerateInterventions(
                        learner.LearnerId,
                        question.QuestionId,
                        marks[key],
                        question.MaxMark
                    );
                }
            }

            successMessage = "Marks and interventions saved successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving marks: {ex.Message}";
        }
    }
}