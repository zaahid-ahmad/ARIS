@page "/teacher/attendance"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label>Select Subject</label>
            <select class="form-control" @bind="selectedSubjectId">
                <option value="0">-- Select Subject --</option>
                @foreach (var subject in subjects)
                {
                    <option value="@subject.SubjectId">
                        @subject.Name (Grade @subject.Grade)
                    </option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Date</label>
            <input type="date" class="form-control"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   @bind="sessionDate" />
        </div>
        <button class="btn btn-primary" @onclick="() => LoadLearners()">Load Learners</button>
    </div>
</div>

@if (learners.Count > 0)
{
    <h4>
        @(existingSession != null ? "Editing" : "New") Attendance — @sessionDate.ToString("dd MMM yyyy") @sessionTime.ToString("HH:mm")
        @if (existingSession != null)
        {
            <span class="badge bg-warning text-dark ms-2">Editing existing session</span>
        }
    </h4>
    <table class="table">
        <thead>
            <tr>
                <th>Learner</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var learner in learners)
            {
                var status = attendanceStatus.TryGetValue(learner.LearnerId, out var s) ? s : "";
                var isInvalid = invalidStatuses.Contains(learner.LearnerId);
                <tr>
                    <td>@learner.User?.Fullname</td>
                    <td>
                        <select class="form-control @(isInvalid ? "is-invalid" : "")"
                                value="@status"
                                @onchange="e => OnStatusChanged(learner.LearnerId, e.Value?.ToString())">
                            <option value="">-- Select --</option>
                            <option value="@AttendanceStatus.Present">Present</option>
                            <option value="@AttendanceStatus.Absent">Absent</option>
                            <option value="@AttendanceStatus.Late">Late</option>
                            <option value="@AttendanceStatus.Excused">Excused</option>
                        </select>
                        @if (isInvalid)
                        {
                            <small class="text-danger">Please select a status.</small>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-success mt-2" @onclick="SaveAttendance">
        @(existingSession != null ? "Update Attendance" : "Save Attendance")
    </button>
    <button class="btn btn-secondary mt-2 ms-2" @onclick="ClearForm">Cancel</button>
}

@if (pastSessionRows.Count > 0)
{
    <hr />
    <h5>Recent Sessions</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Subject</th>
                <th>Records</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in pastSessionRows)
            {
                <tr>
                    <td>@row.Date.ToString("dd MMM yyyy")</td>
                    <td>@row.Time.ToString("HH:mm")</td>
                    <td>@row.SubjectName</td>
                    <td>@row.RecordCount</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => LoadSession(row)">
                            Edit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <Pager CurrentPage="sessionsPage" TotalPages="sessionsTotalPages" OnPageChanged="GoToSessionsPage" />
}

@code {
    private static class AttendanceStatus
    {
        public const string Present = "Present";
        public const string Absent = "Absent";
        public const string Late = "Late";
        public const string Excused = "Excused";
    }

    private List<Subject> subjects = new();
    private List<Learner> learners = new();
    private Dictionary<int, string> attendanceStatus = new();
    private HashSet<int> invalidStatuses = new();
    private List<PastSessionVm> pastSessionRows = new();
    private AttendanceSession? existingSession;
    private int selectedSubjectId = 0;
    private DateTime sessionDate = DateTime.Today;
    private TimeOnly sessionTime = new TimeOnly(DateTime.Now.Hour, DateTime.Now.Minute);
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private Teacher? currentTeacher;
    private int? currentSchoolId;

    private int sessionsPage = 1;
    private const int PageSize = 15;
    private int sessionsTotalCount;
    private int sessionsTotalPages => (int)Math.Ceiling(sessionsTotalCount / (double)PageSize);

    private class PastSessionVm
    {
        public int SessionId { get; set; }
        public DateTime Date { get; set; }
        public TimeOnly Time { get; set; }
        public int SubjectId { get; set; }
        public string SubjectName { get; set; } = string.Empty;
        public int RecordCount { get; set; }
    }

    private async Task GoToSessionsPage(int page)
    {
        sessionsPage = page;
        await LoadPastSessions();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

            currentTeacher = await DbContext.Teachers
                .AsNoTracking()
                .Include(t => t.User)
                .FirstOrDefaultAsync(t => t.UserId == user!.Id);

            if (currentTeacher == null)
            {
                errorMessage = "You are not registered as a teacher.";
                return;
            }

            currentSchoolId = currentTeacher.User?.SchoolId;

            if (currentSchoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                return;
            }

            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.TeacherId == currentTeacher.TeacherId && s.SchoolId == currentSchoolId)
                .ToListAsync();

            await LoadPastSessions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void OnStatusChanged(int learnerId, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            attendanceStatus.Remove(learnerId);
            invalidStatuses.Add(learnerId);
        }
        else
        {
            attendanceStatus[learnerId] = value;
            invalidStatuses.Remove(learnerId);
        }
    }

    // editSessionId distinguishes the two ways this method gets called:
    //  - null: the "Load Learners" button for a fresh capture — look for an existing session by
    //    subject+date+*current* time, purely to guard against accidentally creating a second
    //    session if the teacher re-clicks within the same minute.
    //  - set: the "Edit" button on a specific row in "Recent Sessions" — that row already IS a
    //    known session, so look it up directly by SessionId. Previously this reused the same
    //    "match by current time" lookup as the fresh-capture path, which almost never matched a
    //    past session (edited at a different wall-clock minute than it was created), silently
    //    behaving like "New" instead of "Editing" and creating a duplicate session on Save
    //    (issue #38).
    private async Task LoadLearners(int? editSessionId = null)
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;

            if (selectedSubjectId == 0)
            {
                errorMessage = "Please select a subject.";
                return;
            }

            // Verify teacher owns this subject
            if (!subjects.Any(s => s.SubjectId == selectedSubjectId))
            {
                errorMessage = "Subject not found.";
                return;
            }

            // Prevent future dates
            if (sessionDate > DateTime.Today)
            {
                errorMessage = "Cannot capture attendance for a future date.";
                return;
            }

            learners = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.SubjectId == selectedSubjectId)
                .Include(ls => ls.Learner)
                .ThenInclude(l => l.User)
                .Select(ls => ls.Learner)
                .ToListAsync();

            attendanceStatus.Clear();
            invalidStatuses.Clear();

            if (editSessionId.HasValue)
            {
                existingSession = await DbContext.AttendanceSessions
                    .Include(s => s.AttendanceRecords)
                    .FirstOrDefaultAsync(s => s.SessionId == editSessionId.Value);
            }
            else
            {
                var now = new TimeOnly(DateTime.Now.Hour, DateTime.Now.Minute);
                existingSession = await DbContext.AttendanceSessions
                    .Include(s => s.AttendanceRecords)
                    .FirstOrDefaultAsync(s => s.SubjectId == selectedSubjectId &&
                                              s.Date.Date == sessionDate.Date &&
                                              s.Time == now);
            }

            if (existingSession != null)
            {
                sessionTime = existingSession.Time;
                // Pre-populate statuses from existing records
                foreach (var record in existingSession.AttendanceRecords)
                {
                    attendanceStatus[record.LearnerId] = record.Status;
                }
            }
            else
            {
                sessionTime = new TimeOnly(DateTime.Now.Hour, DateTime.Now.Minute);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading learners: {ex.Message}";
        }
    }

    private async Task LoadSession(PastSessionVm row)
    {
        selectedSubjectId = row.SubjectId;
        sessionDate = row.Date;
        await LoadLearners(row.SessionId);
    }

    private async Task SaveAttendance()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (selectedSubjectId == 0 || learners.Count == 0)
        {
            errorMessage = "Please load learners first.";
            return;
        }

        // Validate all statuses are set
        invalidStatuses.Clear();
        foreach (var learner in learners)
        {
            if (!attendanceStatus.TryGetValue(learner.LearnerId, out var s) || string.IsNullOrEmpty(s))
                invalidStatuses.Add(learner.LearnerId);
        }

        if (invalidStatuses.Count > 0)
        {
            errorMessage = "Please select a status for every learner.";
            return;
        }

        // Server-side date check
        if (sessionDate > DateTime.Today)
        {
            errorMessage = "Cannot capture attendance for a future date.";
            return;
        }

        var normalizedTime = new TimeOnly(sessionTime.Hour, sessionTime.Minute);

        await using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            if (existingSession != null)
            {
                // Update existing records
                var existingRecords = await DbContext.AttendanceRecords
                    .Where(r => r.SessionId == existingSession.SessionId)
                    .ToListAsync();

                foreach (var learner in learners)
                {
                    var record = existingRecords.FirstOrDefault(r => r.LearnerId == learner.LearnerId);
                    if (record != null)
                    {
                        record.Status = attendanceStatus[learner.LearnerId];
                    }
                    else
                    {
                        DbContext.AttendanceRecords.Add(new AttendanceRecord
                        {
                            SessionId = existingSession.SessionId,
                            LearnerId = learner.LearnerId,
                            Status = attendanceStatus[learner.LearnerId]
                        });
                    }
                }

                await DbContext.SaveChangesAsync();
            }
            else
            {
                var session = new AttendanceSession
                {
                    SubjectId = selectedSubjectId,
                    TeacherId = currentTeacher!.TeacherId,
                    Date = sessionDate.Date,
                    Time = normalizedTime,
                };

                DbContext.AttendanceSessions.Add(session);
                await DbContext.SaveChangesAsync();

                foreach (var learner in learners)
                {
                    DbContext.AttendanceRecords.Add(new AttendanceRecord
                    {
                        SessionId = session.SessionId,
                        LearnerId = learner.LearnerId,
                        Status = attendanceStatus[learner.LearnerId]
                    });
                }

                await DbContext.SaveChangesAsync();
            }

            await transaction.CommitAsync();
            successMessage = existingSession != null
                ? "Attendance updated successfully!"
                : "Attendance saved successfully!";

            sessionsPage = 1;
            await LoadPastSessions();
            ClearForm();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            errorMessage = $"Error saving attendance: {ex.Message}";
        }
    }

    // Filtering, ordering, and paging all happen in SQL — this previously loaded every session
    // this teacher has ever run (with the full AttendanceRecords collection eagerly included
    // just to display a count), unconditionally, on every page load. For a teacher with a few
    // sections that's thousands of AttendanceRecord rows materialized to show a "Records"
    // column. Now only the current page's rows are pulled, and RecordCount is a COUNT(*)
    // subquery via the projection instead of a materialized collection.
    private async Task LoadPastSessions()
    {
        if (currentTeacher == null) return;

        var subjectIds = subjects.Select(s => s.SubjectId).ToList();

        var query = DbContext.AttendanceSessions
            .AsNoTracking()
            .Where(s => subjectIds.Contains(s.SubjectId));

        sessionsTotalCount = await query.CountAsync();

        pastSessionRows = await query
            .OrderByDescending(s => s.Date)
            .ThenByDescending(s => s.Time)
            .Skip((sessionsPage - 1) * PageSize)
            .Take(PageSize)
            .Select(s => new PastSessionVm
            {
                SessionId = s.SessionId,
                Date = s.Date,
                Time = s.Time,
                SubjectId = s.SubjectId,
                SubjectName = s.Subject.Name,
                RecordCount = s.AttendanceRecords.Count
            })
            .ToListAsync();
    }

    private void ClearForm()
    {
        learners.Clear();
        attendanceStatus.Clear();
        invalidStatuses.Clear();
        existingSession = null;
        selectedSubjectId = 0;
        sessionDate = DateTime.Today;
        sessionTime = new TimeOnly(DateTime.Now.Hour, DateTime.Now.Minute);
    }
}
