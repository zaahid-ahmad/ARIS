@page "/teacher/attendance"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<h2>Capture Attendance</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label>Select Subject</label>
            <select class="form-control" @bind="selectedSubjectId">
                <option value="0">-- Select Subject --</option>
                @foreach (var subject in subjects)
                {
                    <option value="@subject.SubjectId">
                        @subject.Name (Grade @subject.Grade)
                    </option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Date</label>
            <input type="date" class="form-control" @bind="sessionDate" />
        </div>
        <button class="btn btn-primary" @onclick="LoadLearners">Load Learners</button>
    </div>
</div>

@if (learners.Count > 0)
{
    <h4>Mark Attendance for @sessionDate.ToString("dd MMM yyyy")</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Learner</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var learner in learners)
            {
                <tr>
                    <td>@learner.User?.Fullname</td>
                    <td>
                        <select class="form-control"
                                @bind="attendanceStatus[learner.LearnerId]">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Late">Late</option>
                            <option value="Excused">Excused</option>
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-success mt-2" @onclick="SaveAttendance">
        Save Attendance
    </button>
}

@code {
    private List<Subject> subjects = new();
    private List<Learner> learners = new();
    private Dictionary<int, string> attendanceStatus = new();
    private int selectedSubjectId = 0;
    private DateTime sessionDate = DateTime.Today;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private Teacher? currentTeacher;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);

        currentTeacher = await DbContext.Teachers
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.UserId == user!.Id);

        if (currentTeacher != null)
        {
            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.TeacherId == currentTeacher.TeacherId)
                .ToListAsync();
        }
    }

    private async Task LoadLearners()
    {
        if (selectedSubjectId == 0)
        {
            errorMessage = "Please select a subject.";
            return;
        }

        errorMessage = string.Empty;

        learners = await DbContext.LearnerSubjects
            .AsNoTracking()
            .Where(ls => ls.SubjectId == selectedSubjectId)
            .Include(ls => ls.Learner)
            .ThenInclude(l => l.User)
            .Select(ls => ls.Learner)
            .ToListAsync();

        attendanceStatus.Clear();
        foreach (var learner in learners)
        {
            attendanceStatus[learner.LearnerId] = "Present";
        }
    }

    private async Task SaveAttendance()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (selectedSubjectId == 0 || learners.Count == 0)
        {
            errorMessage = "Please load learners first.";
            return;
        }

        var session = new AttendanceSession
        {
            SubjectId = selectedSubjectId,
            TeacherId = currentTeacher!.TeacherId,
            Date = sessionDate,
        };

        DbContext.AttendanceSessions.Add(session);
        await DbContext.SaveChangesAsync();

        foreach (var learner in learners)
        {
            var record = new AttendanceRecord
            {
                SessionId = session.SessionId,
                LearnerId = learner.LearnerId,
                Status = attendanceStatus[learner.LearnerId]
            };
            DbContext.AttendanceRecords.Add(record);
        }

        await DbContext.SaveChangesAsync();
        successMessage = "Attendance saved successfully!";
        learners.Clear();
        attendanceStatus.Clear();
    }
}