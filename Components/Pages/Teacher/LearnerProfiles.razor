@page "/teacher/learnerprofiles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher,Admin")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<h2>Learner Profiles</h2>

<div class="mb-3 mt-3 d-flex gap-2">
    <input class="form-control" placeholder="Search by name..."
           @bind="searchTerm" />
    <button class="btn btn-primary" @onclick="SearchLearners">Search</button>
    <button class="btn btn-secondary" @onclick="ClearSearch">Clear</button>
</div>

@if (filteredLearners.Count == 0)
{
    <p class="text-muted">No learners found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Grade</th>
                <th>Class</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var learner in filteredLearners)
            {
                <tr>
                    <td>@learner.User?.Fullname</td>
                    <td>@learner.Grade</td>
                    <td>@learner.ClassName</td>
                    <td>
                        <button class="btn btn-primary btn-sm"
                                @onclick="() => ViewProfile(learner)">
                            View Profile
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (selectedLearner != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @selectedLearner.User?.Fullname — Grade @selectedLearner.Grade
                    </h5>
                </div>
                <div class="modal-body">
                    <h5>Interventions by Subject</h5>
                    @if (learnerSubjects.Count == 0)
                    {
                        <p class="text-muted">Not enrolled in any subjects.</p>
                    }
                    else
                    {
                        @foreach (var subject in learnerSubjects)
                        {
                            <h6 class="mt-3">@subject.Name (Grade @subject.Grade)</h6>
                            @foreach (var term in new[] { 1, 2, 3, 4 })
                            {
                                var termInterventions = learnerInterventions
                                    .Where(i => i.Question.Assessment.SubjectId == subject.SubjectId &&
                                               i.Question.Assessment.Term == term)
                                    .ToList();

                                if (termInterventions.Count > 0)
                                {
                                    <h6 class="text-muted">Term @term</h6>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Assessment</th>
                                                <th>Topic</th>
                                                <th>Score</th>
                                                <th>Status</th>
                                                <th>Message</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var intervention in termInterventions)
                                            {
                                                var badgeColor = intervention.Level == "Critical" ? "#dc3545" :
                                                                 intervention.Level == "Attention" ? "#fd7e14" :
                                                                 intervention.Level == "Focus" ? "#ffc107" :
                                                                 intervention.Level == "Minor" ? "#90EE90" : "#198754";
                                                var textColor = intervention.Level == "Focus" ||
                                                                intervention.Level == "Minor" ? "black" : "white";
                                                <tr>
                                                    <td>@intervention.Question.Assessment.Title</td>
                                                    <td>@intervention.Topic</td>
                                                    <td>@intervention.PercentageScore.ToString("F1")%</td>
                                                    <td>
                                                        <span class="badge"
                                                              style="background-color: @badgeColor; color: @textColor">
                                                            @intervention.Level
                                                        </span>
                                                    </td>
                                                    <td>@intervention.Message</td>
                                                    <td>@intervention.CreatedDate.ToString("dd MMM yyyy")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="() => selectedLearner = null">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "learner")]
    public int LearnerIdFromQuery { get; set; }
    private List<Learner> allLearners = new();
    private List<Learner> filteredLearners = new();
    private List<Subject> learnerSubjects = new();
    private List<Intervention> learnerInterventions = new();
    private Learner? selectedLearner;
    private string searchTerm = string.Empty;
    private Teacher? currentTeacher;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);
        var isAdmin = authState.User.IsInRole("Admin");

        if (isAdmin)
        {
            allLearners = await DbContext.Learners
                .AsNoTracking()
                .Include(l => l.User)
                .ToListAsync();
        }
        else
        {
            currentTeacher = await DbContext.Teachers
                .AsNoTracking()
                .FirstOrDefaultAsync(t => t.UserId == user!.Id);

            if (currentTeacher != null)
            {
                allLearners = await DbContext.LearnerSubjects
                    .AsNoTracking()
                    .Where(ls => ls.Subject.TeacherId == currentTeacher.TeacherId)
                    .Include(ls => ls.Learner)
                    .ThenInclude(l => l.User)
                    .Select(ls => ls.Learner)
                    .Distinct()
                    .ToListAsync();
            }
        }

        filteredLearners = allLearners;

        // Auto-open profile if learner ID is passed from At-Risk page
        if (LearnerIdFromQuery > 0)
        {
            var learner = allLearners.FirstOrDefault(l => l.LearnerId == LearnerIdFromQuery);
            if (learner != null)
                await ViewProfile(learner);
        }
    }

    private void SearchLearners()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredLearners = allLearners;
            return;
        }

        filteredLearners = allLearners
            .Where(l => l.User!.Fullname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        filteredLearners = allLearners;
    }

    private async Task ViewProfile(Learner learner)
    {
        selectedLearner = learner;

        learnerSubjects = await DbContext.LearnerSubjects
            .AsNoTracking()
            .Where(ls => ls.LearnerId == learner.LearnerId)
            .Include(ls => ls.Subject)
            .Select(ls => ls.Subject)
            .ToListAsync();

        learnerInterventions = await DbContext.Interventions
            .AsNoTracking()
            .Where(i => i.LearnerId == learner.LearnerId)
            .Include(i => i.Question)
            .ThenInclude(q => q.Assessment)
            .OrderBy(i => i.Question.Assessment.Term)
            .ThenBy(i => i.Level)
            .ToListAsync();
    }
}