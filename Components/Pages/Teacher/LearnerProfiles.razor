@page "/teacher/learnerprofiles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Teacher,Admin")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<!-- Search and Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Search by Name</label>
                <input class="form-control" placeholder="Enter learner name..."
                       @bind="searchTerm" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Filter by Grade</label>
                <select class="form-control" @bind="selectedGrade" @bind:after="OnGradeChanged">
                    <option value="0">-- All Grades --</option>
                    <option value="10">Grade 10</option>
                    <option value="11">Grade 11</option>
                    <option value="12">Grade 12</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button class="btn btn-primary w-100" @onclick="SearchLearners">Search</button>
                <button class="btn btn-secondary w-100" @onclick="ClearSearch">Clear</button>
            </div>
        </div>
    </div>
</div>

<!-- Learners Table -->
@if (filteredLearners.Count == 0)
{
    <div class="alert alert-info">No learners found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Grade</th>
                    <th>Class</th>
                    <th>Subjects Enrolled</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var learner in PagedLearners)
                {
                    var subjectCount = learnerSubjectsCache.ContainsKey(learner.LearnerId)
                        ? learnerSubjectsCache[learner.LearnerId].Count
                        : 0;

                    <tr>
                        <td><strong>@learner.User?.Fullname</strong></td>
                        <td>
                            <span class="badge bg-info">Grade @learner.Grade</span>
                        </td>
                        <td>@learner.ClassName</td>
                        <td>@subjectCount subject(s)</td>
                        <td>
                            <button class="btn btn-primary btn-sm"
                                    @onclick="() => ViewProfile(learner)">
                                View Profile
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
    </div>
}

<!-- Profile Modal -->
@if (selectedLearner != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@selectedLearner.User?.Fullname</h5>
                        <small class="text-muted">Grade @selectedLearner.Grade • @selectedLearner.ClassName</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => selectedLearner = null"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                    @if (learnerSubjects.Count == 0)
                    {
                        <div class="alert alert-warning">Not enrolled in any subjects.</div>
                    }
                    else
                    {
                        @foreach (var subject in learnerSubjects)
                        {
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h6 class="mb-0">@subject.Name <span class="badge bg-secondary ms-2">Grade @subject.Grade</span></h6>
                                </div>
                                <div class="card-body">
                                    @{
                                        var subjectInterventions = learnerInterventions
                                            .Where(i => i.Question.Assessment.SubjectId == subject.SubjectId)
                                            .ToList();

                                        var subjectMarks = assessmentMarksCache.ContainsKey(subject.SubjectId)
                                            ? assessmentMarksCache[subject.SubjectId]
                                            : new List<AssessmentMarkInfo>();
                                    }

                                    <!-- Assessment Marks Summary -->
                                    @if (subjectMarks.Count > 0)
                                    {
                                        <h6 class="mb-3">Assessment Performance</h6>
                                        <div class="table-responsive mb-4">
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Assessment</th>
                                                        <th>Type</th>
                                                        <th>Term</th>
                                                        <th class="text-end">Mark</th>
                                                        <th class="text-end">%</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var mark in subjectMarks)
                                                    {
                                                        var percentage = (mark.MarksAwarded / mark.MaxMark) * 100;
                                                        var percentageColor = percentage >= 70 ? "success" : percentage >= 50 ? "warning" : "danger";
                                                        
                                                        <tr>
                                                            <td>@mark.AssessmentTitle</td>
                                                            <td>@mark.AssessmentType</td>
                                                            <td>Term @mark.Term</td>
                                                            <td class="text-end"><strong>@mark.MarksAwarded.ToString("F1") / @mark.MaxMark.ToString("F0")</strong></td>
                                                            <td class="text-end">
                                                                <span class="badge bg-@percentageColor">@percentage.ToString("F1")%</span>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- Interventions by Term -->
                                    @if (subjectInterventions.Count > 0)
                                    {
                                        <h6 class="mb-3">Areas of Concern</h6>
                                        
                                        @foreach (var term in new[] { 1, 2, 3, 4 })
                                        {
                                            var termInterventions = subjectInterventions
                                                .Where(i => i.Question.Assessment.Term == term)
                                                .ToList();

                                            if (termInterventions.Count > 0)
                                            {
                                                <div class="mb-3">
                                                    <h6 class="text-muted mb-2">
                                                        <small>Term @term</small>
                                                    </h6>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th>Assessment</th>
                                                                    <th>Topic</th>
                                                                    <th>Score</th>
                                                                    <th>Status</th>
                                                                    <th>Note</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var intervention in termInterventions)
                                                                {
                                                                    var badgeColor = intervention.Level == "Critical" ? "danger" :
                                                                                     intervention.Level == "Attention" ? "warning" :
                                                                                     intervention.Level == "Focus" ? "info" :
                                                                                     intervention.Level == "Minor" ? "success" : "secondary";
                                                                    
                                                                    <tr>
                                                                        <td>@intervention.Question.Assessment.Title</td>
                                                                        <td>@intervention.Topic</td>
                                                                        <td>
                                                                            <strong>@intervention.PercentageScore.ToString("F1")%</strong>
                                                                        </td>
                                                                        <td>
                                                                            <span class="badge bg-@badgeColor">
                                                                                @intervention.Level
                                                                            </span>
                                                                        </td>
                                                                        <td>
                                                                            <small>@intervention.Message</small>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted"><small>No areas of concern flagged.</small></p>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => selectedLearner = null">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "learner")]
    public int LearnerIdFromQuery { get; set; }
    
    private List<Learner> allLearners = new();
    private List<Learner> filteredLearners = new();
    private List<Subject> learnerSubjects = new();
    private List<Intervention> learnerInterventions = new();
    private Learner? selectedLearner;
    private string searchTerm = string.Empty;
    private string errorMessage = string.Empty;
    private Teacher? currentTeacher;
    private int? currentSchoolId;
    private int selectedGrade = 0;

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling(filteredLearners.Count / (double)PageSize);
    private List<Learner> PagedLearners => filteredLearners.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private void GoToPage(int page) => currentPage = page;

    // Cache for marks per subject
    private Dictionary<int, List<AssessmentMarkInfo>> assessmentMarksCache = new();
    private Dictionary<int, List<Subject>> learnerSubjectsCache = new();

    private class AssessmentMarkInfo
    {
        public string AssessmentTitle { get; set; } = string.Empty;
        public string AssessmentType { get; set; } = string.Empty;
        public int Term { get; set; }
        public decimal MarksAwarded { get; set; }
        public decimal MaxMark { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);
            var isAdmin = authState.User.IsInRole("Admin");

            if (isAdmin)
            {
                var adminUser = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);
                currentSchoolId = adminUser?.SchoolId;

                if (currentSchoolId == null)
                {
                    errorMessage = "You are not assigned to a school.";
                    return;
                }

                allLearners = await DbContext.Learners
                    .AsNoTracking()
                    .Include(l => l.User)
                    .Where(l => l.User.SchoolId == currentSchoolId)
                    .ToListAsync();
            }
            else
            {
                currentTeacher = await DbContext.Teachers
                    .AsNoTracking()
                    .Include(t => t.User)
                    .FirstOrDefaultAsync(t => t.UserId == user!.Id);

                if (currentTeacher == null)
                {
                    errorMessage = "You are not registered as a teacher.";
                    return;
                }

                currentSchoolId = currentTeacher.User?.SchoolId;

                if (currentSchoolId == null)
                {
                    errorMessage = "You are not assigned to a school.";
                    return;
                }

                allLearners = await DbContext.LearnerSubjects
                    .AsNoTracking()
                    .Where(ls => ls.Subject.TeacherId == currentTeacher.TeacherId && ls.Subject.SchoolId == currentSchoolId)
                    .Include(ls => ls.Learner)
                    .ThenInclude(l => l.User)
                    .Select(ls => ls.Learner)
                    .Distinct()
                    .ToListAsync();
            }

            filteredLearners = allLearners;

            // Pre-load subjects for all learners
            foreach (var learner in allLearners)
            {
                var subjects = await DbContext.LearnerSubjects
                    .AsNoTracking()
                    .Where(ls => ls.LearnerId == learner.LearnerId)
                    .Include(ls => ls.Subject)
                    .Select(ls => ls.Subject)
                    .ToListAsync();
                
                learnerSubjectsCache[learner.LearnerId] = subjects;
            }

            if (LearnerIdFromQuery > 0)
            {
                var learner = allLearners.FirstOrDefault(l => l.LearnerId == LearnerIdFromQuery);
                if (learner != null)
                    await ViewProfile(learner);
                else
                    errorMessage = "Learner not found or not in your school.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void OnGradeChanged()
    {
        SearchLearners();
    }

    private void SearchLearners()
    {
        filteredLearners = allLearners;

        if (selectedGrade > 0)
        {
            filteredLearners = filteredLearners
                .Where(l => l.Grade == selectedGrade)
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredLearners = filteredLearners
                .Where(l => l.User!.Fullname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        currentPage = 1;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        selectedGrade = 0;
        filteredLearners = allLearners;
        currentPage = 1;
    }

    private async Task ViewProfile(Learner learner)
    {
        try
        {
            selectedLearner = learner;

            learnerSubjects = await DbContext.LearnerSubjects
                .AsNoTracking()
                .Where(ls => ls.LearnerId == learner.LearnerId)
                .Include(ls => ls.Subject)
                .Select(ls => ls.Subject)
                .ToListAsync();

            learnerInterventions = await DbContext.Interventions
                .AsNoTracking()
                .Where(i => i.LearnerId == learner.LearnerId)
                .Include(i => i.Question)
                .ThenInclude(q => q.Assessment)
                .ThenInclude(a => a.AssessmentType)
                .OrderBy(i => i.Question.Assessment.Term)
                .ThenBy(i => i.Level)
                .ToListAsync();

            // Load marks for each subject
            assessmentMarksCache.Clear();
            foreach (var subject in learnerSubjects)
            {
                var marks = await DbContext.LearnerMarks
                    .AsNoTracking()
                    .Where(m => m.LearnerId == learner.LearnerId && m.Assessment.SubjectId == subject.SubjectId)
                    .Include(m => m.Assessment)
                    .ThenInclude(a => a.AssessmentType)
                    .Select(m => new AssessmentMarkInfo
                    {
                        AssessmentTitle = m.Assessment.Title,
                        AssessmentType = m.Assessment.AssessmentType!.Name,
                        Term = m.Assessment.Term,
                        MarksAwarded = m.MarksAwarded,
                        MaxMark = m.Assessment.MaxMark
                    })
                    .ToListAsync();

                assessmentMarksCache[subject.SubjectId] = marks;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading profile: {ex.Message}";
        }
    }
}
