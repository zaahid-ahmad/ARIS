@page "/parent/attendance/{LearnerId:int}"
@using Microsoft.AspNetCore.Authorization
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Parent")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject SchoolAuthorizationService SchoolAuth

@if (accessDenied)
{
    <div class="alert alert-danger">You do not have access to this learner's data.</div>
}
else if (subjects == null)
{
    <p>Loading...</p>
}
else
{
    <a href="/parent/dashboard">&larr; Back to my children</a>
    <h4 class="mt-2">@learnerName's Attendance</h4>

    @if (subjects.Count == 0)
    {
        <p class="text-muted">Not enrolled in any subjects yet.</p>
    }
    else
    {
        @foreach (var subject in subjects)
        {
            var attendanceRecords = allAttendanceRecords
                .Where(ar => ar.Session.SubjectId == subject.SubjectId &&
                           ar.LearnerId == LearnerId)
                .ToList();

            <div class="card mb-3">
                <div class="card-header">
                    <h5>@subject.Name (Grade @subject.Grade)</h5>
                </div>
                <div class="card-body">
                    @if (attendanceRecords.Count == 0)
                    {
                        <p class="text-muted">No attendance records yet.</p>
                    }
                    else
                    {
                        int presentCount = attendanceRecords.Count(ar => ar.Status == "Present");
                        decimal attendancePercentage = (presentCount * 100m) / attendanceRecords.Count;

                        <p><strong>Attendance Rate: @attendancePercentage.ToString("F1")%</strong> (@presentCount / @attendanceRecords.Count present)</p>

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in attendanceRecords.OrderByDescending(ar => ar.Session.Date).ThenByDescending(ar => ar.Session.Time))
                                {
                                    <tr>
                                        <td>@record.Session.Date.ToString("dd MMM yyyy")</td>
                                        <td>@record.Session.Time.ToString("HH:mm")</td>
                                        <td>
                                            <span class="badge bg-@(record.Status == "Present" ? "success" : record.Status == "Absent" ? "danger" : "warning")">
                                                @record.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int LearnerId { get; set; }

    private bool accessDenied;
    private string? learnerName;
    private List<Subject>? subjects;
    private List<AttendanceRecord> allAttendanceRecords = new();

    protected override async Task OnParametersSetAsync()
    {
        accessDenied = false;
        subjects = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (!await SchoolAuth.HasAccessToLearner(userName, LearnerId))
        {
            accessDenied = true;
            return;
        }

        var learner = await DbContext.Learners
            .AsNoTracking()
            .Include(l => l.User)
            .FirstOrDefaultAsync(l => l.LearnerId == LearnerId);

        if (learner == null)
        {
            accessDenied = true; // defense in depth — never trust the route param alone
            return;
        }

        learnerName = learner.User.Fullname;

        subjects = await DbContext.LearnerSubjects
            .AsNoTracking()
            .Where(ls => ls.LearnerId == LearnerId)
            .Include(ls => ls.Subject)
            .Select(ls => ls.Subject)
            .ToListAsync();

        // Load ALL this learner's attendance records at once
        allAttendanceRecords = await DbContext.AttendanceRecords
            .AsNoTracking()
            .Where(ar => ar.LearnerId == LearnerId)
            .Include(ar => ar.Session)
            .ToListAsync();
    }
}
