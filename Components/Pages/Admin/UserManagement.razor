@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AppDbContext DbContext
@inject SchoolAuthorizationService AuthService
@inject NavigationManager Navigation
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BulkUserImportService BulkImportService

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("admin/users/create")'>+ Add New User</button>
    <button class="btn btn-outline-primary" @onclick="ShowImportModal">Bulk Import</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (users == null)
{
    <p>Loading...</p>
}
else if (users.Count == 0)
{
    <p class="text-muted">No users in your school.</p>
}
else
{
    <div class="mb-3 mt-3 d-flex gap-2">
        <input class="form-control" placeholder="Search by name or email..."
               @bind="searchTerm" autocomplete="off" />
        <button class="btn btn-primary" @onclick="SearchUsers">Search</button>
        <button class="btn btn-secondary" @onclick="ClearSearch">Clear</button>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Class</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in PagedUsers)
            {
                var learner = learnerByUserId.GetValueOrDefault(user.Id);
                var parent = parentByUserId.GetValueOrDefault(user.Id);
                <tr>
                    <td>@user.Fullname</td>
                    <td>@user.Email</td>
                    <td>@(userRoles.TryGetValue(user.Id, out var role) ? role : "-")</td>
                    <td>@(learner != null ? learner.ClassName : "-")</td>
                    <td>@(user.IsActive ? "Yes" : "No")</td>
                    <td>
                        @if (learner != null)
                        {
                            <button class="btn btn-info btn-sm ms-1"
                                    @onclick="() => ShowEditClass(learner.LearnerId, user.Fullname, learner.Grade, learner.ClassName)">
                                Edit Class
                            </button>
                        }
                        @if (parent != null)
                        {
                            <button class="btn btn-outline-info btn-sm ms-1"
                                    @onclick="() => ShowEditChildren(parent.ParentId, user.Fullname)">
                                Edit Children
                            </button>
                        }
                        @if (user.IsActive)
                        {
                            <button class="btn btn-warning btn-sm ms-1"
                                    @onclick="() => ShowResetPassword(user.Id, user.Fullname, user.Email ?? string.Empty)"
                                    disabled="@(user.Id == currentUserId)">
                                Reset Password
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => ShowDeactivateConfirm(user)"
                                    disabled="@(user.Id == currentUserId)">
                                Deactivate
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => ReactivateUser(user)">
                                Reactivate
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
}

<!-- DELETE/DEACTIVATE CONFIRMATION MODAL -->
@if (userToDeactivate != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Deactivate</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to deactivate <strong>@userToDeactivate.Fullname</strong>?</p>
                    <p class="text-warning">They will no longer be able to log in.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDeactivate">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeactivate">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- RESET PASSWORD MODAL -->
@if (userToResetId != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password for @userToResetName</h5>
                    <button type="button" class="btn-close" @onclick="CancelReset"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(resetMessage))
                    {
                        <div class="alert @(resetMessage.StartsWith("Password reset") ? "alert-success" : "alert-danger")">@resetMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">New Password <span class="text-danger">*</span></label>
                        <div class="d-flex gap-2">
                            <input type="@(revealNewPassword ? "text" : "password")"
                                   class="form-control @(passwordResetError != null ? "is-invalid" : "")"
                                   @bind="newPassword" @oninput="@(() => passwordResetError = null)"
                                   autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="GenerateResetPassword">
                                Generate
                            </button>
                        </div>
                        @if (passwordResetError != null)
                        {
                            <div class="invalid-feedback d-block">@passwordResetError</div>
                        }
                        <div class="form-check mt-1">
                            <input type="checkbox" class="form-check-input" id="revealNewPassword" @bind="revealNewPassword" />
                            <label class="form-check-label" for="revealNewPassword">Show password</label>
                        </div>
                        <small class="text-muted">Minimum 8 characters, must include at least one digit.</small>
                    </div>
                    <small class="text-muted">Username/Email: @userToResetEmail</small>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelReset">Cancel</button>
                    <button class="btn btn-warning" @onclick="ConfirmResetPassword">Reset Password</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- EDIT CLASS MODAL -->
@if (learnerToEditId != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Class for @learnerToEditName (Grade @learnerToEditGrade)</h5>
                    <button type="button" class="btn-close" @onclick="CancelEditClass"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Class <span class="text-danger">*</span></label>
                        <input class="form-control @(classNameEditError != null ? "is-invalid" : "")"
                               @bind="editClassName" @oninput="@(() => classNameEditError = null)"
                               maxlength="20" placeholder="e.g. @(learnerToEditGrade)A" />
                        @if (classNameEditError != null)
                        {
                            <div class="invalid-feedback">@classNameEditError</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelEditClass">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmEditClass">Save</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- EDIT CHILDREN MODAL -->
@if (parentToEditId != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Linked Children for @parentToEditName</h5>
                    <button type="button" class="btn-close" @onclick="CancelEditChildren"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(editChildrenError))
                    {
                        <div class="alert alert-danger">@editChildrenError</div>
                    }

                    <h6>Currently Linked</h6>
                    @if (isLoadingChildren)
                    {
                        <p><em>Loading...</em></p>
                    }
                    else if (linkedChildren.Count == 0)
                    {
                        <p class="text-muted">No children linked yet.</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var child in linkedChildren)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @child.User.Fullname (Grade @child.Grade — @child.ClassName)
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RemoveChild(child.LearnerId)"
                                            disabled="@isMutatingChildren">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    <hr />
                    <h6>Add a Child</h6>
                    <div class="d-flex gap-2 mb-2">
                        <input class="form-control" placeholder="Search by learner name..."
                               @bind="childSearchTerm" autocomplete="off" />
                        <button class="btn btn-primary" @onclick="SearchAvailableChildren" disabled="@isSearchingChildren">
                            Search
                        </button>
                    </div>
                    @if (isSearchingChildren)
                    {
                        <p><em>Searching...</em></p>
                    }
                    else if (childSearchResults != null)
                    {
                        @if (childSearchResults.Count == 0)
                        {
                            <p class="text-muted">No matching, unlinked learners found in your school.</p>
                        }
                        else
                        {
                            <ul class="list-group">
                                @foreach (var candidate in childSearchResults)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        @candidate.User.Fullname (Grade @candidate.Grade — @candidate.ClassName)
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="() => AddChild(candidate.LearnerId)"
                                                disabled="@isMutatingChildren">
                                            Add
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelEditChildren">Done</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- BULK IMPORT MODAL -->
@if (showImportModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Bulk Import Users</h5>
                    <button type="button" class="btn-close" @onclick="CloseImportModal"></button>
                </div>
                <div class="modal-body">
                    <p>Upload a CSV or Excel (.xlsx) file with columns: <code>FullName, Email, Role, Grade, ClassName, Password</code>.</p>
                    <ul class="small text-muted">
                        <li><strong>Role</strong> must be <code>Teacher</code> or <code>Learner</code>.</li>
                        <li><strong>Grade</strong> and <strong>ClassName</strong> apply to learners only (e.g. Grade 10, Class 10A).</li>
                        <li><strong>Password</strong> is optional — leave blank to auto-generate one (shown in the results below).</li>
                    </ul>
                    <a class="btn btn-link p-0 mb-3" href="/templates/bulk-user-import-template.csv" download>
                        Download CSV template
                    </a>

                    <InputFile OnChange="HandleFileSelected" accept=".csv,.xlsx,.xls" class="form-control" disabled="@isImporting" />

                    @if (!string.IsNullOrEmpty(importError))
                    {
                        <div class="alert alert-danger mt-3">@importError</div>
                    }

                    @if (isImporting)
                    {
                        <p class="mt-3"><em>Importing...</em></p>
                    }

                    @if (importResults != null)
                    {
                        <hr />
                        <h6>
                            Results: @importResults.Count(r => r.Success) succeeded,
                            @importResults.Count(r => !r.Success) failed
                        </h6>
                        @if (credentialsDownloadUrl != null)
                        {
                            <div class="alert alert-warning py-2">
                                Generated passwords are shown only once and cannot be recovered later.
                                <a class="btn btn-warning btn-sm ms-2" href="@credentialsDownloadUrl" download="import-credentials.csv">
                                    Download credentials (CSV)
                                </a>
                            </div>
                        }
                        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var result in importResults)
                                    {
                                        <tr>
                                            <td>@result.RowNumber</td>
                                            <td>@result.FullName</td>
                                            <td>@result.Email</td>
                                            <td>@result.Role</td>
                                            <td>
                                                @if (result.Success)
                                                {
                                                    <span class="badge bg-success">Created</span>
                                                    @if (result.GeneratedPassword != null)
                                                    {
                                                        <div><small>Password: <code>@result.GeneratedPassword</code></small></div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                    <div><small class="text-danger">@result.ErrorMessage</small></div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseImportModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<User>? users;
    private Dictionary<string, string> userRoles = new();
    private Dictionary<string, Learner> learnerByUserId = new();
    private Dictionary<string, Parent> parentByUserId = new();
    private int? parentToEditId;
    private string parentToEditName = string.Empty;
    private bool isLoadingChildren;
    private bool isSearchingChildren;
    private bool isMutatingChildren;
    private string? editChildrenError;
    private List<Learner> linkedChildren = new();
    private string childSearchTerm = string.Empty;
    private List<Learner>? childSearchResults;
    private User? userToDeactivate;
    private string? userToResetId;
    private string userToResetName = string.Empty;
    private string userToResetEmail = string.Empty;
    private string newPassword = string.Empty;
    private string searchTerm = string.Empty;
    private string resetMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string? passwordResetError;
    private bool revealNewPassword = false;
    private int? currentSchoolId;
    private string? currentUserId;
    private int? learnerToEditId;
    private string learnerToEditName = string.Empty;
    private int learnerToEditGrade;
    private string editClassName = string.Empty;
    private string? classNameEditError;

    private bool showImportModal = false;
    private bool isImporting = false;
    private string? importError;
    private List<ImportRowResult>? importResults;
    private string? credentialsDownloadUrl;

    private IEnumerable<User> FilteredUsers => users?
        .Where(u => string.IsNullOrWhiteSpace(searchTerm) ||
            u.Fullname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            u.Email!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<User>();

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling(FilteredUsers.Count() / (double)PageSize);
    private IEnumerable<User> PagedUsers => FilteredUsers.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private void GoToPage(int page) => currentPage = page;

    protected override async Task OnInitializedAsync()
    {
        // Get current user from authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(userName))
        {
            errorMessage = "You must be logged in.";
            return;
        }

        // Get current admin's school
        var currentUser = await UserManager.FindByNameAsync(userName);
        currentSchoolId = currentUser?.SchoolId;
        currentUserId = currentUser?.Id;

        if (currentSchoolId == null)
        {
            errorMessage = "You are not assigned to a school.";
            return;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            // Exclude admins from the list using the Identity UserRoles join
            var adminRole = await DbContext.Roles.FirstOrDefaultAsync(r => r.Name == "Admin");
            var adminUserIds = adminRole != null
                ? await DbContext.UserRoles
                    .Where(ur => ur.RoleId == adminRole.Id)
                    .Select(ur => ur.UserId)
                    .ToListAsync()
                : new List<string>();

            users = await DbContext.Users
                .Where(u => u.SchoolId == currentSchoolId && !adminUserIds.Contains(u.Id))
                .ToListAsync();

            // Batch-load roles for display
            var userIds = users.Select(u => u.Id).ToList();
            var allRoles = await DbContext.Roles.ToListAsync();
            var userRoleRecords = await DbContext.UserRoles
                .Where(ur => userIds.Contains(ur.UserId))
                .ToListAsync();

            userRoles = userRoleRecords.ToDictionary(
                ur => ur.UserId,
                ur => allRoles.FirstOrDefault(r => r.Id == ur.RoleId)?.Name ?? "-"
            );

            learnerByUserId = await DbContext.Learners
                .Where(l => userIds.Contains(l.UserId))
                .ToDictionaryAsync(l => l.UserId);

            parentByUserId = await DbContext.Parents
                .Where(p => userIds.Contains(p.UserId))
                .ToDictionaryAsync(p => p.UserId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
    }

    private void ShowDeactivateConfirm(User user)
    {
        userToDeactivate = user;
    }

    private async Task ConfirmDeactivate()
    {
        if (userToDeactivate != null)
        {
            try
            {
                // Get current user from auth state
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var currentUserName = authState.User.Identity?.Name;
                var currentUser = await UserManager.FindByNameAsync(currentUserName!);
            
                // Check if admin is trying to deactivate themselves
                if (currentUser?.Id == userToDeactivate.Id)
                {
                    errorMessage = "You cannot deactivate your own account.";
                    userToDeactivate = null;
                    return;
                }

                userToDeactivate.IsActive = false;
                await UserManager.UpdateAsync(userToDeactivate);
                successMessage = $"{userToDeactivate.Fullname} has been deactivated.";
                userToDeactivate = null;
                await LoadUsers();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error: {ex.Message}";
            }
        }
    }

    private void CancelDeactivate()
    {
        userToDeactivate = null;
    }

    private async Task ReactivateUser(User user)
    {
        try
        {
            user.IsActive = true;
            await UserManager.UpdateAsync(user);
            successMessage = $"{user.Fullname} has been reactivated.";
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void ShowResetPassword(string userId, string fullname, string email)
    {
        userToResetId = userId;
        userToResetName = fullname;
        userToResetEmail = email;
        newPassword = string.Empty;
        resetMessage = string.Empty;
        passwordResetError = null;
        revealNewPassword = false;
    }

    private void GenerateResetPassword()
    {
        newPassword = PasswordGenerator.Generate();
        revealNewPassword = true;
        passwordResetError = null;
    }

    private async Task ConfirmResetPassword()
    {
        if (userToResetId == null) return;

        passwordResetError = null;
        if (string.IsNullOrWhiteSpace(newPassword))
        { passwordResetError = "Password is required."; return; }
        if (newPassword.Length < 8)
        { passwordResetError = "Password must be at least 8 characters."; return; }
        if (!newPassword.Any(char.IsDigit))
        { passwordResetError = "Password must contain at least one digit."; return; }

        try
        {
            var user = await UserManager.FindByIdAsync(userToResetId);
            if (user == null)
            { resetMessage = "User no longer exists."; return; }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var result = await UserManager.ResetPasswordAsync(user, token, newPassword);

            if (result.Succeeded)
            {
                resetMessage = "Password reset successfully!";
                userToResetId = null;
                newPassword = string.Empty;
            }
            else
            {
                resetMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            resetMessage = $"Error: {ex.Message}";
        }
    }

    private void CancelReset()
    {
        userToResetId = null;
        userToResetName = string.Empty;
        userToResetEmail = string.Empty;
        resetMessage = string.Empty;
        newPassword = string.Empty;
        passwordResetError = null;
        revealNewPassword = false;
    }

    private void ShowEditClass(int learnerId, string fullname, int grade, string currentClassName)
    {
        learnerToEditId = learnerId;
        learnerToEditName = fullname;
        learnerToEditGrade = grade;
        editClassName = currentClassName;
        classNameEditError = null;
    }

    private static bool IsValidClassName(string value, int grade)
    {
        var gradeDigits = grade.ToString();
        var v = value.Trim().ToUpperInvariant();
        return v.Length == gradeDigits.Length + 1
            && v.StartsWith(gradeDigits, StringComparison.Ordinal)
            && v[^1] >= 'A' && v[^1] <= 'Z';
    }

    private async Task ConfirmEditClass()
    {
        if (learnerToEditId == null) return;

        if (string.IsNullOrWhiteSpace(editClassName))
        { classNameEditError = "Class is required."; return; }

        if (!IsValidClassName(editClassName, learnerToEditGrade))
        { classNameEditError = $"Class must be grade {learnerToEditGrade} followed by a single letter, e.g. {learnerToEditGrade}A."; return; }

        try
        {
            var learner = await DbContext.Learners.FindAsync(learnerToEditId);
            if (learner == null)
            { classNameEditError = "Learner no longer exists."; return; }

            learner.ClassName = editClassName.Trim().ToUpperInvariant();
            await DbContext.SaveChangesAsync();

            successMessage = $"Class updated to {learner.ClassName}.";
            CancelEditClass();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            classNameEditError = $"Error: {ex.Message}";
        }
    }

    private void CancelEditClass()
    {
        learnerToEditId = null;
        learnerToEditName = string.Empty;
        learnerToEditGrade = 0;
        editClassName = string.Empty;
        classNameEditError = null;
    }

    private async Task ShowEditChildren(int parentId, string fullname)
    {
        // Same reentrancy guard as isImporting/isLoadingRisk/isLoadingProfile elsewhere in
        // this app: a double-click fires this handler twice before the first await resolves.
        if (isLoadingChildren) return;

        parentToEditId = parentId;
        parentToEditName = fullname;
        editChildrenError = null;
        childSearchTerm = string.Empty;
        childSearchResults = null;
        isLoadingChildren = true;
        StateHasChanged();

        try
        {
            linkedChildren = await DbContext.ParentLearners
                .AsNoTracking()
                .Where(pl => pl.ParentId == parentId)
                .Include(pl => pl.Learner).ThenInclude(l => l.User)
                .Select(pl => pl.Learner)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            editChildrenError = $"Error loading linked children: {ex.Message}";
            linkedChildren = new();
        }
        finally
        {
            isLoadingChildren = false;
        }
    }

    private async Task SearchAvailableChildren()
    {
        if (isSearchingChildren || parentToEditId == null || currentSchoolId == null) return;

        isSearchingChildren = true;
        editChildrenError = null;
        StateHasChanged();

        try
        {
            var linkedIds = linkedChildren.Select(c => c.LearnerId).ToHashSet();

            var query = DbContext.Learners
                .AsNoTracking()
                .Include(l => l.User)
                .Where(l => l.User.SchoolId == currentSchoolId && !linkedIds.Contains(l.LearnerId));

            if (!string.IsNullOrWhiteSpace(childSearchTerm))
            {
                var term = childSearchTerm.Trim();
                query = query.Where(l => l.User.Fullname.Contains(term));
            }

            childSearchResults = await query.OrderBy(l => l.User.Fullname).Take(25).ToListAsync();
        }
        catch (Exception ex)
        {
            editChildrenError = $"Error searching learners: {ex.Message}";
            childSearchResults = new();
        }
        finally
        {
            isSearchingChildren = false;
        }
    }

    private async Task AddChild(int learnerId)
    {
        if (isMutatingChildren || parentToEditId == null) return;
        isMutatingChildren = true;
        editChildrenError = null;
        StateHasChanged();

        try
        {
            // Re-check server-side, not just trust the on-screen search results — those could
            // be stale if a second admin tab (or a second admin) changed something in between.
            var learner = await DbContext.Learners
                .Include(l => l.User)
                .FirstOrDefaultAsync(l => l.LearnerId == learnerId);

            if (learner == null || learner.User.SchoolId != currentSchoolId)
            {
                editChildrenError = "That learner is no longer available to link.";
                return;
            }

            var alreadyLinked = await DbContext.ParentLearners
                .AnyAsync(pl => pl.ParentId == parentToEditId && pl.LearnerId == learnerId);

            if (alreadyLinked)
            {
                editChildrenError = $"{learner.User.Fullname} is already linked.";
            }
            else
            {
                // A single insert + single SaveChangesAsync is already atomic — no explicit
                // transaction needed here, unlike the multi-entity Identity+DB flow in account
                // creation.
                DbContext.ParentLearners.Add(new ParentLearner
                {
                    ParentId = parentToEditId.Value,
                    LearnerId = learnerId,
                    CreatedDate = DateTime.UtcNow
                });
                await DbContext.SaveChangesAsync();
                successMessage = $"{learner.User.Fullname} linked to {parentToEditName}.";
            }

            // Reload the linked list and (if a search was already showing) the search results
            // together, so the UI never shows the same learner in both lists at once.
            await ShowEditChildren(parentToEditId.Value, parentToEditName);
            if (childSearchResults != null)
                await SearchAvailableChildren();
        }
        catch (Exception ex)
        {
            editChildrenError = $"Error linking learner: {ex.Message}";
        }
        finally
        {
            isMutatingChildren = false;
        }
    }

    private async Task RemoveChild(int learnerId)
    {
        if (isMutatingChildren || parentToEditId == null) return;
        isMutatingChildren = true;
        editChildrenError = null;
        StateHasChanged();

        try
        {
            var link = await DbContext.ParentLearners
                .FirstOrDefaultAsync(pl => pl.ParentId == parentToEditId && pl.LearnerId == learnerId);

            if (link == null)
            {
                editChildrenError = "That link no longer exists.";
            }
            else
            {
                DbContext.ParentLearners.Remove(link);
                await DbContext.SaveChangesAsync();
                successMessage = "Child unlinked.";
            }

            await ShowEditChildren(parentToEditId.Value, parentToEditName);
            if (childSearchResults != null)
                await SearchAvailableChildren();
        }
        catch (Exception ex)
        {
            editChildrenError = $"Error unlinking learner: {ex.Message}";
        }
        finally
        {
            isMutatingChildren = false;
        }
    }

    private void CancelEditChildren()
    {
        parentToEditId = null;
        parentToEditName = string.Empty;
        editChildrenError = null;
        linkedChildren = new();
        childSearchTerm = string.Empty;
        childSearchResults = null;
    }

    private void SearchUsers()
    {
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        StateHasChanged();
    }

    private void ShowImportModal()
    {
        showImportModal = true;
        importError = null;
        importResults = null;
        credentialsDownloadUrl = null;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
        importError = null;
        importResults = null;
        credentialsDownloadUrl = null;
        isImporting = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // Guard against overlapping runs — without this, two concurrent calls could use
        // the same scoped DbContext for simultaneous async operations (EF Core's DbContext
        // is not thread-safe for concurrent use) and clobber importResults/successMessage,
        // the same class of bug fixed in AtRisk.razor and LearnerProfiles.razor.
        if (isImporting) return;

        importError = null;
        importResults = null;
        credentialsDownloadUrl = null;

        if (currentSchoolId == null)
        {
            importError = "You are not assigned to a school.";
            return;
        }

        var file = e.File;
        var extension = Path.GetExtension(file.Name);

        if (extension is not (".csv" or ".xlsx" or ".xls"))
        {
            importError = "Unsupported file type. Please upload a .csv or .xlsx file.";
            return;
        }

        isImporting = true;
        StateHasChanged();

        try
        {
            const long maxFileSize = 5 * 1024 * 1024; // 5 MB
            using var memoryStream = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxFileSize))
            {
                await stream.CopyToAsync(memoryStream);
            }
            memoryStream.Position = 0;

            var rows = BulkImportService.ParseFile(memoryStream, extension);
            if (rows.Count == 0)
            {
                importError = "No data rows found in the file.";
                return;
            }

            importResults = await BulkImportService.ImportAsync(rows, currentSchoolId.Value);
            successMessage = $"Import complete: {importResults.Count(r => r.Success)} of {importResults.Count} user(s) created.";
            credentialsDownloadUrl = BuildCredentialsDownloadUrl(importResults);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            importError = $"Error processing file: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private static string? BuildCredentialsDownloadUrl(List<ImportRowResult> results)
    {
        var withPasswords = results.Where(r => r.Success && r.GeneratedPassword != null).ToList();
        if (withPasswords.Count == 0) return null;

        var lines = new List<string> { "FullName,Email,Role,Password" };
        lines.AddRange(withPasswords.Select(r =>
            string.Join(",", CsvField(r.FullName), CsvField(r.Email), CsvField(r.Role), CsvField(r.GeneratedPassword!))));

        var bytes = System.Text.Encoding.UTF8.GetBytes(string.Join("\r\n", lines));
        return $"data:text/csv;base64,{Convert.ToBase64String(bytes)}";
    }

    private static string CsvField(string value)
    {
        if (value.IndexOfAny(new[] { ',', '"', '\n', '\r' }) < 0) return value;
        return $"\"{value.Replace("\"", "\"\"")}\"";
    }
}