@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ARIS1.Services.RiskOverviewService RiskOverviewSvc
@inject ILogger<Dashboard> Logger
@implements IDisposable
@rendermode InteractiveServer

<p>Welcome, @currentUser?.Fullname</p>

@if (isLoadingRisk)
{
    <ProgressPanel Compact="true" Message="Checking learners..." SlowHint="Still working. Large schools can take a while." />
}
else if (riskTimedOut)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center"
         style="cursor: pointer;"
         @onclick='() => Navigation.NavigateTo("/admin/risk-overview")'>
        <span>The school-wide risk summary is taking longer than expected.</span>
        <span class="badge bg-light text-dark">View Risk Overview →</span>
    </div>
}
else if (riskTotal != null)
{
    @if (riskTotal.AtRisk == 0)
    {
        <div class="alert alert-success">No at-risk learners across the school.</div>
    }
    else
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center"
             style="cursor: pointer;"
             @onclick='() => Navigation.NavigateTo("/admin/risk-overview")'>
            <span>
                <strong>⚠ @riskTotal.AtRisk of @riskTotal.Total learner@(riskTotal.Total == 1 ? "" : "s") (@riskTotal.AtRiskPercent.ToString("0.#")%) @(riskTotal.AtRisk == 1 ? "is" : "are") at risk</strong>
                across the school.
                <small class="ms-1 opacity-75">Data as of @riskAsOf</small>
            </span>
            <span class="badge bg-light text-danger">View Risk Overview →</span>
        </div>
    }
}

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Manage Users</h5>
                <p class="card-text">Add and manage teachers and learners.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/admin/users")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Manage Subjects</h5>
                <p class="card-text">Set up subjects and assign teachers.</p>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/admin/subjects")'>Go</button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Enrollment</h5>
                <p class="card-text">Enroll learners into subjects.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/admin/enrollment")'>
                    Go
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Learner Profiles</h5>
                <p class="card-text">View learner interventions and progress.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/teacher/learnerprofiles")'>
                    Go
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Risk Overview</h5>
                <p class="card-text">School-wide risk, by grade and subject. Export a PDF report.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/admin/risk-overview")'>
                    Go
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Attendance</h5>
                <p class="card-text">Review and delete attendance sessions.</p>
                <button class="btn btn-light"
                        @onclick='() => Navigation.NavigateTo("/admin/attendance")'>
                    Go
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private User? currentUser;
    private ARIS1.Services.RiskAggregate? riskTotal;
    private string riskAsOf = string.Empty;
    private bool isLoadingRisk = true;
    private bool riskTimedOut;
    private bool riskStarted;
    private bool ready; // set once OnInitializedAsync has identified the admin
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
            currentUser = await UserManager.FindByNameAsync(user.Identity.Name!);
        ready = true;
    }

    // The at-risk banner needs a school-wide calculation, so it loads AFTER the dashboard has painted (and only once,
    // on the live circuit — OnAfterRender doesn't run during prerender). Signing in never waits on it.
    // Gate on readiness, NOT on `firstRender`: Blazor renders at OnInitializedAsync's first incomplete await, so the one
    // render with firstRender == true can come before currentUser is known and the banner would silently never load.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (riskStarted || !ready) return;
        riskStarted = true;

        // The banner must never spin forever: past the time limit it says so and points to the Risk Overview instead.
        using var limit = CancellationTokenSource.CreateLinkedTokenSource(cts.Token);
        limit.CancelAfter(RiskOverviewSvc.LoadTimeLimit);

        try
        {
            if (currentUser?.SchoolId is int schoolId)
            {
                var overview = await RiskOverviewSvc.BuildAsync(schoolId, ct: limit.Token);
                riskTotal = overview.Total;
                riskAsOf = overview.AsOfUtc.ToLocalTime().ToString("HH:mm");
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return; // left the page; nothing to show
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin dashboard risk banner gave up after {Seconds} s", RiskOverviewSvc.LoadTimeLimit.TotalSeconds);
            riskTimedOut = true;
        }
        catch (Exception ex)
        {
            // The banner is a convenience; a failure must not break the dashboard itself, but it must be findable.
            Logger.LogWarning(ex, "Admin dashboard risk banner failed to load");
            riskTotal = null;
        }

        isLoadingRisk = false;
        StateHasChanged();
    }

    public void Dispose() => cts.Cancel();

    private void Logout()
    {
        Navigation.NavigateTo("/Account/Logout", forceLoad: true);
    }
}