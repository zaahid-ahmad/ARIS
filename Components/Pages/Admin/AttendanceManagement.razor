@page "/admin/attendance"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row mb-3">
    <div class="col-md-2">
        <label>Filter by Grade</label>
        <select class="form-control" value="@filterGrade" @onchange="OnGradeChanged">
            <option value="0">All Grades</option>
            <option value="10">Grade 10</option>
            <option value="11">Grade 11</option>
            <option value="12">Grade 12</option>
        </select>
    </div>
    <div class="col-md-3">
        <label>Filter by Subject</label>
        <select class="form-control" @bind="filterSubjectId" @bind:after="OnFilterChanged">
            <option value="0">All Subjects</option>
            @foreach (var subject in subjectsForGrade)
            {
                <option value="@subject.SubjectId">@subject.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label>From</label>
        <input type="date" class="form-control" @bind="filterFrom" @bind:after="OnFilterChanged" />
    </div>
    <div class="col-md-2">
        <label>To</label>
        <input type="date" class="form-control" @bind="filterTo" @bind:after="OnFilterChanged" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button class="btn btn-outline-secondary" @onclick="ClearDateFilter">Clear</button>
    </div>
</div>

@if (isLoading)
{
    <p class="text-muted">Loading...</p>
}
else if (pageRows.Count == 0)
{
    <p class="text-muted">No attendance sessions found.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Subject</th>
                <th>Teacher</th>
                <th>Records</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in pageRows)
            {
                var isExpanded = expandedSessionIds.Contains(row.SessionId);
                var isLoadingThis = loadingSessionIds.Contains(row.SessionId);
                var records = expandedRecordsCache.GetValueOrDefault(row.SessionId, new List<RecordDetailVm>());

                <tr>
                    <td>@row.Date.ToString("dd MMM yyyy")</td>
                    <td>@row.Time.ToString("HH:mm")</td>
                    <td>@row.SubjectName</td>
                    <td>@row.TeacherName</td>
                    <td>@row.RecordCount</td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-primary me-1"
                                @onclick="() => ToggleExpand(row.SessionId)">
                            @(isExpanded ? "Hide" : "View")
                        </button>
                        @if (confirmDeleteSessionId == row.SessionId)
                        {
                            <span class="me-2 text-danger fw-bold">Delete this session and all its records?</span>
                            <button class="btn btn-sm btn-danger me-1" @onclick="() => DeleteSession(row.SessionId)">Yes, Delete</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelDelete">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteSessionId = row.SessionId">Delete</button>
                        }
                    </td>
                </tr>

                @if (isExpanded)
                {
                    <tr class="table-light">
                        <td colspan="6" class="ps-4">
                            @if (isLoadingThis)
                            {
                                <p class="text-muted mb-0">Loading...</p>
                            }
                            else if (records.Count == 0)
                            {
                                <p class="text-muted mb-0">No records in this session.</p>
                            }
                            else
                            {
                                var present = records.Count(r => r.Status == "Present");
                                var total = records.Count;
                                <p class="mb-2">
                                    <strong>Present: @present / @total</strong>
                                </p>
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Learner</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in records)
                                        {
                                            <tr>
                                                <td>@record.LearnerName</td>
                                                <td>
                                                    <span class="badge bg-@StatusColor(record.Status)">
                                                        @record.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
}

@code {
    private List<Subject> subjects = new();
    private List<Subject> subjectsForGrade = new();
    private List<SessionRowVm> pageRows = new();
    private HashSet<int> expandedSessionIds = new();
    private HashSet<int> loadingSessionIds = new();
    private Dictionary<int, List<RecordDetailVm>> expandedRecordsCache = new();
    private int filterGrade = 0;
    private int filterSubjectId = 0;
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int? confirmDeleteSessionId;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private int? schoolId;
    private bool isLoading = true;

    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalFilteredCount;
    private int totalPages => (int)Math.Ceiling(totalFilteredCount / (double)PageSize);

    private class SessionRowVm
    {
        public int SessionId { get; set; }
        public DateTime Date { get; set; }
        public TimeOnly Time { get; set; }
        public string SubjectName { get; set; } = string.Empty;
        public string TeacherName { get; set; } = string.Empty;
        public int RecordCount { get; set; }
    }

    private class RecordDetailVm
    {
        public string LearnerName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);
            schoolId = user?.SchoolId;

            if (schoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                return;
            }

            subjects = await DbContext.Subjects
                .AsNoTracking()
                .Where(s => s.SchoolId == schoolId)
                .OrderBy(s => s.Grade).ThenBy(s => s.Name)
                .ToListAsync();

            subjectsForGrade = subjects;

            await LoadSessions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    // Filtering, ordering, and paging all happen in SQL — the query only ever pulls back the
    // current page's rows (plus a scalar RecordCount per row, translated to a COUNT subquery,
    // no AttendanceRecord entities materialized). Previously this loaded every session for the
    // whole school — Riverside alone has 420 sessions / ~24,700 records — with the full
    // AttendanceRecords→Learner→User graph eagerly included, on every page load and every
    // filter change, then filtered and paged in memory. That's what made the page slow to open
    // and slow to filter.
    private async Task LoadSessions()
    {
        if (schoolId == null) return;

        isLoading = true;
        try
        {
            var subjectIds = subjects.Select(s => s.SubjectId).ToList();

            var query = DbContext.AttendanceSessions
                .AsNoTracking()
                .Where(s => subjectIds.Contains(s.SubjectId))
                .Where(s => filterGrade == 0 || s.Subject.Grade == filterGrade)
                .Where(s => filterSubjectId == 0 || s.SubjectId == filterSubjectId)
                .Where(s => filterFrom == null || s.Date.Date >= filterFrom.Value.Date)
                .Where(s => filterTo == null || s.Date.Date <= filterTo.Value.Date);

            totalFilteredCount = await query.CountAsync();

            pageRows = await query
                .OrderByDescending(s => s.Date)
                .ThenByDescending(s => s.Time)
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .Select(s => new SessionRowVm
                {
                    SessionId = s.SessionId,
                    Date = s.Date,
                    Time = s.Time,
                    SubjectName = s.Subject.Name,
                    TeacherName = s.Teacher.User.Fullname,
                    RecordCount = s.AttendanceRecords.Count
                })
                .ToListAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearDateFilter()
    {
        filterFrom = null;
        filterTo = null;
        await OnFilterChanged();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadSessions();
    }

    private async Task OnGradeChanged(ChangeEventArgs e)
    {
        filterGrade = int.TryParse(e.Value?.ToString(), out var g) ? g : 0;
        filterSubjectId = 0;
        subjectsForGrade = filterGrade == 0
            ? subjects
            : subjects.Where(s => s.Grade == filterGrade).ToList();
        await OnFilterChanged();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadSessions();
    }

    // Lazily loads one session's records (with Learner/User) only when it's actually expanded,
    // cached after the first load so re-toggling doesn't re-query. Several sessions can be
    // expanded at once, matching the original behavior.
    private async Task ToggleExpand(int sessionId)
    {
        if (!expandedSessionIds.Add(sessionId))
        {
            expandedSessionIds.Remove(sessionId);
            return;
        }

        if (expandedRecordsCache.ContainsKey(sessionId))
            return;

        loadingSessionIds.Add(sessionId);
        try
        {
            expandedRecordsCache[sessionId] = await DbContext.AttendanceRecords
                .AsNoTracking()
                .Where(r => r.SessionId == sessionId)
                .Include(r => r.Learner).ThenInclude(l => l.User)
                .OrderBy(r => r.Learner.User.Fullname)
                .Select(r => new RecordDetailVm
                {
                    LearnerName = r.Learner.User.Fullname,
                    Status = r.Status
                })
                .ToListAsync();
        }
        finally
        {
            loadingSessionIds.Remove(sessionId);
        }
    }

    private async Task DeleteSession(int sessionId)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        await using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            var records = await DbContext.AttendanceRecords
                .Where(r => r.SessionId == sessionId)
                .ToListAsync();

            DbContext.AttendanceRecords.RemoveRange(records);
            await DbContext.SaveChangesAsync();

            var session = await DbContext.AttendanceSessions.FindAsync(sessionId);
            if (session != null)
            {
                DbContext.AttendanceSessions.Remove(session);
                await DbContext.SaveChangesAsync();
            }

            await transaction.CommitAsync();
            successMessage = "Session deleted successfully.";
            confirmDeleteSessionId = null;
            expandedSessionIds.Remove(sessionId);
            expandedRecordsCache.Remove(sessionId);
            if (currentPage > 1 && pageRows.Count == 1) currentPage--; // was the only row on this page
            await LoadSessions();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            errorMessage = $"Error deleting session: {ex.Message}";
            confirmDeleteSessionId = null;
        }
    }

    private void CancelDelete()
    {
        confirmDeleteSessionId = null;
    }

    private static string StatusColor(string status) => status switch
    {
        "Present" => "success",
        "Absent"  => "danger",
        "Late"    => "warning",
        "Excused" => "secondary",
        _         => "light"
    };
}
