    private void DeleteAssessmentType(AssessmentType type)
    {
        assessmentTypeToDelete = type;
    }

    private async Task ConfirmDeleteAssessmentType()
    {
        if (assessmentTypeToDelete == null) return;

        try
        {
            var typeToDelete = await DbContext.AssessmentTypes.FindAsync(assessmentTypeToDelete.AssessmentTypeId);
            if (typeToDelete != null)
            {
                var weightingNodes = await DbContext.WeightingNodes
                    .Where(wn => wn.AssessmentTypeId == assessmentTypeToDelete.AssessmentTypeId)
                    .ToListAsync();
                DbContext.WeightingNodes.RemoveRange(weightingNodes);

                var relatedAssessments = await DbContext.Assessments
                    .Where(a => a.AssessmentTypeId == assessmentTypeToDelete.AssessmentTypeId)
                    .ToListAsync();

                foreach (var assessment in relatedAssessments)
                {
                    var questions = await DbContext.AssessmentQuestions
                        .Where(q => q.AssessmentId == assessment.AssessmentId)
                        .ToListAsync();

                    foreach (var question in questions)
                    {
                        var interventions = await DbContext.Interventions.Where(i => i.QuestionId == question.QuestionId).ToListAsync();
                        DbContext.Interventions.RemoveRange(interventions);

                        var questionMarks = await DbContext.LearnerQuestionMarks.Where(m => m.QuestionId == question.QuestionId).ToListAsync();
                        DbContext.LearnerQuestionMarks.RemoveRange(questionMarks);
                    }

                    DbContext.AssessmentQuestions.RemoveRange(questions);
                    var marks = await DbContext.LearnerMarks.Where(m => m.AssessmentId == assessment.AssessmentId).ToListAsync();
                    DbContext.LearnerMarks.RemoveRange(marks);
                }

                DbContext.Assessments.RemoveRange(relatedAssessments);
                DbContext.AssessmentTypes.Remove(typeToDelete);
                await DbContext.SaveChangesAsync();
            
                assessmentTypeSuccess = "Type deleted!";
                assessmentTypeToDelete = null;
            
                await LoadAssessmentTypes();
                await LoadAssessments();
            
                weightingStructure = null;
                await LoadWeightingStructure();
            }
        }
        catch (Exception ex)
        {
            assessmentTypeError = $"Error: {ex.Message}";
        }
    }

    private void CancelDeleteAssessmentType()
    {
        assessmentTypeToDelete = null;
    }

