@page "/admin/subjects"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<h2>Subject Management</h2>
<button class="btn btn-primary mb-3" @onclick="() => showCreateForm = true">
    + Add New Subject
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<!-- FILTER BY GRADE -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Filter Subjects</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label>Select Grade</label>
                            <select class="form-control" @bind="selectedGrade" @bind:after="OnGradeChanged">
                                <option value="0">-- All Grades --</option>
                                <option value="10">Grade 10</option>
                                <option value="11">Grade 11</option>
                                <option value="12">Grade 12</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN SUBJECTS TABLE -->
@if (filteredSubjects == null)
{
    <p>Loading...</p>
}
else if (filteredSubjects.Count == 0)
{
    <p class="text-muted">No subjects for this grade.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subject Name</th>
                <th>Grade</th>
                <th>Teacher</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in filteredSubjects)
            {
                <tr>
                    <td>@subject.Name</td>
                    <td>@subject.Grade</td>
                    <td>@subject.Teacher?.User?.Fullname</td>
                    <td>@subject.AcademicYear</td>
                    <td>
                        <button class="btn btn-info btn-sm" @onclick="() => EditSubject(subject)">Edit</button>
                        <button class="btn btn-primary btn-sm ms-1" @onclick="() => ManageAssessmentTypes(subject)">Manage</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteSubject(subject)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ===== MODALS ===== -->
<!-- CREATE SUBJECT MODAL -->
@if (showCreateForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Subject</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Subject Name</label>
                        <input class="form-control" @bind="subjectName" />
                    </div>
                    <div class="mb-3">
                        <label>Grade</label>
                        <select class="form-control" @bind="grade">
                            <option value="10">Grade 10</option>
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Assign Teacher</label>
                        <select class="form-control" @bind="teacherId">
                            <option value="0">-- Select Teacher --</option>
                            @if (teachers != null)
                            {
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.TeacherId">@teacher.User?.Fullname</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Academic Year</label>
                        <input type="number" class="form-control" @bind="academicYear" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateSubject">Create</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- EDIT SUBJECT MODAL -->
@if (subjectToEdit != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Subject</h5>
                    <button type="button" class="btn-close" @onclick="() => subjectToEdit = null"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <div class="alert alert-danger">@editError</div>
                    }
                    <div class="mb-3">
                        <label>Subject Name</label>
                        <input class="form-control" @bind="editSubjectName" />
                    </div>
                    <div class="mb-3">
                        <label>Grade</label>
                        <select class="form-control" @bind="editGrade">
                            <option value="10">Grade 10</option>
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Assign Teacher</label>
                        <select class="form-control" @bind="editTeacherId">
                            <option value="0">-- Select Teacher --</option>
                            @if (teachers != null)
                            {
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.TeacherId">@teacher.User?.Fullname</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Academic Year</label>
                        <input type="number" class="form-control" @bind="editAcademicYear" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => subjectToEdit = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="UpdateSubject">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE SUBJECT CONFIRMATION MODAL -->
@if (subjectToDelete != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@subjectToDelete.Name</strong>?</p>
                    <p class="text-danger">This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ASSESSMENT MANAGEMENT MODAL (LARGE) -->
@if (showAssessmentTypes)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage @selectedSubject?.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => showAssessmentTypes = false"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                    
                    <!-- SECTION 1: ASSESSMENT TYPES -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Assessment Types</h6>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(assessmentTypeError))
                            {
                                <div class="alert alert-danger alert-sm">@assessmentTypeError</div>
                            }
                            @if (!string.IsNullOrEmpty(assessmentTypeSuccess))
                            {
                                <div class="alert alert-success alert-sm">@assessmentTypeSuccess</div>
                            }

                            @if (assessmentTypes.Count == 0)
                            {
                                <p class="text-muted">No assessment types yet. Create one to get started.</p>
                            }
                            else
                            {
                                <table class="table table-sm mb-3">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Term</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var type in assessmentTypes)
                                        {
                                            <tr>
                                                <td>@type.Name</td>
                                                <td>Term @type.Term</td>
                                                <td>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteAssessmentType(type)">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            <h6 class="mt-3">Add New Assessment Type</h6>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <input class="form-control form-control-sm" @bind="newTypeName" placeholder="e.g. SBA" />
                                </div>
                                <div class="col-md-3">
                                    <select class="form-control form-control-sm" @bind="newTypeTerm">
                                        <option value="1">Term 1</option>
                                        <option value="2">Term 2</option>
                                        <option value="3">Term 3</option>
                                        <option value="4">Term 4</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-success btn-sm w-100" @onclick="CreateAssessmentType">Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: ASSESSMENTS -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Assessments</h6>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(assessmentError))
                            {
                                <div class="alert alert-danger alert-sm">@assessmentError</div>
                            }
                            @if (!string.IsNullOrEmpty(assessmentSuccess))
                            {
                                <div class="alert alert-success alert-sm">@assessmentSuccess</div>
                            }

                            @if (assessments.Count == 0)
                            {
                                <p class="text-muted">No assessments yet.</p>
                            }
                            else
                            {
                                <table class="table table-sm mb-3">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Type</th>
                                            <th>Max Mark</th>
                                            <th>Term</th>
                                            <th>Date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assessment in assessments)
                                        {
                                            <tr>
                                                <td>@assessment.Title</td>
                                                <td>@assessment.AssessmentType?.Name</td>
                                                <td>@assessment.MaxMark</td>
                                                <td>Term @assessment.Term</td>
                                                <td>@assessment.Date.ToString("dd MMM yyyy")</td>
                                                <td>
                                                    <button class="btn btn-info btn-sm me-1" @onclick="() => SelectAssessmentForQuestions(assessment)">Questions</button>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteAssessment(assessment)">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            <h6 class="mt-3">Add New Assessment</h6>
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <input class="form-control form-control-sm" @bind="newAssessmentTitle" placeholder="Title" />
                                </div>
                                <div class="col-md-2">
                                    <select class="form-control form-control-sm" @bind="newAssessmentTypeId">
                                        <option value="0">-- Type --</option>
                                        @foreach (var type in assessmentTypes.Where(at => at.Term == newAssessmentTerm))
                                        {
                                            <option value="@type.AssessmentTypeId">@type.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-1">
                                    <input type="number" class="form-control form-control-sm" @bind="newAssessmentMaxMark" placeholder="Max" />
                                </div>
                                <div class="col-md-1">
                                    <select class="form-control form-control-sm" @bind="newAssessmentTerm">
                                        <option value="1">T1</option>
                                        <option value="2">T2</option>
                                        <option value="3">T3</option>
                                        <option value="4">T4</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <input type="date" class="form-control form-control-sm" @bind="newAssessmentDate" />
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-success btn-sm w-100" @onclick="CreateAssessment">Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: QUESTIONS -->
                    @if (selectedAssessment != null)
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0">Questions - @selectedAssessment.Title</h6>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(questionError))
                                {
                                    <div class="alert alert-danger alert-sm">@questionError</div>
                                }
                                @if (!string.IsNullOrEmpty(questionSuccess))
                                {
                                    <div class="alert alert-success alert-sm">@questionSuccess</div>
                                }

                                @if (assessmentQuestions.Count == 0)
                                {
                                    <p class="text-muted">No questions yet.</p>
                                }
                                else
                                {
                                    <table class="table table-sm mb-3">
                                        <thead>
                                            <tr>
                                                <th>Q#</th>
                                                <th>Topic</th>
                                                <th>Max Mark</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var question in assessmentQuestions)
                                            {
                                                <tr>
                                                    <td>@question.QuestionNumber</td>
                                                    <td>@question.Topic</td>
                                                    <td>@question.MaxMark</td>
                                                    <td>
                                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteQuestion(question)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <p class="text-muted text-sm">
                                        Total: <strong>@assessmentQuestions.Sum(q => q.MaxMark)</strong> / <strong>@selectedAssessment.MaxMark</strong> max
                                    </p>
                                }

                                <h6 class="mt-3">Add New Question</h6>
                                <div class="row g-2">
                                    <div class="col-md-1">
                                        <input type="number" class="form-control form-control-sm" @bind="newQuestionNumber" placeholder="Q#" />
                                    </div>
                                    <div class="col-md-5">
                                        <input class="form-control form-control-sm" @bind="newQuestionTopic" placeholder="Topic" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="number" class="form-control form-control-sm" @bind="newQuestionMaxMark" placeholder="Mark" />
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-success btn-sm w-100" @onclick="CreateQuestion">Add</button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-secondary btn-sm w-100" @onclick="() => selectedAssessment = null">Clear</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- SECTION 4: CONFIGURE WEIGHTS -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Configure Weights</h6>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(weightError))
                            {
                                <div class="alert alert-danger alert-sm">@weightError</div>
                            }
                            @if (!string.IsNullOrEmpty(weightSuccess))
                            {
                                <div class="alert alert-success alert-sm">@weightSuccess</div>
                            }

                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <select class="form-control form-control-sm" @bind="selectedWeightTerm">
                                        <option value="1">Term 1</option>
                                        <option value="2">Term 2</option>
                                        <option value="3">Term 3</option>
                                        <option value="4">Term 4</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary btn-sm w-100" @onclick="LoadWeightingStructure">Load</button>
                                </div>
                            </div>

                            @if (weightingStructure != null)
                            {
                                <table class="table table-sm mb-3">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th style="width: 120px;">Weight %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var node in weightingStructure.RootNodes.OrderBy(n => n.DisplayOrder))
                                        {
                                            <tr>
                                                <td>@node.Name</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm"
                                                           @bind="node.Weighting"
                                                           @bind:after="() => RecalculateWeightTotal()"
                                                           min="0" max="100" step="0.1" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <div class="alert alert-info alert-sm mb-3">
                                    <strong>Total:</strong> @weightTotal.ToString("F1")%
                                    @if (Math.Abs(weightTotal - 100f) > 0.01f)
                                    {
                                        <span class="text-danger">⚠️ Must be 100%</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">✓ Valid</span>
                                    }
                                </div>

                                <button class="btn btn-success btn-sm"
                                        @onclick="SaveWeightingStructure"
                                        disabled="@(Math.Abs(weightTotal - 100f) > 0.01f)">
                                    Save Weights
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showAssessmentTypes = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODALS -->
@if (assessmentTypeToDelete != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Assessment Type</h5>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>@assessmentTypeToDelete.Name</strong>? This will delete all associated assessments and questions.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDeleteAssessmentType">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAssessmentType">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (assessmentToDelete != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Assessment</h5>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>@assessmentToDelete.Title</strong>? This will delete all questions and marks.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDeleteAssessment">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAssessment">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (questionToDelete != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Question</h5>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>Q@questionToDelete.QuestionNumber (@questionToDelete.Topic)</strong>? This will delete all marks and interventions.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDeleteQuestion">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteQuestion">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CODE SECTION -->
@code {
    // State
    private List<Subject>? allSubjects;
    private List<Subject>? filteredSubjects;
    private List<Teacher>? teachers;
    private List<AssessmentType> assessmentTypes = new();
    private List<Assessment> assessments = new();
    private List<AssessmentQuestion> assessmentQuestions = new();
    private WeightingStructure? weightingStructure;

    // UI State
    private bool showCreateForm = false;
    private bool showAssessmentTypes = false;
    private int selectedGrade = 0;

    // Selected Items
    private Subject? selectedSubject;
    private Subject? subjectToDelete;
    private Subject? subjectToEdit;
    private Assessment? selectedAssessment;
    private AssessmentType? assessmentTypeToDelete;
    private Assessment? assessmentToDelete;
    private AssessmentQuestion? questionToDelete;

    // Form Fields - Create Subject
    private string subjectName = string.Empty;
    private int grade = 10;
    private int teacherId = 0;
    private int academicYear = DateTime.Now.Year;

    // Form Fields - Edit Subject
    private string editSubjectName = string.Empty;
    private int editGrade = 10;
    private int editTeacherId = 0;
    private int editAcademicYear = DateTime.Now.Year;

    // Form Fields - Assessment Type
    private string newTypeName = string.Empty;
    private int newTypeTerm = 1;

    // Form Fields - Assessment
    private string newAssessmentTitle = string.Empty;
    private float newAssessmentMaxMark = 100;
    private int newAssessmentTerm = 1;
    private int newAssessmentTypeId = 0;
    private DateTime newAssessmentDate = DateTime.Today;

    // Form Fields - Question
    private int newQuestionNumber = 1;
    private string newQuestionTopic = string.Empty;
    private float newQuestionMaxMark = 0;

    // Form Fields - Weights
    private int selectedWeightTerm = 1;
    private float weightTotal = 0f;

    // Messages
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string assessmentTypeError = string.Empty;
    private string assessmentTypeSuccess = string.Empty;
    private string assessmentError = string.Empty;
    private string assessmentSuccess = string.Empty;
    private string questionError = string.Empty;
    private string questionSuccess = string.Empty;
    private string editError = string.Empty;
    private string weightError = string.Empty;
    private string weightSuccess = string.Empty;

    // School context
    private int? currentSchoolId;

    // ===== LIFECYCLE =====
    protected override async Task OnInitializedAsync()
    {
        // Get current admin's school
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(userName))
        {
            errorMessage = "You must be logged in.";
            return;
        }

        var currentAdmin = await UserManager.FindByNameAsync(userName);
        if (currentAdmin?.SchoolId == null)
        {
            errorMessage = "You are not assigned to a school.";
            return;
        }

        currentSchoolId = currentAdmin.SchoolId;
        await LoadData();
    }

    // ===== LOAD DATA =====
    private async Task LoadData()
    {
        // ONLY load subjects from this school
        allSubjects = await DbContext.Subjects
            .AsNoTracking()
            .Include(s => s.Teacher)
            .ThenInclude(t => t.User)
            .Where(s => s.SchoolId == currentSchoolId)
            .ToListAsync();

        filteredSubjects = allSubjects;

        // ONLY load teachers from this school
        teachers = await DbContext.Teachers
            .AsNoTracking()
            .Include(t => t.User)
            .Where(t => t.User.SchoolId == currentSchoolId)
            .ToListAsync();
    }

    private void OnGradeChanged()
    {
        // Filter subjects by selected grade
        if (selectedGrade == 0)
        {
            filteredSubjects = allSubjects;
        }
        else
        {
            filteredSubjects = allSubjects?.Where(s => s.Grade == selectedGrade).ToList();
        }
    }

    // ===== SUBJECT CRUD =====
    private async Task CreateSubject()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(subjectName) || teacherId == 0)
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

