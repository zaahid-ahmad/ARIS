<!-- CODE SECTION -->
@code {
    // State
    private List<Subject>? allSubjects;
    private List<Subject>? filteredSubjects;
    private List<Teacher>? teachers;
    private List<AssessmentType> assessmentTypes = new();
    private List<Assessment> assessments = new();
    private List<AssessmentQuestion> assessmentQuestions = new();
    private WeightingStructure? weightingStructure;

    // Year Weighting tab
    private WeightingStructure? yearStructure;
    private List<AssessmentType> yearAssessmentTypes = new();
    private decimal yearWeightTotal = 0m;
    private string yearWeightError = string.Empty;
    private string yearWeightSuccess = string.Empty;

    // UI State
    private bool showCreateForm = false;
    private bool showAssessmentTypes = false;
    private int selectedGrade = 0;
    private string activeTab = "assessments";
    private int manageTerm = 1;

    // Grade 12's real final exam mark is held by the DBE, not captured in ARIS — there's no
    // Term 4 for those subjects in this system at all.
    private int[] AvailableTerms => selectedSubject?.Grade == 12 ? new[] { 1, 2, 3 } : new[] { 1, 2, 3, 4 };

    // Pagination
    private int currentPage = 1;
    private const int PageSize = 15;
    private int totalPages => (int)Math.Ceiling((filteredSubjects?.Count ?? 0) / (double)PageSize);
    private List<Subject> PagedSubjects => (filteredSubjects ?? new()).Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private void GoToPage(int page) => currentPage = page;

    // Selected Items
    private Subject? selectedSubject;
    private Subject? subjectToDelete;
    private Subject? subjectToEdit;
    private Assessment? selectedAssessment;
    private AssessmentType? assessmentTypeToDelete;
    private Assessment? assessmentToDelete;
    private AssessmentQuestion? questionToDelete;

    // Form Fields - Create Subject
    private string subjectName = string.Empty;
    private int grade = 10;
    private int teacherId = 0;
    private int academicYear = DateTime.Now.Year;

    // Form Fields - Edit Subject
    private string editSubjectName = string.Empty;
    private int editGrade = 10;
    private int editTeacherId = 0;
    private int editAcademicYear = DateTime.Now.Year;

    // Form Fields - Assessment Type
    private string newTypeName = string.Empty;

    // Form Fields - Assessment
    private string newAssessmentTitle = string.Empty;
    private decimal newAssessmentMaxMark = 100m;
    private DateTime newAssessmentDate = DateTime.Today;

    // Form Fields - Question
    private int newQuestionNumber = 1;
    private string newQuestionTopic = string.Empty;
    private decimal newQuestionMaxMark = 0m;

    // Form Fields - Weights
    private decimal weightTotal = 0m;

    // Messages
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string assessmentTypeError = string.Empty;
    private string assessmentTypeSuccess = string.Empty;
    private string assessmentError = string.Empty;
    private string assessmentSuccess = string.Empty;
    private string questionError = string.Empty;
    private string questionSuccess = string.Empty;
    private string weightError = string.Empty;
    private string weightSuccess = string.Empty;

    // Per-field validation — create subject
    private string? subjectNameError;
    private string? teacherIdError;
    private string? yearError;

    // Per-field validation — edit subject
    private string? editNameError;
    private string? editTeacherError;
    private string? editYearError;

    // Per-field validation — inline forms
    private bool newTypeNameInvalid;
    private bool newTitleInvalid;
    private bool newAMaxMarkInvalid;
    private bool newDateInvalid;
    private bool newTopicInvalid;
    private bool newQMarkInvalid;

    // School context
    private int? currentSchoolId;

    // ===== LIFECYCLE =====
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(userName))
        {
            errorMessage = "You must be logged in.";
            return;
        }

        var currentAdmin = await UserManager.FindByNameAsync(userName);
        if (currentAdmin?.SchoolId == null)
        {
            errorMessage = "You are not assigned to a school.";
            return;
        }

        currentSchoolId = currentAdmin.SchoolId;
        await LoadData();
    }

    // ===== LOAD DATA =====
    private async Task LoadData()
    {
        allSubjects = await DbContext.Subjects
            .AsNoTracking()
            .Include(s => s.Teacher)
            .ThenInclude(t => t.User)
            .Where(s => s.SchoolId == currentSchoolId)
            .ToListAsync();

        filteredSubjects = allSubjects;
        currentPage = 1;

        teachers = await DbContext.Teachers
            .AsNoTracking()
            .Include(t => t.User)
            .Where(t => t.User.SchoolId == currentSchoolId)
            .ToListAsync();
    }

    private void OnGradeChanged()
    {
        filteredSubjects = selectedGrade == 0
            ? allSubjects
            : allSubjects?.Where(s => s.Grade == selectedGrade).ToList();
        currentPage = 1;
    }

    // ===== SUBJECT CRUD =====
    private bool ValidateCreateSubject()
    {
        subjectNameError = teacherIdError = yearError = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(subjectName))
        { subjectNameError = "Subject name is required."; valid = false; }
        else if (subjectName.Trim().Length < 2)
        { subjectNameError = "Name must be at least 2 characters."; valid = false; }

        if (teacherId == 0)
        { teacherIdError = "Please select a teacher."; valid = false; }

        if (academicYear < 2020 || academicYear > DateTime.Now.Year + 1)
        { yearError = $"Year must be between 2020 and {DateTime.Now.Year + 1}."; valid = false; }

        return valid;
    }

    private async Task CreateSubject()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (!ValidateCreateSubject()) return;

        var subject = new Subject
        {
            Name = subjectName,
            Grade = grade,
            TeacherId = teacherId,
            AcademicYear = academicYear,
            SchoolId = currentSchoolId!.Value
        };

        DbContext.Subjects.Add(subject);
        await DbContext.SaveChangesAsync();

        successMessage = "Subject created!";
        subjectName = string.Empty;
        teacherId = 0;
        showCreateForm = false;
        await LoadData();
    }

    private void EditSubject(Subject subject)
    {
        subjectToEdit = subject;
        editSubjectName = subject.Name;
        editGrade = subject.Grade;
        editTeacherId = subject.TeacherId;
        editAcademicYear = subject.AcademicYear;
        editNameError = editTeacherError = editYearError = null;
    }

    private bool ValidateEditSubject()
    {
        editNameError = editTeacherError = editYearError = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(editSubjectName))
        { editNameError = "Subject name is required."; valid = false; }
        else if (editSubjectName.Trim().Length < 2)
        { editNameError = "Name must be at least 2 characters."; valid = false; }

        if (editTeacherId == 0)
        { editTeacherError = "Please select a teacher."; valid = false; }

        if (editAcademicYear < 2020 || editAcademicYear > DateTime.Now.Year + 1)
        { editYearError = $"Year must be between 2020 and {DateTime.Now.Year + 1}."; valid = false; }

        return valid;
    }

    private async Task UpdateSubject()
    {
        if (!ValidateEditSubject()) return;

        if (subjectToEdit != null)
        {
            subjectToEdit.Name = editSubjectName;
            subjectToEdit.Grade = editGrade;
            subjectToEdit.TeacherId = editTeacherId;
            subjectToEdit.AcademicYear = editAcademicYear;

            DbContext.Subjects.Update(subjectToEdit);
            await DbContext.SaveChangesAsync();

            successMessage = "Subject updated!";
            subjectToEdit = null;
            await LoadData();
        }
    }

    private void DeleteSubject(Subject subject)
    {
        subjectToDelete = subject;
    }

    private async Task ConfirmDelete()
    {
        if (subjectToDelete != null)
        {
            try
            {
                var subject = await DbContext.Subjects.FindAsync(subjectToDelete.SubjectId);
                if (subject == null)
                {
                    errorMessage = "Subject no longer exists.";
                    subjectToDelete = null;
                    return;
                }

                var weightingStructures = await DbContext.WeightingStructures
                    .Where(ws => ws.SubjectId == subjectToDelete.SubjectId)
                    .ToListAsync();
                DbContext.WeightingStructures.RemoveRange(weightingStructures);
                await DbContext.SaveChangesAsync();

                DbContext.Subjects.Remove(subject);
                await DbContext.SaveChangesAsync();

                successMessage = "Subject deleted!";
                subjectToDelete = null;
                await LoadData();
                OnGradeChanged();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting subject: {ex.Message}";
                subjectToDelete = null;
            }
        }
    }

    private void CancelDelete()
    {
        subjectToDelete = null;
    }

    // ===== MANAGE MODAL =====
    private async Task ManageAssessmentTypes(Subject subject)
    {
        selectedSubject = subject;
        showAssessmentTypes = true;
        activeTab = "assessments";
        manageTerm = 1;
        selectedAssessment = null;
        assessmentQuestions.Clear();
        ClearManageMessages();
        await LoadAssessmentTypes();
        await LoadAssessments();
    }

    private void CloseManageModal()
    {
        showAssessmentTypes = false;
        selectedAssessment = null;
        assessmentQuestions.Clear();
        activeTab = "assessments";
        ClearManageMessages();
    }

    private async Task OnManageTermChanged(int term)
    {
        manageTerm = term;
        selectedAssessment = null;
        assessmentQuestions.Clear();
        ClearManageMessages();
        if (activeTab == "weights")
            await LoadWeightingStructure();
    }

    private async Task SwitchToWeightsTab()
    {
        activeTab = "weights";
        await LoadWeightingStructure();
    }

    private void ClearManageMessages()
    {
        assessmentTypeError = string.Empty;
        assessmentTypeSuccess = string.Empty;
        assessmentError = string.Empty;
        assessmentSuccess = string.Empty;
        questionError = string.Empty;
        questionSuccess = string.Empty;
        weightError = string.Empty;
        weightSuccess = string.Empty;
    }

    // ===== ASSESSMENT TYPES =====
    private async Task LoadAssessmentTypes()
    {
        assessmentTypes = await DbContext.AssessmentTypes
            .AsNoTracking()
            .Where(at => at.Subject!.SchoolId == currentSchoolId && at.SubjectId == selectedSubject!.SubjectId)
            .ToListAsync();
    }

    private async Task CreateAssessmentType()
    {
        assessmentTypeError = string.Empty;
        assessmentTypeSuccess = string.Empty;
        newTypeNameInvalid = false;

        if (string.IsNullOrWhiteSpace(newTypeName))
        {
            newTypeNameInvalid = true;
            assessmentTypeError = "Please enter a type name.";
            return;
        }

        if (selectedSubject!.Grade == 12 && manageTerm == 4)
        {
            assessmentTypeError = "Grade 12 subjects cannot have Term 4 assessment types — the final NSC result is held by the DBE, not captured here.";
            return;
        }

        var type = new AssessmentType
        {
            SubjectId = selectedSubject!.SubjectId,
            Name = newTypeName,
            WeightPercentage = 0,
            Term = manageTerm
        };

        DbContext.AssessmentTypes.Add(type);
        await DbContext.SaveChangesAsync();

        assessmentTypeSuccess = "Type created!";
        newTypeName = string.Empty;
        await LoadAssessmentTypes();
    }

    private void DeleteAssessmentType(AssessmentType type)
    {
        assessmentTypeToDelete = type;
    }

    private async Task ConfirmDeleteAssessmentType()
    {
        if (assessmentTypeToDelete == null) return;

        try
        {
            var typeToDelete = await DbContext.AssessmentTypes.FindAsync(assessmentTypeToDelete.AssessmentTypeId);
            if (typeToDelete != null)
            {
                var weightingNodes = await DbContext.WeightingNodes
                    .Where(wn => wn.AssessmentTypeId == assessmentTypeToDelete.AssessmentTypeId)
                    .ToListAsync();
                DbContext.WeightingNodes.RemoveRange(weightingNodes);

                var relatedAssessments = await DbContext.Assessments
                    .Where(a => a.AssessmentTypeId == assessmentTypeToDelete.AssessmentTypeId)
                    .ToListAsync();

                foreach (var assessment in relatedAssessments)
                {
                    var questions = await DbContext.AssessmentQuestions
                        .Where(q => q.AssessmentId == assessment.AssessmentId)
                        .ToListAsync();

                    foreach (var question in questions)
                    {
                        var interventions = await DbContext.Interventions.Where(i => i.QuestionId == question.QuestionId).ToListAsync();
                        DbContext.Interventions.RemoveRange(interventions);

                        var questionMarks = await DbContext.LearnerQuestionMarks.Where(m => m.QuestionId == question.QuestionId).ToListAsync();
                        DbContext.LearnerQuestionMarks.RemoveRange(questionMarks);
                    }

                    DbContext.AssessmentQuestions.RemoveRange(questions);
                    var marks = await DbContext.LearnerMarks.Where(m => m.AssessmentId == assessment.AssessmentId).ToListAsync();
                    DbContext.LearnerMarks.RemoveRange(marks);
                }

                DbContext.Assessments.RemoveRange(relatedAssessments);
                DbContext.AssessmentTypes.Remove(typeToDelete);
                await DbContext.SaveChangesAsync();

                assessmentTypeSuccess = "Type deleted!";
                assessmentTypeToDelete = null;
                if (selectedAssessment != null && relatedAssessments.Any(a => a.AssessmentId == selectedAssessment.AssessmentId))
                {
                    selectedAssessment = null;
                    assessmentQuestions.Clear();
                }
                await LoadAssessmentTypes();
                await LoadAssessments();
            }
        }
        catch (Exception ex)
        {
            assessmentTypeError = $"Error: {ex.Message}";
        }
    }

    private void CancelDeleteAssessmentType()
    {
        assessmentTypeToDelete = null;
    }

    // ===== ASSESSMENTS =====
    private async Task LoadAssessments()
    {
        assessments = await DbContext.Assessments
            .AsNoTracking()
            .Include(a => a.AssessmentType)
            .Where(a => a.Subject!.SchoolId == currentSchoolId && a.SubjectId == selectedSubject!.SubjectId)
            .ToListAsync();
    }

    private async Task CreateAssessment(int typeId)
    {
        assessmentError = string.Empty;
        assessmentSuccess = string.Empty;
        newTitleInvalid = newAMaxMarkInvalid = newDateInvalid = false;

        var assessmentValid = true;
        if (string.IsNullOrWhiteSpace(newAssessmentTitle))
        { newTitleInvalid = true; assessmentValid = false; }

        if (newAssessmentMaxMark <= 0)
        { newAMaxMarkInvalid = true; assessmentValid = false; }

        if (newAssessmentDate == default)
        { newDateInvalid = true; assessmentValid = false; }

        if (!assessmentValid)
        {
            assessmentError = "Please fix the highlighted fields.";
            return;
        }

        if (selectedSubject!.Grade == 12 && manageTerm == 4)
        {
            assessmentError = "Grade 12 subjects cannot have Term 4 assessments — the final NSC result is held by the DBE, not captured here.";
            return;
        }

        var assessment = new Assessment
        {
            Title = newAssessmentTitle,
            SubjectId = selectedSubject!.SubjectId,
            AssessmentTypeId = typeId,
            MaxMark = newAssessmentMaxMark,
            Term = manageTerm,
            Date = newAssessmentDate
        };

        DbContext.Assessments.Add(assessment);
        await DbContext.SaveChangesAsync();

        assessmentSuccess = "Assessment created!";
        newAssessmentTitle = string.Empty;
        newAssessmentMaxMark = 100;
        await LoadAssessments();
    }

    private void DeleteAssessment(Assessment assessment)
    {
        assessmentToDelete = assessment;
    }

    private async Task ConfirmDeleteAssessment()
    {
        if (assessmentToDelete == null) return;

        try
        {
            var assessmentToDeleteObj = await DbContext.Assessments.FindAsync(assessmentToDelete.AssessmentId);
            if (assessmentToDeleteObj != null)
            {
                var questions = await DbContext.AssessmentQuestions
                    .Where(q => q.AssessmentId == assessmentToDelete.AssessmentId)
                    .ToListAsync();

                foreach (var question in questions)
                {
                    var interventions = await DbContext.Interventions.Where(i => i.QuestionId == question.QuestionId).ToListAsync();
                    DbContext.Interventions.RemoveRange(interventions);

                    var questionMarks = await DbContext.LearnerQuestionMarks.Where(m => m.QuestionId == question.QuestionId).ToListAsync();
                    DbContext.LearnerQuestionMarks.RemoveRange(questionMarks);
                }

                DbContext.AssessmentQuestions.RemoveRange(questions);
                var marks = await DbContext.LearnerMarks.Where(m => m.AssessmentId == assessmentToDelete.AssessmentId).ToListAsync();
                DbContext.LearnerMarks.RemoveRange(marks);

                DbContext.Assessments.Remove(assessmentToDeleteObj);
                await DbContext.SaveChangesAsync();

                assessmentSuccess = "Assessment deleted!";
                if (selectedAssessment?.AssessmentId == assessmentToDelete.AssessmentId)
                {
                    selectedAssessment = null;
                    assessmentQuestions.Clear();
                }
                assessmentToDelete = null;
                await LoadAssessments();
            }
        }
        catch (Exception ex)
        {
            assessmentError = $"Error: {ex.Message}";
        }
    }

    private void CancelDeleteAssessment()
    {
        assessmentToDelete = null;
    }

    // ===== QUESTIONS =====
    private async Task ToggleAssessmentQuestions(Assessment assessment)
    {
        questionError = string.Empty;
        questionSuccess = string.Empty;

        if (selectedAssessment?.AssessmentId == assessment.AssessmentId)
        {
            selectedAssessment = null;
            assessmentQuestions.Clear();
        }
        else
        {
            selectedAssessment = assessment;
            newQuestionNumber = 1;
            newQuestionTopic = string.Empty;
            newQuestionMaxMark = 0;
            newTopicInvalid = newQMarkInvalid = false;
            questionError = string.Empty;
            questionSuccess = string.Empty;
            await LoadAssessmentQuestions();
        }
    }

    private async Task LoadAssessmentQuestions()
    {
        if (selectedAssessment == null) return;

        assessmentQuestions = await DbContext.AssessmentQuestions
            .AsNoTracking()
            .Where(q => q.AssessmentId == selectedAssessment.AssessmentId)
            .OrderBy(q => q.QuestionNumber)
            .ToListAsync();

        newQuestionNumber = assessmentQuestions.Count > 0
            ? assessmentQuestions.Max(q => q.QuestionNumber) + 1
            : 1;
    }

    private async Task CreateQuestion()
    {
        questionError = string.Empty;
        questionSuccess = string.Empty;
        newTopicInvalid = newQMarkInvalid = false;

        var questionValid = true;
        if (string.IsNullOrWhiteSpace(newQuestionTopic))
        { newTopicInvalid = true; questionValid = false; }

        if (newQuestionMaxMark <= 0)
        { newQMarkInvalid = true; questionValid = false; }

        if (!questionValid)
        {
            questionError = "Please fix the highlighted fields.";
            return;
        }

        if (selectedAssessment == null) return;

        var totalQuestionMarks = assessmentQuestions.Sum(q => q.MaxMark) + newQuestionMaxMark;
        if (totalQuestionMarks > selectedAssessment.MaxMark)
        {
            questionError = $"Total ({totalQuestionMarks.ToString("0.##")}) exceeds assessment max ({selectedAssessment.MaxMark.ToString("0.##")}).";
            return;
        }

        var question = new AssessmentQuestion
        {
            AssessmentId = selectedAssessment.AssessmentId,
            QuestionNumber = newQuestionNumber,
            Topic = newQuestionTopic,
            MaxMark = newQuestionMaxMark
        };

        DbContext.AssessmentQuestions.Add(question);
        await DbContext.SaveChangesAsync();

        questionSuccess = "Question added!";
        newQuestionTopic = string.Empty;
        newQuestionMaxMark = 0;
        await LoadAssessmentQuestions();
    }

    private void DeleteQuestion(AssessmentQuestion question)
    {
        questionToDelete = question;
    }

    private async Task ConfirmDeleteQuestion()
    {
        if (questionToDelete == null) return;

        try
        {
            var questionToDeleteObj = await DbContext.AssessmentQuestions.FindAsync(questionToDelete.QuestionId);
            if (questionToDeleteObj != null)
            {
                var interventions = await DbContext.Interventions.Where(i => i.QuestionId == questionToDelete.QuestionId).ToListAsync();
                DbContext.Interventions.RemoveRange(interventions);

                var marks = await DbContext.LearnerQuestionMarks.Where(m => m.QuestionId == questionToDelete.QuestionId).ToListAsync();
                DbContext.LearnerQuestionMarks.RemoveRange(marks);

                DbContext.AssessmentQuestions.Remove(questionToDeleteObj);
                await DbContext.SaveChangesAsync();
                questionSuccess = "Question deleted!";
                questionToDelete = null;
                await LoadAssessmentQuestions();
            }
        }
        catch (Exception ex)
        {
            questionError = $"Error: {ex.Message}";
        }
    }

    private void CancelDeleteQuestion()
    {
        questionToDelete = null;
    }

    // ===== WEIGHTS =====
    private async Task LoadWeightingStructure()
    {
        try
        {
            weightError = string.Empty;

            if (selectedSubject == null)
            {
                weightError = "No subject selected.";
                return;
            }

            weightingStructure = await DbContext.WeightingStructures
                .AsNoTracking()
                .Include(ws => ws.RootNodes)
                .FirstOrDefaultAsync(ws =>
                    ws.SubjectId == selectedSubject.SubjectId &&
                    ws.Term == manageTerm);

            var allTypes = await DbContext.AssessmentTypes
                .AsNoTracking()
                .Where(at => at.SubjectId == selectedSubject.SubjectId && at.Term == manageTerm)
                .ToListAsync();

            if (weightingStructure != null)
            {
                var existingTypeIds = weightingStructure.RootNodes.Select(n => n.AssessmentTypeId).ToHashSet();
                var missingTypes = allTypes.Where(t => !existingTypeIds.Contains(t.AssessmentTypeId)).ToList();

                if (missingTypes.Count > 0)
                {
                    int maxOrder = weightingStructure.RootNodes.Any()
                        ? weightingStructure.RootNodes.Max(n => n.DisplayOrder) + 1
                        : 0;

                    foreach (var type in missingTypes)
                    {
                        var newNode = new WeightingNode
                        {
                            WeightingStructureId = weightingStructure.WeightingStructureId,
                            NodeType = "AssessmentType",
                            Name = type.Name,
                            Weighting = 0m,
                            DisplayOrder = maxOrder++,
                            AssessmentTypeId = type.AssessmentTypeId
                        };
                        DbContext.WeightingNodes.Add(newNode);
                    }

                    await DbContext.SaveChangesAsync();

                    weightingStructure = await DbContext.WeightingStructures
                        .AsNoTracking()
                        .Include(ws => ws.RootNodes)
                        .FirstOrDefaultAsync(ws =>
                            ws.SubjectId == selectedSubject.SubjectId &&
                            ws.Term == manageTerm);
                }
            }
            else if (allTypes.Count > 0)
            {
                var newStructure = new WeightingStructure
                {
                    SubjectId = selectedSubject.SubjectId,
                    Term = manageTerm,
                    Name = $"{selectedSubject.Name} - Term {manageTerm}",
                    IsActive = true
                };
                DbContext.WeightingStructures.Add(newStructure);
                await DbContext.SaveChangesAsync();

                int order = 0;
                foreach (var type in allTypes)
                {
                    var node = new WeightingNode
                    {
                        WeightingStructureId = newStructure.WeightingStructureId,
                        NodeType = "AssessmentType",
                        Name = type.Name,
                        Weighting = 0m,
                        DisplayOrder = order++,
                        AssessmentTypeId = type.AssessmentTypeId
                    };
                    DbContext.WeightingNodes.Add(node);
                }
                await DbContext.SaveChangesAsync();

                weightingStructure = await DbContext.WeightingStructures
                    .AsNoTracking()
                    .Include(ws => ws.RootNodes)
                    .FirstOrDefaultAsync(ws => ws.SubjectId == selectedSubject.SubjectId && ws.Term == manageTerm);
            }

            RecalculateWeightTotal();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            weightError = $"Error: {ex.Message}";
        }
    }

    private static string FormatWeight(decimal w) => w.ToString("0.##");

    private void OnWeightChanged(WeightingNode node, string? rawValue)
    {
        if (decimal.TryParse(rawValue, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
            node.Weighting = Math.Max(0m, Math.Min(100m, v));
        RecalculateWeightTotal();
    }

    private void RecalculateWeightTotal()
    {
        weightTotal = weightingStructure?.RootNodes?.Sum(n => n.Weighting) ?? 0m;
    }

    private async Task SaveWeightingStructure()
    {
        try
        {
            weightError = string.Empty;
            weightSuccess = string.Empty;

            if (Math.Abs(weightTotal - 100m) > 0.001m)
            {
                weightError = $"Weights must sum to 100%. Current: {weightTotal.ToString("0.##")}%";
                return;
            }

            if (weightingStructure == null || selectedSubject == null)
            {
                weightError = "Invalid structure.";
                return;
            }

            var existing = await DbContext.WeightingStructures
                .Include(ws => ws.RootNodes)
                .FirstOrDefaultAsync(ws =>
                    ws.SubjectId == selectedSubject.SubjectId &&
                    ws.Term == manageTerm);

            if (existing != null)
            {
                foreach (var node in weightingStructure.RootNodes)
                {
                    var existingNode = existing.RootNodes.FirstOrDefault(n => n.AssessmentTypeId == node.AssessmentTypeId);
                    if (existingNode != null)
                    {
                        existingNode.Weighting = node.Weighting;
                        DbContext.WeightingNodes.Update(existingNode);
                    }
                    else
                    {
                        var newNode = new WeightingNode
                        {
                            WeightingStructureId = existing.WeightingStructureId,
                            ParentNodeId = null,
                            NodeType = "AssessmentType",
                            Name = node.Name,
                            Weighting = node.Weighting,
                            DisplayOrder = node.DisplayOrder,
                            AssessmentTypeId = node.AssessmentTypeId
                        };
                        DbContext.WeightingNodes.Add(newNode);
                    }
                }
            }
            else
            {
                var newStructure = new WeightingStructure
                {
                    SubjectId = selectedSubject.SubjectId,
                    Term = manageTerm,
                    Name = $"{selectedSubject.Name} - Term {manageTerm}",
                    IsActive = true
                };

                DbContext.WeightingStructures.Add(newStructure);
                await DbContext.SaveChangesAsync();

                int order = 0;
                foreach (var node in weightingStructure.RootNodes)
                {
                    var newNode = new WeightingNode
                    {
                        WeightingStructureId = newStructure.WeightingStructureId,
                        ParentNodeId = null,
                        NodeType = "AssessmentType",
                        Name = node.Name,
                        Weighting = node.Weighting,
                        DisplayOrder = order++,
                        AssessmentTypeId = node.AssessmentTypeId
                    };
                    DbContext.WeightingNodes.Add(newNode);
                }
            }

            await DbContext.SaveChangesAsync();
            weightSuccess = "Weights saved!";

            weightingStructure = null;
            await LoadWeightingStructure();
        }
        catch (Exception ex)
        {
            weightError = $"Error: {ex.Message}";
        }
    }

    // ===== YEAR WEIGHTING =====
    private async Task SwitchToYearTab()
    {
        activeTab = "year";
        await LoadYearStructure();
    }

    private async Task LoadYearStructure()
    {
        yearWeightError = string.Empty;
        yearWeightSuccess = string.Empty;

        if (selectedSubject == null)
        {
            yearWeightError = "No subject selected.";
            return;
        }

        var existing = await DbContext.WeightingStructures
            .AsNoTracking()
            .Include(ws => ws.RootNodes)
            .ThenInclude(n => n.ChildNodes)
            .FirstOrDefaultAsync(ws => ws.SubjectId == selectedSubject.SubjectId && ws.Term == 0);

        // WeightingStructure.RootNodes is actually every node belonging to the structure (it's
        // the collection side of the WeightingStructureId FK, not a true-roots-only filter) — the
        // original flat per-term editor never had children so this never mattered before. Filter
        // down to actual top-level nodes here; each one's own ChildNodes (populated above via
        // ThenInclude, keyed off ParentNodeId) is unaffected by filtering this outer list.
        yearStructure = existing == null
            ? new WeightingStructure
            {
                SubjectId = selectedSubject.SubjectId,
                Term = 0,
                Name = $"{selectedSubject.Name} - Year",
                IsActive = true,
                RootNodes = new List<WeightingNode>()
            }
            : new WeightingStructure
            {
                WeightingStructureId = existing.WeightingStructureId,
                SubjectId = existing.SubjectId,
                Term = existing.Term,
                Name = existing.Name,
                IsActive = existing.IsActive,
                RootNodes = existing.RootNodes.Where(n => n.ParentNodeId == null).ToList()
            };

        // Every AssessmentType across every term this subject has — not just the currently
        // selected manageTerm, since Year nodes can reference any of them.
        yearAssessmentTypes = await DbContext.AssessmentTypes
            .AsNoTracking()
            .Where(at => at.SubjectId == selectedSubject.SubjectId)
            .ToListAsync();

        RecalculateYearWeightTotal();
    }

    private void AddYearRootNode()
    {
        if (yearStructure == null) return;
        yearStructure.RootNodes.Add(new WeightingNode
        {
            NodeType = "Custom",
            Name = "New Group",
            Weighting = 0m,
            DisplayOrder = yearStructure.RootNodes.Count,
            ChildNodes = new List<WeightingNode>()
        });
        RecalculateYearWeightTotal();
    }

    private void AddYearChildNode(WeightingNode parent)
    {
        parent.ChildNodes.Add(new WeightingNode
        {
            NodeType = "Term",
            Name = "New Term",
            Weighting = 0m,
            DisplayOrder = parent.ChildNodes.Count,
            // The <select> below defaults its displayed option to the first Term regardless of
            // the bound value, so without this the model silently stays null unless the admin
            // happens to touch the dropdown.
            ReferencedTerm = AvailableTerms.FirstOrDefault()
        });
    }

    private void RemoveYearNode(WeightingNode node)
    {
        if (yearStructure == null) return;

        if (yearStructure.RootNodes.Remove(node))
        {
            RecalculateYearWeightTotal();
            return;
        }

        foreach (var root in yearStructure.RootNodes)
        {
            if (root.ChildNodes.Remove(node)) return;
        }
    }

    private void OnYearWeightChanged(WeightingNode node, string? rawValue)
    {
        if (decimal.TryParse(rawValue, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
            node.Weighting = Math.Max(0m, Math.Min(100m, v));
        RecalculateYearWeightTotal();
    }

    private void RecalculateYearWeightTotal()
    {
        yearWeightTotal = yearStructure?.RootNodes?.Sum(n => n.Weighting) ?? 0m;
    }

    private async Task SaveYearStructure()
    {
        yearWeightError = string.Empty;
        yearWeightSuccess = string.Empty;

        if (yearStructure == null || selectedSubject == null)
        {
            yearWeightError = "Invalid structure.";
            return;
        }

        var validation = WeightingService.ValidateWeightingStructure(yearStructure);
        if (!validation.IsValid)
        {
            yearWeightError = validation.Message;
            return;
        }

        try
        {
            var existing = await DbContext.WeightingStructures
                .FirstOrDefaultAsync(ws => ws.SubjectId == selectedSubject.SubjectId && ws.Term == 0);

            if (existing == null)
            {
                existing = new WeightingStructure
                {
                    SubjectId = selectedSubject.SubjectId,
                    Term = 0,
                    Name = $"{selectedSubject.Name} - Year",
                    IsActive = true
                };
                DbContext.WeightingStructures.Add(existing);
                await DbContext.SaveChangesAsync();
            }

            // Clear-and-recreate rather than diff the tree — simplest way to handle arbitrary
            // add/remove/reparent edits, mirrors the precedent already used elsewhere in this
            // file (ConfirmDeleteAssessmentType) and in WeightingService.CreateSimpleWeighting.
            var existingNodes = await DbContext.WeightingNodes
                .Where(n => n.WeightingStructureId == existing.WeightingStructureId)
                .ToListAsync();
            DbContext.WeightingNodes.RemoveRange(existingNodes);
            await DbContext.SaveChangesAsync();

            int order = 0;
            foreach (var root in yearStructure.RootNodes)
            {
                var newRoot = new WeightingNode
                {
                    WeightingStructureId = existing.WeightingStructureId,
                    ParentNodeId = null,
                    NodeType = root.NodeType,
                    Name = root.Name,
                    Weighting = root.Weighting,
                    DisplayOrder = order++,
                    AssessmentTypeId = root.NodeType == "AssessmentType" ? root.AssessmentTypeId : null,
                    ReferencedTerm = root.NodeType == "Term" ? (root.ReferencedTerm ?? AvailableTerms.FirstOrDefault()) : null
                };
                DbContext.WeightingNodes.Add(newRoot);
                await DbContext.SaveChangesAsync(); // need newRoot's id before adding its children

                int childOrder = 0;
                foreach (var child in root.ChildNodes)
                {
                    DbContext.WeightingNodes.Add(new WeightingNode
                    {
                        WeightingStructureId = existing.WeightingStructureId,
                        ParentNodeId = newRoot.WeightingNodeId,
                        NodeType = child.NodeType,
                        Name = child.Name,
                        Weighting = child.Weighting,
                        DisplayOrder = childOrder++,
                        AssessmentTypeId = child.NodeType == "AssessmentType" ? child.AssessmentTypeId : null,
                        ReferencedTerm = child.NodeType == "Term" ? (child.ReferencedTerm ?? AvailableTerms.FirstOrDefault()) : null
                    });
                }
                await DbContext.SaveChangesAsync();
            }

            yearWeightSuccess = "Year weighting saved!";
            await LoadYearStructure();
        }
        catch (Exception ex)
        {
            yearWeightError = $"Error: {ex.Message}";
        }
    }
}
