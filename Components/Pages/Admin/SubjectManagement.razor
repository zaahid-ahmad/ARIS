@page "/admin/subjects"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using ARIS1.Data
@using ARIS1.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject WeightingService WeightingService

<button class="btn btn-primary mb-3" @onclick="() => showCreateForm = true">
    + Add New Subject
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<!-- FILTER BY GRADE -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Filter Subjects</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label>Select Grade</label>
                            <select class="form-control" @bind="selectedGrade" @bind:after="OnGradeChanged">
                                <option value="0">-- All Grades --</option>
                                <option value="10">Grade 10</option>
                                <option value="11">Grade 11</option>
                                <option value="12">Grade 12</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN SUBJECTS TABLE -->
@if (filteredSubjects == null)
{
    <p>Loading...</p>
}
else if (filteredSubjects.Count == 0)
{
    <p class="text-muted">No subjects for this grade.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subject Name</th>
                <th>Grade</th>
                <th>Teacher</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in PagedSubjects)
            {
                <tr>
                    <td>@subject.Name</td>
                    <td>@subject.Grade</td>
                    <td>@subject.Teacher?.User?.Fullname</td>
                    <td>@subject.AcademicYear</td>
                    <td>
                        <button class="btn btn-info btn-sm" @onclick="() => EditSubject(subject)">Edit</button>
                        <button class="btn btn-primary btn-sm ms-1" @onclick="() => ManageAssessmentTypes(subject)">Manage</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteSubject(subject)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="GoToPage" />
}

<!-- ===== MODALS ===== -->
<!-- CREATE SUBJECT MODAL -->
@if (showCreateForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Subject</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Subject Name <span class="text-danger">*</span></label>
                        <input class="form-control @(subjectNameError != null ? "is-invalid" : "")"
                               @bind="subjectName" @oninput="@(() => subjectNameError = null)"
                               maxlength="100" placeholder="e.g. Mathematics" />
                        @if (subjectNameError != null)
                        {
                            <div class="invalid-feedback">@subjectNameError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Grade <span class="text-danger">*</span></label>
                        <select class="form-control" @bind="grade">
                            <option value="10">Grade 10</option>
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assign Teacher <span class="text-danger">*</span></label>
                        <select class="form-control @(teacherIdError != null ? "is-invalid" : "")"
                                @bind="teacherId" @bind:after="@(() => teacherIdError = null)">
                            <option value="0">-- Select Teacher --</option>
                            @if (teachers != null)
                            {
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.TeacherId">@teacher.User?.Fullname</option>
                                }
                            }
                        </select>
                        @if (teacherIdError != null)
                        {
                            <div class="invalid-feedback">@teacherIdError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Academic Year <span class="text-danger">*</span></label>
                        <input type="number" class="form-control @(yearError != null ? "is-invalid" : "")"
                               @bind="academicYear" @oninput="@(() => yearError = null)"
                               min="2020" max="@(DateTime.Now.Year + 1)" />
                        @if (yearError != null)
                        {
                            <div class="invalid-feedback">@yearError</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateSubject">Create</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- EDIT SUBJECT MODAL -->
@if (subjectToEdit != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Subject</h5>
                    <button type="button" class="btn-close" @onclick="() => subjectToEdit = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Subject Name <span class="text-danger">*</span></label>
                        <input class="form-control @(editNameError != null ? "is-invalid" : "")"
                               @bind="editSubjectName" @oninput="@(() => editNameError = null)"
                               maxlength="100" />
                        @if (editNameError != null)
                        {
                            <div class="invalid-feedback">@editNameError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Grade <span class="text-danger">*</span></label>
                        <select class="form-control" @bind="editGrade">
                            <option value="10">Grade 10</option>
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assign Teacher <span class="text-danger">*</span></label>
                        <select class="form-control @(editTeacherError != null ? "is-invalid" : "")"
                                @bind="editTeacherId" @bind:after="@(() => editTeacherError = null)">
                            <option value="0">-- Select Teacher --</option>
                            @if (teachers != null)
                            {
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.TeacherId">@teacher.User?.Fullname</option>
                                }
                            }
                        </select>
                        @if (editTeacherError != null)
                        {
                            <div class="invalid-feedback">@editTeacherError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Academic Year <span class="text-danger">*</span></label>
                        <input type="number" class="form-control @(editYearError != null ? "is-invalid" : "")"
                               @bind="editAcademicYear" @oninput="@(() => editYearError = null)"
                               min="2020" max="@(DateTime.Now.Year + 1)" />
                        @if (editYearError != null)
                        {
                            <div class="invalid-feedback">@editYearError</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => subjectToEdit = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="UpdateSubject">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE SUBJECT CONFIRMATION MODAL -->
@if (subjectToDelete != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@subjectToDelete.Name</strong>?</p>
                    <p class="text-danger">This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ASSESSMENT MANAGEMENT MODAL -->
@if (showAssessmentTypes)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage: @selectedSubject?.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseManageModal"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">

                    <!-- Tabs -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "assessments" ? "active" : "")"
                                    @onclick='() => activeTab = "assessments"'>
                                Assessments
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "weights" ? "active" : "")"
                                    @onclick="SwitchToWeightsTab">
                                Weightings
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "year" ? "active" : "")"
                                    @onclick="SwitchToYearTab">
                                Year Weighting
                            </button>
                        </li>
                    </ul>

                    <!-- Shared Term Selector (not used by the Year tab — Year isn't term-scoped) -->
                    @if (activeTab != "year")
                    {
                        <div class="btn-group mb-4" role="group">
                            @foreach (var t in AvailableTerms)
                            {
                                <button type="button"
                                        class="btn @(manageTerm == t ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="() => OnManageTermChanged(t)">
                                    Term @t
                                </button>
                            }
                        </div>
                        @if (selectedSubject?.Grade == 12)
                        {
                            <p class="text-muted small mb-3">
                                Grade 12 subjects only have Terms 1–3 here — the final NSC exam result is
                                held by the Department of Basic Education, not captured in ARIS.
                            </p>
                        }
                    }

                    <!-- ===== ASSESSMENTS TAB ===== -->
                    @if (activeTab == "assessments")
                    {
                        @if (!string.IsNullOrEmpty(assessmentTypeError))
                        {
                            <div class="alert alert-danger">@assessmentTypeError</div>
                        }
                        @if (!string.IsNullOrEmpty(assessmentTypeSuccess))
                        {
                            <div class="alert alert-success">@assessmentTypeSuccess</div>
                        }
                        @if (!string.IsNullOrEmpty(assessmentError))
                        {
                            <div class="alert alert-danger">@assessmentError</div>
                        }
                        @if (!string.IsNullOrEmpty(assessmentSuccess))
                        {
                            <div class="alert alert-success">@assessmentSuccess</div>
                        }
                        @if (!string.IsNullOrEmpty(questionError))
                        {
                            <div class="alert alert-danger">@questionError</div>
                        }
                        @if (!string.IsNullOrEmpty(questionSuccess))
                        {
                            <div class="alert alert-success">@questionSuccess</div>
                        }

                        <!-- Add New Assessment Type -->
                        <div class="d-flex align-items-start gap-2 mb-4">
                            <div>
                                <input class="form-control @(newTypeNameInvalid ? "is-invalid" : "")"
                                       style="max-width:220px;"
                                       @bind="newTypeName" @oninput="@(() => newTypeNameInvalid = false)"
                                       maxlength="50" placeholder="New type name (e.g. SBA)" />
                                @if (newTypeNameInvalid)
                                {
                                    <div class="invalid-feedback d-block">Type name is required.</div>
                                }
                            </div>
                            <button class="btn btn-success" @onclick="CreateAssessmentType">+ Add Type</button>
                        </div>

                        @if (!assessmentTypes.Any(t => t.Term == manageTerm))
                        {
                            <p class="text-muted">No assessment types for Term @manageTerm. Add one above to get started.</p>
                        }

                        @foreach (var type in assessmentTypes.Where(t => t.Term == manageTerm).OrderBy(t => t.AssessmentTypeId))
                        {
                            var typeAssessments = assessments
                                .Where(a => a.AssessmentTypeId == type.AssessmentTypeId)
                                .OrderBy(a => a.Date)
                                .ToList();

                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center py-2">
                                    <strong>@type.Name</strong>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteAssessmentType(type)">
                                        Delete Type
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    @if (typeAssessments.Count > 0)
                                    {
                                        <table class="table table-sm mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">Title</th>
                                                    <th>Max Mark</th>
                                                    <th>Date</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var assessment in typeAssessments)
                                                {
                                                    var isExpanded = selectedAssessment?.AssessmentId == assessment.AssessmentId;
                                                    <tr>
                                                        <td class="ps-3">@assessment.Title</td>
                                                        <td>@assessment.MaxMark.ToString("0.##")</td>
                                                        <td>@assessment.Date.ToString("dd MMM yyyy")</td>
                                                        <td class="text-nowrap pe-3">
                                                            <button class="btn btn-sm @(isExpanded ? "btn-info" : "btn-outline-info") me-1"
                                                                    @onclick="() => ToggleAssessmentQuestions(assessment)">
                                                                @(isExpanded ? "Hide Questions" : "Questions")
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick="() => DeleteAssessment(assessment)">
                                                                Delete
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    @if (isExpanded)
                                                    {
                                                        <tr>
                                                            <td colspan="4" class="p-3 bg-light">
                                                                @if (assessmentQuestions.Count > 0)
                                                                {
                                                                    <table class="table table-sm mb-2">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Q#</th>
                                                                                <th>Topic</th>
                                                                                <th>Max</th>
                                                                                <th></th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var q in assessmentQuestions)
                                                                            {
                                                                                <tr>
                                                                                    <td>@q.QuestionNumber</td>
                                                                                    <td>@q.Topic</td>
                                                                                    <td>@q.MaxMark.ToString("0.##")</td>
                                                                                    <td>
                                                                                        <button class="btn btn-sm btn-outline-danger"
                                                                                                @onclick="() => DeleteQuestion(q)">×</button>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                    <p class="text-muted small mb-2">
                                                                        Total: <strong>@assessmentQuestions.Sum(q => q.MaxMark).ToString("0.##")</strong>
                                                                        / <strong>@assessment.MaxMark.ToString("0.##")</strong>
                                                                    </p>
                                                                }
                                                                else
                                                                {
                                                                    <p class="text-muted small mb-2">No questions yet.</p>
                                                                }

                                                                <div class="d-flex gap-2 align-items-start flex-wrap">
                                                                    <div>
                                                                        <input type="number" class="form-control form-control-sm"
                                                                               style="width:65px;" @bind="newQuestionNumber"
                                                                               min="1" placeholder="Q#" />
                                                                    </div>
                                                                    <div>
                                                                        <input class="form-control form-control-sm @(newTopicInvalid ? "is-invalid" : "")"
                                                                               style="width:200px;" @bind="newQuestionTopic"
                                                                               @oninput="@(() => newTopicInvalid = false)"
                                                                               maxlength="100" placeholder="Topic" />
                                                                        @if (newTopicInvalid)
                                                                        {
                                                                            <div class="invalid-feedback d-block" style="width:200px;">Topic is required.</div>
                                                                        }
                                                                    </div>
                                                                    <div>
                                                                        <input type="number" class="form-control form-control-sm @(newQMarkInvalid ? "is-invalid" : "")"
                                                                               style="width:85px;" @bind="newQuestionMaxMark"
                                                                               @oninput="@(() => newQMarkInvalid = false)"
                                                                               min="0.01" step="0.01" placeholder="Marks" />
                                                                        @if (newQMarkInvalid)
                                                                        {
                                                                            <div class="invalid-feedback d-block">Must be &gt; 0.</div>
                                                                        }
                                                                    </div>
                                                                    <button class="btn btn-sm btn-success" @onclick="CreateQuestion">+ Add</button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    }

                                    <!-- Add Assessment -->
                                    <div class="p-3 border-top">
                                        <div class="d-flex gap-2 align-items-start flex-wrap">
                                            <div>
                                                <input class="form-control form-control-sm @(newTitleInvalid ? "is-invalid" : "")"
                                                       style="width:180px;" @bind="newAssessmentTitle"
                                                       @oninput="@(() => newTitleInvalid = false)"
                                                       maxlength="100" placeholder="Title" />
                                                @if (newTitleInvalid)
                                                {
                                                    <div class="invalid-feedback d-block">Title is required.</div>
                                                }
                                            </div>
                                            <div>
                                                <input type="number" class="form-control form-control-sm @(newAMaxMarkInvalid ? "is-invalid" : "")"
                                                       style="width:80px;" @bind="newAssessmentMaxMark"
                                                       @oninput="@(() => newAMaxMarkInvalid = false)"
                                                       min="0.01" step="0.01" placeholder="Max" />
                                                @if (newAMaxMarkInvalid)
                                                {
                                                    <div class="invalid-feedback d-block">Must be &gt; 0.</div>
                                                }
                                            </div>
                                            <div>
                                                <input type="date" class="form-control form-control-sm @(newDateInvalid ? "is-invalid" : "")"
                                                       style="width:150px;" @bind="newAssessmentDate"
                                                       @oninput="@(() => newDateInvalid = false)" />
                                                @if (newDateInvalid)
                                                {
                                                    <div class="invalid-feedback d-block">Date is required.</div>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-success"
                                                    @onclick="() => CreateAssessment(type.AssessmentTypeId)">
                                                + Add Assessment
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- ===== WEIGHTINGS TAB ===== -->
                    @if (activeTab == "weights")
                    {
                        @if (!string.IsNullOrEmpty(weightError))
                        {
                            <div class="alert alert-danger">@weightError</div>
                        }
                        @if (!string.IsNullOrEmpty(weightSuccess))
                        {
                            <div class="alert alert-success">@weightSuccess</div>
                        }

                        @if (weightingStructure == null || !weightingStructure.RootNodes.Any())
                        {
                            <p class="text-muted">
                                No assessment types configured for Term @manageTerm.
                                Add types on the Assessments tab first.
                            </p>
                        }
                        else
                        {
                            <table class="table" style="max-width:380px;">
                                <thead>
                                    <tr>
                                        <th>Assessment Type</th>
                                        <th style="width:130px;">Weight %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var node in weightingStructure.RootNodes.OrderBy(n => n.DisplayOrder))
                                    {
                                        <tr>
                                            <td>@node.Name</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm"
                                                       value="@FormatWeight(node.Weighting)"
                                                       @onchange="@(e => OnWeightChanged(node, e.Value?.ToString()))"
                                                       min="0" max="100" step="any" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td>
                                            <span class="fw-bold @(Math.Abs(weightTotal - 100m) > 0.001m ? "text-danger" : "text-success")">
                                                @weightTotal.ToString("0.##")%
                                                @(Math.Abs(weightTotal - 100m) > 0.001m ? "⚠ Must be 100%" : "✓")
                                            </span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <button class="btn btn-success"
                                    @onclick="SaveWeightingStructure"
                                    disabled="@(Math.Abs(weightTotal - 100m) > 0.001m)">
                                Save Weights
                            </button>
                        }
                    }

                    <!-- ===== YEAR WEIGHTING TAB ===== -->
                    @if (activeTab == "year")
                    {
                        @if (!string.IsNullOrEmpty(yearWeightError))
                        {
                            <div class="alert alert-danger">@yearWeightError</div>
                        }
                        @if (!string.IsNullOrEmpty(yearWeightSuccess))
                        {
                            <div class="alert alert-success">@yearWeightSuccess</div>
                        }

                        <p class="text-muted small">
                            Build how this subject's Term marks and assessment types roll up into a Year
                            (promotion) mark. Each node is either a <strong>Group</strong> (a container for
                            child nodes), a reference to one <strong>Term</strong>'s weighted mark, or a
                            reference to one <strong>Assessment Type</strong>'s own percentage (e.g. a Final
                            Exam). Shapes are entirely up to you — e.g. an "SBA" group containing Term nodes,
                            with a sibling Assessment Type node for the final exam.
                        </p>

                        @if (yearStructure != null)
                        {
                            @if (yearStructure.RootNodes.Count == 0)
                            {
                                <p class="text-muted">No year weighting nodes yet. Add a root node below to get started.</p>
                            }
                            else
                            {
                                <table class="table" style="max-width:760px;">
                                    <thead>
                                        <tr>
                                            <th>Node</th>
                                            <th style="width:150px;">Type</th>
                                            <th style="width:230px;">References</th>
                                            <th style="width:110px;">Weight %</th>
                                            <th style="width:100px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var root in yearStructure.RootNodes.OrderBy(n => n.DisplayOrder))
                                        {
                                            <tr>
                                                <td><input class="form-control form-control-sm" @bind="root.Name" /></td>
                                                <td>
                                                    <select class="form-control form-control-sm" @bind="root.NodeType">
                                                        <option value="Custom">Group</option>
                                                        <option value="Term">Term</option>
                                                        <option value="AssessmentType">Assessment Type</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    @if (root.NodeType == "Term")
                                                    {
                                                        <select class="form-control form-control-sm" @bind="root.ReferencedTerm">
                                                            @foreach (var t in AvailableTerms)
                                                            {
                                                                <option value="@t">Term @t</option>
                                                            }
                                                        </select>
                                                    }
                                                    else if (root.NodeType == "AssessmentType")
                                                    {
                                                        <select class="form-control form-control-sm" @bind="root.AssessmentTypeId">
                                                            <option value="">-- Select --</option>
                                                            @foreach (var type in yearAssessmentTypes)
                                                            {
                                                                <option value="@type.AssessmentTypeId">@type.Name (Term @type.Term)</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">@root.ChildNodes.Count child node(s)</span>
                                                    }
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm"
                                                           value="@FormatWeight(root.Weighting)"
                                                           @onchange="@(e => OnYearWeightChanged(root, e.Value?.ToString()))"
                                                           min="0" max="100" step="any" />
                                                </td>
                                                <td class="text-nowrap">
                                                    @if (root.NodeType == "Custom")
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AddYearChildNode(root)">+ Child</button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveYearNode(root)">×</button>
                                                </td>
                                            </tr>

                                            @if (root.ChildNodes.Count > 0)
                                            {
                                                <tr>
                                                    <td colspan="5" class="p-0">
                                                        <table class="table table-sm mb-0 ms-4" style="max-width:700px;">
                                                            <tbody>
                                                                @foreach (var child in root.ChildNodes.OrderBy(c => c.DisplayOrder))
                                                                {
                                                                    <tr>
                                                                        <td style="width:190px;">
                                                                            <input class="form-control form-control-sm" @bind="child.Name" />
                                                                        </td>
                                                                        <td style="width:150px;">
                                                                            <select class="form-control form-control-sm" @bind="child.NodeType">
                                                                                <option value="Term">Term</option>
                                                                                <option value="AssessmentType">Assessment Type</option>
                                                                            </select>
                                                                        </td>
                                                                        <td style="width:230px;">
                                                                            @if (child.NodeType == "Term")
                                                                            {
                                                                                <select class="form-control form-control-sm" @bind="child.ReferencedTerm">
                                                                                    @foreach (var t in AvailableTerms)
                                                                                    {
                                                                                        <option value="@t">Term @t</option>
                                                                                    }
                                                                                </select>
                                                                            }
                                                                            else
                                                                            {
                                                                                <select class="form-control form-control-sm" @bind="child.AssessmentTypeId">
                                                                                    <option value="">-- Select --</option>
                                                                                    @foreach (var type in yearAssessmentTypes)
                                                                                    {
                                                                                        <option value="@type.AssessmentTypeId">@type.Name (Term @type.Term)</option>
                                                                                    }
                                                                                </select>
                                                                            }
                                                                        </td>
                                                                        <td style="width:110px;">
                                                                            <input type="number" class="form-control form-control-sm"
                                                                                   value="@FormatWeight(child.Weighting)"
                                                                                   @onchange="@(e => OnYearWeightChanged(child, e.Value?.ToString()))"
                                                                                   min="0" max="100" step="any" />
                                                                        </td>
                                                                        <td style="width:100px;">
                                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveYearNode(child)">×</button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                                <tr>
                                                                    <td colspan="5">
                                                                        <span class="small @(Math.Abs(root.ChildNodes.Sum(c => c.Weighting) - 100m) > 0.001m ? "text-danger" : "text-success")">
                                                                            Children total: @root.ChildNodes.Sum(c => c.Weighting).ToString("0.##")%
                                                                        </span>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3"><strong>Root Total</strong></td>
                                            <td colspan="2">
                                                <span class="fw-bold @(Math.Abs(yearWeightTotal - 100m) > 0.001m ? "text-danger" : "text-success")">
                                                    @yearWeightTotal.ToString("0.##")%
                                                    @(Math.Abs(yearWeightTotal - 100m) > 0.001m ? "⚠ Must be 100%" : "✓")
                                                </span>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }

                            <button class="btn btn-outline-primary me-2" @onclick="AddYearRootNode">+ Add Root Node</button>
                            <button class="btn btn-success" @onclick="SaveYearStructure">Save Year Weighting</button>
                        }
                    }

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseManageModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODALS -->
