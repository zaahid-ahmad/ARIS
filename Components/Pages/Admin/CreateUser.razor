@page "/admin/users/create"
@using ARIS1.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row">
    <div class="col-md-5">
        <div class="mb-3">
            <label class="form-label">Full Name <span class="text-danger">*</span></label>
            <input class="form-control @(fullNameError != null ? "is-invalid" : "")"
                   @bind="fullName" @oninput="@(() => fullNameError = null)"
                   maxlength="100" placeholder="e.g. Jane Doe" />
            @if (fullNameError != null)
            {
                <div class="invalid-feedback">@fullNameError</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <input class="form-control @(emailError != null ? "is-invalid" : "")"
                   type="email" @bind="email" @oninput="@(() => emailError = null)"
                   maxlength="256" placeholder="e.g. jane@school.com" />
            @if (emailError != null)
            {
                <div class="invalid-feedback">@emailError</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label">Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control @(passwordError != null ? "is-invalid" : "")"
                   @bind="password" @oninput="@(() => passwordError = null)"
                   autocomplete="new-password" />
            @if (passwordError != null)
            {
                <div class="invalid-feedback">@passwordError</div>
            }
            <small class="text-muted">Minimum 8 characters, must include at least one digit.</small>
        </div>
        <div class="mb-3">
            <label class="form-label">Role <span class="text-danger">*</span></label>
            <select class="form-control @(roleError != null ? "is-invalid" : "")"
                    @bind="role" @bind:after="@(() => roleError = null)">
                <option value="">-- Select Role --</option>
                <option value="Teacher">Teacher</option>
                <option value="Learner">Learner</option>
                <option value="Parent">Parent</option>
            </select>
            @if (roleError != null)
            {
                <div class="invalid-feedback">@roleError</div>
            }
        </div>

        @if (role == "Learner")
        {
            <div class="mb-3">
                <label class="form-label">Grade <span class="text-danger">*</span></label>
                <select class="form-control @(gradeError != null ? "is-invalid" : "")"
                        @bind="grade" @bind:after="OnGradeChanged">
                    <option value="10">Grade 10</option>
                    <option value="11">Grade 11</option>
                    <option value="12">Grade 12</option>
                </select>
                @if (gradeError != null)
                {
                    <div class="invalid-feedback">@gradeError</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Class <span class="text-danger">*</span></label>
                <select class="form-control @(classIdError != null ? "is-invalid" : "")"
                        @bind="selectedClassId" @bind:after="@(() => classIdError = null)">
                    <option value="0">-- Select Class --</option>
                    @foreach (var cls in gradeClasses)
                    {
                        <option value="@cls.ClassId">@cls.Name</option>
                    }
                </select>
                @if (classIdError != null)
                {
                    <div class="invalid-feedback">@classIdError</div>
                }
                @if (gradeClasses.Count == 0)
                {
                    <small class="text-muted">No classes exist for Grade @grade yet — create one under <a href="/admin/classes">Class Management</a> first.</small>
                }
            </div>
        }

        @if (role == "Parent")
        {
            <div class="mb-3">
                <label class="form-label">Link to Children <span class="text-danger">*</span></label>
                <input class="form-control mb-2" placeholder="Search learners by name..."
                       @bind="learnerSearchTerm" @bind:event="oninput" />
                <div class="border rounded p-2 @(childrenError != null ? "is-invalid" : "")" style="max-height: 220px; overflow-y: auto;">
                    @if (FilteredLearners.Count == 0)
                    {
                        <p class="text-muted mb-0">No matching learners found.</p>
                    }
                    else
                    {
                        @foreach (var learner in FilteredLearners)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       checked="@selectedLearnerIds.Contains(learner.LearnerId)"
                                       @onchange="@((e) => ToggleLearnerSelection(learner.LearnerId, (bool)e.Value!))" />
                                <label class="form-check-label">
                                    @learner.User?.Fullname (Grade @learner.Grade — @learner.Class?.Name)
                                </label>
                            </div>
                        }
                    }
                </div>
                @if (childrenError != null)
                {
                    <div class="invalid-feedback d-block">@childrenError</div>
                }
                @if (selectedLearnerIds.Count > 0)
                {
                    <small class="text-muted">@selectedLearnerIds.Count learner(s) selected.</small>
                }
            </div>
        }
        <button class="btn btn-primary" @onclick="CreateUserAsync">Create User</button>
        <button class="btn btn-secondary ms-2" @onclick='() => Navigation.NavigateTo("/admin/users")'>Cancel</button>
    </div>
</div>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string role = string.Empty;
    private string grade = "10";
    private int selectedClassId = 0;
    private List<SchoolClass> gradeClasses = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private string? fullNameError;
    private string? emailError;
    private string? passwordError;
    private string? roleError;
    private string? gradeError;
    private string? classIdError;
    private string? childrenError;

    private int? currentAdminSchoolId;
    private List<Learner> schoolLearners = new();
    private string learnerSearchTerm = string.Empty;
    private HashSet<int> selectedLearnerIds = new();

    private List<Learner> FilteredLearners => string.IsNullOrWhiteSpace(learnerSearchTerm)
        ? schoolLearners
        : schoolLearners
            .Where(l => l.User!.Fullname.Contains(learnerSearchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void ToggleLearnerSelection(int learnerId, bool isChecked)
    {
        if (isChecked) selectedLearnerIds.Add(learnerId);
        else selectedLearnerIds.Remove(learnerId);
        childrenError = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        if (string.IsNullOrEmpty(userName)) return;

        var currentAdmin = await UserManager.FindByNameAsync(userName);
        currentAdminSchoolId = currentAdmin?.SchoolId;

        if (currentAdminSchoolId != null)
        {
            schoolLearners = await DbContext.Learners
                .AsNoTracking()
                .Include(l => l.User)
                .Include(l => l.Class)
                .Where(l => l.User!.SchoolId == currentAdminSchoolId)
                .OrderBy(l => l.User!.Fullname)
                .ToListAsync();

            await LoadGradeClasses();
        }
    }

    private async Task OnGradeChanged()
    {
        gradeError = null;
        selectedClassId = 0;
        await LoadGradeClasses();
    }

    private async Task LoadGradeClasses()
    {
        if (currentAdminSchoolId == null || !int.TryParse(grade, out var gradeValue)) return;

        gradeClasses = await DbContext.SchoolClasses
            .AsNoTracking()
            .Where(c => c.SchoolId == currentAdminSchoolId && c.Grade == gradeValue)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private bool ValidateForm()
    {
        fullNameError = emailError = passwordError = roleError = gradeError = classIdError = childrenError = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(fullName))
        { fullNameError = "Full name is required."; valid = false; }
        else if (fullName.Trim().Length < 2)
        { fullNameError = "Full name must be at least 2 characters."; valid = false; }

        if (string.IsNullOrWhiteSpace(email))
        { emailError = "Email is required."; valid = false; }
        else if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email))
        { emailError = "Enter a valid email address."; valid = false; }

        if (string.IsNullOrWhiteSpace(password))
        { passwordError = "Password is required."; valid = false; }
        else if (password.Length < 8)
        { passwordError = "Password must be at least 8 characters."; valid = false; }
        else if (!password.Any(char.IsDigit))
        { passwordError = "Password must contain at least one digit."; valid = false; }

        if (string.IsNullOrWhiteSpace(role))
        { roleError = "Please select a role."; valid = false; }

        if (role == "Learner" && string.IsNullOrWhiteSpace(grade))
        { gradeError = "Please select a grade."; valid = false; }

        if (role == "Learner" && selectedClassId == 0)
        { classIdError = "Please select a class."; valid = false; }

        if (role == "Parent" && selectedLearnerIds.Count == 0)
        { childrenError = "Select at least one learner to link to this parent account."; valid = false; }

        return valid;
    }

    private async Task CreateUserAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (!ValidateForm()) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        if (string.IsNullOrEmpty(userName))
        { errorMessage = "You must be logged in."; return; }

        var currentAdmin = await UserManager.FindByNameAsync(userName);
        if (currentAdmin?.SchoolId == null)
        { errorMessage = "You are not assigned to a school."; return; }

        var existingUser = await UserManager.FindByEmailAsync(email);
        if (existingUser != null)
        { emailError = "This email is already in use."; return; }

        // Server-side re-validation: never trust the client-side selection alone — the
        // selected class must actually belong to this admin's own school and grade.
        if (role == "Learner")
        {
            var gradeValue = int.Parse(grade);
            var classValid = await DbContext.SchoolClasses
                .AnyAsync(c => c.ClassId == selectedClassId && c.SchoolId == currentAdmin.SchoolId && c.Grade == gradeValue);

            if (!classValid)
            {
                classIdError = "That class is no longer valid. Please refresh and try again.";
                return;
            }
        }

        // Server-side re-validation: never trust the client-side selection alone — every
        // selected learner must actually belong to this admin's own school.
        var validatedLearnerIds = new List<int>();
        if (role == "Parent")
        {
            validatedLearnerIds = await DbContext.Learners
                .Where(l => selectedLearnerIds.Contains(l.LearnerId) && l.User.SchoolId == currentAdmin.SchoolId)
                .Select(l => l.LearnerId)
                .ToListAsync();

            if (validatedLearnerIds.Count != selectedLearnerIds.Count)
            {
                errorMessage = "One or more selected learners are no longer valid. Please refresh and try again.";
                return;
            }
        }

        var user = new User
        {
            UserName = email,
            Email = email,
            Fullname = fullName,
            IsActive = true,
            EmailConfirmed = true,
            SchoolId = currentAdmin.SchoolId
        };

        var result = await UserManager.CreateAsync(user, password);

        if (result.Succeeded)
        {
            try
            {
                await UserManager.AddToRoleAsync(user, role);

                if (role == "Teacher")
                {
                    var teacher = new Teacher { UserId = user.Id };
                    DbContext.Teachers.Add(teacher);
                    await DbContext.SaveChangesAsync();
                }
                else if (role == "Learner")
                {
                    var learner = new Learner
                    {
                        UserId = user.Id,
                        Grade = int.Parse(grade),
                        ClassId = selectedClassId,
                        EnrollmentYear = DateTime.Now.Year
                    };
                    DbContext.Learners.Add(learner);
                    await DbContext.SaveChangesAsync();
                }
                else if (role == "Parent")
                {
                    var parent = new Parent { UserId = user.Id };
                    DbContext.Parents.Add(parent);
                    await DbContext.SaveChangesAsync();

                    foreach (var learnerId in validatedLearnerIds)
                    {
                        DbContext.ParentLearners.Add(new ParentLearner { ParentId = parent.ParentId, LearnerId = learnerId });
                    }
                    await DbContext.SaveChangesAsync();
                }

                successMessage = $"{role} account created successfully!";
                fullName = string.Empty;
                email = string.Empty;
                password = string.Empty;
                role = string.Empty;
                grade = "10";
                selectedClassId = 0;
                selectedLearnerIds.Clear();
                learnerSearchTerm = string.Empty;

                await Task.Delay(1500);
                Navigation.NavigateTo("/admin/users");
            }
            catch (Exception ex)
            {
                if (role == "Parent")
                {
                    // Never leave a User row behind with no matching Parent/ParentLearner rows.
                    await UserManager.DeleteAsync(user);
                }
                errorMessage = $"Error creating {role} record: {ex.Message}";
            }
        }
        else
        {
            errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }
}
