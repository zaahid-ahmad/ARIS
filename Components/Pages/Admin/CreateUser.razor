@page "/admin/users/create"
@using ARIS1.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ARIS1.Models
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<h2>Create New User</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row">
    <div class="col-md-5">
        <div class="mb-3">
            <label>Full Name</label>
            <input class="form-control" @bind="fullName" />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <input class="form-control" @bind="email" />
        </div>
        <div class="mb-3">
            <label>Password</label>
            <input type="password" class="form-control" @bind="password" />
        </div>
        <div class="mb-3">
            <label>Role</label>
            <select class="form-control" @bind="role">
                <option value="">-- Select Role --</option>
                <option value="Teacher">Teacher</option>
                <option value="Learner">Learner</option>
            </select>
        </div>

        @if (role == "Learner")
        {
            <div class="mb-3">
                <label>Grade</label>
                <select class="form-control" @bind="grade">
                    <option value="10">Grade 10</option>
                    <option value="11">Grade 11</option>
                    <option value="12">Grade 12</option>
                </select>
            </div>
        }
        <button class="btn btn-primary" @onclick="CreateUserAsync">Create User</button>
        <button class="btn btn-secondary ms-2" @onclick='() => Navigation.NavigateTo("/admin/users")'>Cancel</button>
    </div>
</div>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string role = string.Empty;
    private string grade = "10";  // ← Add this
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private async Task CreateUserAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Validate all fields
        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(role))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        // Validate grade for learners
        if (role == "Learner" && string.IsNullOrWhiteSpace(grade))
        {
            errorMessage = "Please select a grade for learners.";
            return;
        }

        // Email validation
        var emailValid = new System.ComponentModel.DataAnnotations.EmailAddressAttribute();
        if (!emailValid.IsValid(email))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        // Get current admin's school
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        
        if (string.IsNullOrEmpty(userName))
        {
            errorMessage = "You must be logged in.";
            return;
        }

        var currentAdmin = await UserManager.FindByNameAsync(userName);
        if (currentAdmin?.SchoolId == null)
        {
            errorMessage = "You are not assigned to a school.";
            return;
        }

        // Check if email already exists
        var existingUser = await UserManager.FindByEmailAsync(email);
        if (existingUser != null)
        {
            errorMessage = "This email is already in use.";
            return;
        }

        // Create new user
        var user = new User
        {
            UserName = email,
            Email = email,
            Fullname = fullName,
            Role = role,
            IsActive = true,
            EmailConfirmed = true,
            SchoolId = currentAdmin.SchoolId  // Assign to admin's school
        };

        var result = await UserManager.CreateAsync(user, password);

        if (result.Succeeded)
        {
            try
            {
                // Add user to role
                await UserManager.AddToRoleAsync(user, role);

                // Create Teacher or Learner record
                if (role == "Teacher")
                {
                    var teacher = new Teacher { UserId = user.Id };
                    DbContext.Teachers.Add(teacher);
                    await DbContext.SaveChangesAsync();
                }
                else if (role == "Learner")
                {
                    var learner = new Learner
                    {
                        UserId = user.Id,
                        Grade = int.Parse(grade),  // ← Use selected grade
                        ClassName = "Unassigned",
                        EnrollmentYear = DateTime.Now.Year
                    };
                    DbContext.Learners.Add(learner);
                    await DbContext.SaveChangesAsync();
                }

                successMessage = $"{role} account created successfully!";
                fullName = string.Empty;
                email = string.Empty;
                password = string.Empty;
                role = string.Empty;
                grade = "10";  // Reset grade

                // Redirect back to users list after a short delay
                await Task.Delay(1500);
                Navigation.NavigateTo("/admin/users");
            }
            catch (Exception ex)
            {
                errorMessage = $"Error creating {role} record: {ex.Message}";
            }
        }
        else
        {
            errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }
}