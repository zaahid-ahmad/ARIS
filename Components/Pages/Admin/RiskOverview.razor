@page "/admin/risk-overview"
@using Microsoft.AspNetCore.Authorization
@using ARIS1.Models
@using ARIS1.Services
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject RiskOverviewService RiskOverviewSvc

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@errorMessage</span>
        @* A failed load can always be retried; "not assigned to a school" has no schoolId, so it gets no button. *@
        @if (schoolId != null && !isLoading)
        {
            <button class="btn btn-sm btn-light" @onclick="Retry">Retry</button>
        }
    </div>
}

@if (isLoading)
{
    <ProgressPanel Message="Calculating risk across the school..." Done="progressDone" Total="progressTotal" Detail="@progressCurrent"
                   SlowHint="Still working. Large schools can take a while." />
}
else if (overview != null)
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h5 class="mb-0">@overview.SchoolName</h5>
            <small class="text-muted d-block">Academic year @overview.AcademicYear. Learners are counted once, by their highest-risk subject.</small>
            <small class="text-muted">Data as of @overview.AsOfUtc.ToLocalTime().ToString("HH:mm")@(overview.SubjectsFromCache > 0 && overview.SubjectsComputed == 0 ? " (saved from earlier)" : "") -
                <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="Refresh">Refresh</button></small>
        </div>
        <button class="btn btn-primary" @onclick="CreateReport">
            <i class="fas fa-file-pdf"></i> Create report (PDF)
        </button>
    </div>

    <div class="tab-row">
        <button class="tab-btn @(selectedGrade == null ? "active" : "")" @onclick="() => SelectGrade(null)">All grades</button>
        @foreach (var grade in overview.Grades)
        {
            var g = grade;
            <button class="tab-btn @(selectedGrade == g ? "active" : "")" @onclick="() => SelectGrade(g)">Grade @g</button>
        }
    </div>

    @if (visibleSubjects.Count == 0)
    {
        <div class="alert alert-info">No subjects for the current academic year yet.</div>
    }
    else
    {
        var agg = RiskOverviewService.Aggregate(visibleSubjects);

        <div class="stats-row">
            <div class="stat-tile">
                <div class="stat-tile-val">@agg.Total</div>
                <div class="stat-tile-label">Learners enrolled</div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-val" style="color:@RiskPalette.Color("High")">@agg.AtRisk <small class="text-muted">(@agg.AtRiskPercent.ToString("0.#")%)</small></div>
                <div class="stat-tile-label">At risk (High or Critical)</div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-val" style="color:@RiskPalette.Color("Critical")">@agg.Count("Critical")</div>
                <div class="stat-tile-label">Critical</div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-val">@visibleSubjects.Count</div>
                <div class="stat-tile-label">Subjects</div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><span class="card-title">@(selectedGrade == null ? "Whole school" : $"Grade {selectedGrade}") risk distribution</span></div>
            <div class="card-body d-flex align-items-center gap-4 flex-wrap">
                @((MarkupString)RiskChartSvg.Donut(agg.Bands, agg.Total, 150, $"{(selectedGrade == null ? "Whole school" : $"Grade {selectedGrade}")} risk distribution"))
                <div class="legend">
                    @foreach (var band in agg.Bands)
                    {
                        <div class="legend-item">
                            <span class="legend-icon" style="background:@band.Color;border-radius:50%;"></span>
                            <small class="text-muted">@band.Level: @band.Count</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <h6 class="mb-2">Subjects <small class="text-muted">- select one to see its learners</small></h6>
        <div class="row">
            @foreach (var card in visibleSubjects)
            {
                var subjectId = card.SubjectId;
                <div class="col-md-4">
                    <div class="card mb-3" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/teacher/atrisk?subject={subjectId}")'>
                        <div class="card-header">
                            <span class="card-title">@card.SubjectName (Grade @card.Grade)</span>
                            <div><small class="text-muted">@card.TeacherName</small></div>
                        </div>
                        <div class="card-body text-center">
                            @if (card.TotalLearners == 0)
                            {
                                @((MarkupString)RiskChartSvg.Donut(card.Bands, 0, 96, $"{card.SubjectName} (Grade {card.Grade}) has no learners enrolled"))
                                <p class="text-muted mt-2 mb-0">No learners enrolled</p>
                            }
                            else
                            {
                                @((MarkupString)RiskChartSvg.Donut(card.Bands, card.TotalLearners, 96, $"{card.SubjectName} (Grade {card.Grade}) risk distribution"))
                                <div class="legend justify-content-center mt-2">
                                    @foreach (var band in card.Bands.Where(b => b.Count > 0))
                                    {
                                        <div class="legend-item">
                                            <span class="legend-icon" style="background:@band.Color;border-radius:50%;"></span>
                                            <small class="text-muted">@band.Level: @band.Count</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private SchoolRiskOverview? overview;
    private int? selectedGrade;
    private bool isLoading = true;
    private bool started;
    private bool ready;     // set once OnInitializedAsync has identified the admin's school
    private int? schoolId;
    private string errorMessage = string.Empty;
    private readonly CancellationTokenSource cts = new();

    // Live progress of the calculation (fed by RiskOverviewService, re-rendered at most ~7x/second).
    private int progressDone;
    private int progressTotal;
    private string? progressCurrent;

    private List<SubjectRiskSummary> visibleSubjects =>
        overview == null ? new() : overview.Subjects.Where(s => selectedGrade == null || s.Grade == selectedGrade).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var admin = await UserManager.FindByNameAsync(authState.User.Identity!.Name!);
            if (admin?.SchoolId == null)
            {
                errorMessage = "You are not assigned to a school.";
                isLoading = false;
                return;
            }
            schoolId = admin.SchoolId;
            ready = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            isLoading = false;
        }
    }

    // The page shell paints first; the (cached, parallel) calculation runs on the live circuit only, once.
    // Do NOT gate this on `firstRender`: Blazor renders at OnInitializedAsync's first incomplete await, so the one render
    // with firstRender == true can happen BEFORE the school is known, and the load would then never start.
    // Readiness is what matters; Blazor always re-renders when OnInitializedAsync completes, which re-enters here.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (started || !ready) return;
        started = true;
        await LoadAsync(refresh: false);
    }

    private async Task Refresh()
    {
        if (isLoading || schoolId == null) return;
        await LoadAsync(refresh: true);
    }

    private async Task Retry()
    {
        if (isLoading || schoolId == null) return;
        await LoadAsync(refresh: false);
    }

    private async Task LoadAsync(bool refresh)
    {
        isLoading = true;
        progressDone = 0;
        progressTotal = 0;
        progressCurrent = null;
        errorMessage = string.Empty;
        StateHasChanged();

        // An endless spinner is never acceptable: past the time limit the page says so and offers Retry. Page-left
        // cancellation (cts) and the time limit are told apart below.
        using var limit = CancellationTokenSource.CreateLinkedTokenSource(cts.Token);
        limit.CancelAfter(RiskOverviewSvc.LoadTimeLimit);

        try
        {
            if (refresh) RiskOverviewSvc.InvalidateSchool(schoolId!.Value);

            var progress = new ThrottledProgress<RiskBuildProgress>(
                p => { progressDone = p.Done; progressTotal = p.Total; progressCurrent = p.Current; },
                () => _ = InvokeAsync(StateHasChanged));

            overview = await RiskOverviewSvc.BuildAsync(schoolId!.Value, progress: progress, ct: limit.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return; // left the page
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Calculating risk is taking longer than expected. It is still running in the background; Retry to wait for it.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }

        isLoading = false;
        StateHasChanged();
    }

    private void SelectGrade(int? grade)
    {
        // Only grades that actually have subjects are offered, but never trust the bound value.
        selectedGrade = grade != null && overview != null && overview.Grades.Contains(grade.Value) ? grade : null;
    }

    private void CreateReport()
    {
        Navigation.NavigateTo(selectedGrade == null ? "/admin/risk-report" : $"/admin/risk-report?grade={selectedGrade}");
    }

    public void Dispose() => cts.Cancel();
}
